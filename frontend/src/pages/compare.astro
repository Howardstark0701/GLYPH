---
// GLYPH OS — Multi-Repository Comparison
// src/pages/compare.astro
//
// Diff two repositories' decision histories. Paste two GitHub URLs; if
// either repo hasn't been analyzed yet, the page runs the analysis
// (BYOK keys from sessionStorage) and shows honest progress before
// rendering the side-by-side comparison.
export const prerender = true;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GLYPH — REPO COMPARISON</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html, body {
      margin: 0; padding: 0;
      background: #131313;
      color: #e5e2e1;
      font-family: 'Karla', sans-serif;
      min-height: 100vh;
    }
    ::selection { background: #ffb4a8; color: #131313; }
    :focus-visible { outline: 1px solid #ffb4a8; outline-offset: 2px; }
    a, button, input { transition: border-color 120ms cubic-bezier(0.2,0.6,0.2,1), color 120ms cubic-bezier(0.2,0.6,0.2,1), background-color 120ms cubic-bezier(0.2,0.6,0.2,1); }

    .mono { font-family: 'JetBrains Mono', monospace; }
    .label-caps { font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; line-height: 1rem; }

    /* ── Navbar ─────────────────────────────────────────── */
    #navbar {
      display: flex; align-items: center; justify-content: space-between;
      height: 48px; padding: 0 16px;
      border-bottom: 1px solid #262626;
    }
    #nav-brand a {
      font-family: 'Space Grotesk', sans-serif; font-weight: 700;
      font-size: 1.25rem; color: #ffb4a8; text-decoration: none; letter-spacing: -0.01em;
    }
    #nav-links { display: flex; align-items: center; gap: 20px; }
    #nav-links a {
      font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem;
      letter-spacing: 0.1em; text-transform: uppercase; color: #a1a1a1;
      text-decoration: none; padding: 4px 0; border-bottom: 1px solid transparent;
    }
    #nav-links a:hover { color: #ffb4a8; }
    #nav-links a.active { color: #cc0000; border-bottom-color: #cc0000; }

    /* ── Hero + inputs ─────────────────────────────────── */
    #compare-hero { padding: 56px 24px 32px; text-align: center; }
    #compare-hero h1 {
      font-family: 'Space Grotesk', sans-serif; font-weight: 700;
      font-size: 2rem; margin: 0 0 8px; color: #ffb4a8; letter-spacing: -0.02em;
    }
    #compare-hero p { margin: 0; color: #5e3f3a; font-size: 0.75rem; }

    #input-grid {
      display: grid; grid-template-columns: 1fr auto 1fr; gap: 12px;
      max-width: 980px; margin: 28px auto 0; padding: 0 24px; align-items: center;
    }
    .repo-field { text-align: left; }
    .repo-field .field-label {
      font-family: 'JetBrains Mono', monospace; font-size: 0.625rem;
      letter-spacing: 0.12em; text-transform: uppercase; color: #a1a1a1;
      display: block; margin-bottom: 6px;
    }
    .repo-field input {
      width: 100%; height: 40px; padding: 0 12px;
      background: #131313; border: 1px solid #262626;
      color: #e5e2e1; font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;
    }
    .repo-field input:focus { border-color: #ffb4a8; outline: none; }
    .repo-field input::placeholder { color: #3a3a3a; }
    .vs-badge {
      font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 0.75rem;
      color: #cc0000; border: 1px solid #cc0000; padding: 8px 10px;
    }

    #compare-actions { margin-top: 20px; text-align: center; }
    #compare-btn {
      font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem;
      letter-spacing: 0.12em; text-transform: uppercase; color: #ffffff;
      background: #cc0000; border: none; padding: 10px 28px; cursor: pointer;
    }
    #compare-btn:hover { background: #ff0000; }
    #compare-btn:disabled { background: #2a2a2a; color: #5e3f3a; cursor: not-allowed; }

    #key-notice {
      max-width: 640px; margin: 18px auto 0; padding: 12px 16px;
      border: 1px dashed #5e3f3a; font-family: 'JetBrains Mono', monospace;
      font-size: 0.6875rem; color: #5e3f3a; line-height: 1.6;
    }
    #key-notice a { color: #cc0000; }

    /* ── Status feed ───────────────────────────────────── */
    #feed-wrap {
      max-width: 980px; margin: 32px auto 0; padding: 0 24px; display: none;
    }
    #feed {
      border: 1px solid #262626; background: #0e0e0e;
      height: 180px; overflow-y: auto; padding: 10px 14px;
      font-family: 'JetBrains Mono', monospace; font-size: 0.625rem;
      color: #ae8882; line-height: 1.7; white-space: pre-wrap;
    }

    /* ── Results ───────────────────────────────────────── */
    #results { max-width: 1100px; margin: 40px auto 60px; padding: 0 24px; display: none; }

    .result-head {
      display: flex; align-items: center; justify-content: space-between;
      gap: 16px; border: 1px solid #262626; padding: 14px 18px; margin-bottom: 20px;
    }
    .result-head .repo-label {
      font-family: 'JetBrains Mono', monospace; font-size: 0.875rem; font-weight: 700; color: #ffb4a8;
    }
    .result-head .repo-sub { font-family: 'JetBrains Mono', monospace; font-size: 0.625rem; color: #5e3f3a; }
    .result-head .vs { color: #cc0000; font-family: 'JetBrains Mono', monospace; font-weight: 700; }

    .compare-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .panel { border: 1px solid #262626; background: #131313; padding: 16px 18px; }
    .panel-title {
      font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem;
      letter-spacing: 0.12em; text-transform: uppercase; color: #a1a1a1;
      border-bottom: 1px solid #262626; padding-bottom: 8px; margin-bottom: 14px;
    }
    .metric-row {
      display: flex; justify-content: space-between; align-items: baseline;
      font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;
      padding: 4px 0; color: #a1a1a1;
    }
    .metric-row .val { color: #e5e2e1; font-weight: 600; }
    .type-bar-row { margin: 8px 0; }
    .type-bar-top { display: flex; justify-content: space-between; font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem; color: #a1a1a1; }
    .type-bar-track { height: 6px; background: #1e1e1e; margin-top: 4px; }
    .type-bar-fill { height: 100%; }

    .section-title {
      font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;
      letter-spacing: 0.12em; text-transform: uppercase; color: #cc0000;
      margin: 28px 0 12px;
    }
    #notes-list { border: 1px solid #262626; padding: 14px 18px; margin-bottom: 20px; }
    #notes-list li {
      font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem;
      color: #ae8882; line-height: 1.7; margin: 6px 0;
    }
    #overlap-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .tag-wrap { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
    .tag {
      font-family: 'JetBrains Mono', monospace; font-size: 0.625rem;
      border: 1px solid #2a2a2a; color: #a1a1a1; padding: 2px 8px;
    }
    .tag.shared { border-color: #22d3ee; color: #22d3ee; }
    .tag.a-only { border-color: #ffb4a8; color: #ffb4a8; }
    .tag.b-only { border-color: #a1a1a1; color: #a1a1a1; }
    .empty-note { font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem; color: #5e3f3a; margin-top: 8px; }

    @media (max-width: 760px) {
      #input-grid, .compare-grid, #overlap-grid { grid-template-columns: 1fr; }
      .vs-badge { display: inline-block; }
    }
  </style>
</head>
<body>

  <nav id="navbar" aria-label="Navigation">
    <div id="nav-brand"><a href="/" aria-label="Return to GLYPH home">GLYPH</a></div>
    <div id="nav-links" aria-label="Pages">
      <a href="/compare" class="active" aria-current="page">COMPARE</a>
    </div>
  </nav>

  <section id="compare-hero" aria-label="Repository comparison">
    <h1>REPO COMPARISON</h1>
    <p>DIFF_TWO_DECISION_HISTORIES // REPOSITORIES_MUST_BE_ANALYZED_OR_GET_ANALYZED_HERE</p>
  </section>

  <form id="input-grid" onsubmit="event.preventDefault(); return false;">
    <div class="repo-field">
      <label class="field-label" for="repo-a-input">REPOSITORY_A</label>
      <input id="repo-a-input" type="url" placeholder="https://github.com/owner/repo" autocomplete="off" spellcheck="false" />
    </div>
    <span class="vs-badge" aria-hidden="true">VS</span>
    <div class="repo-field">
      <label class="field-label" for="repo-b-input">REPOSITORY_B</label>
      <input id="repo-b-input" type="url" placeholder="https://github.com/owner/repo" autocomplete="off" spellcheck="false" />
    </div>
  </form>

  <div id="compare-actions">
    <button id="compare-btn" type="button">COMPARE_REPOSITORIES</button>
  </div>

  <div id="key-notice" style="display:none;">
    KEYS_NOT_SET — <a href="/">configure your GitHub PAT and NIM key on the terminal page</a>. Keys stay in browser
    session memory; they are never stored on the GLYPH server.
  </div>

  <div id="feed-wrap">
    <div id="feed" role="log" aria-label="Analysis progress"></div>
  </div>

  <section id="results" aria-label="Comparison results">
    <div class="result-head">
      <span>
        <span class="repo-label" id="rh-a">REPO_A</span>
        <span class="repo-sub" id="rh-a-sub"></span>
      </span>
      <span class="vs">VS</span>
      <span>
        <span class="repo-label" id="rh-b">REPO_B</span>
        <span class="repo-sub" id="rh-b-sub"></span>
      </span>
    </div>

    <div class="section-title">FINDINGS</div>
    <ul id="notes-list" aria-label="Comparison findings"></ul>

    <div class="compare-grid" aria-label="Repository A metrics">
      <div class="panel">
        <div class="panel-title" id="panel-a-title">REPOSITORY_A</div>
        <div id="metrics-a"></div>
      </div>
      <div class="panel">
        <div class="panel-title" id="panel-b-title">REPOSITORY_B</div>
        <div id="metrics-b"></div>
      </div>
    </div>

    <div class="section-title">CONTRIBUTOR_OVERLAP</div>
    <div id="overlap-grid">
      <div class="panel">
        <div class="panel-title">SHARED — BOTH_REPOSITORIES</div>
        <div class="tag-wrap" id="shared-tags"></div>
      </div>
      <div class="panel">
        <div class="panel-title">DIVERGENT — A_ONLY // B_ONLY</div>
        <div class="tag-wrap" id="divergent-tags"></div>
      </div>
    </div>
  </section>

  <script>
    // ── API base ────────────────────────────────────────
    const API_BASE =
      (import.meta as any).env?.PUBLIC_API_BASE_URL ??
      (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1'
        ? 'http://localhost:8000'
        : 'https://glyph-api-qh9i.onrender.com');

    // ── Session key store (memory only) ─────────────────
    const keys = {
      github: sessionStorage.getItem('glyph_gh_token') ?? '',
      nim:    sessionStorage.getItem('glyph_nim_key')  ?? '',
    };

    const inputA    = document.getElementById('repo-a-input') as HTMLInputElement;
    const inputB    = document.getElementById('repo-b-input') as HTMLInputElement;
    const btn       = document.getElementById('compare-btn')  as HTMLButtonElement;
    const feed      = document.getElementById('feed');
    const feedWrap  = document.getElementById('feed-wrap');
    const results   = document.getElementById('results');
    const keyNotice = document.getElementById('key-notice');

    const nowTs = () => {
      const d = new Date();
      const p = (n: number) => String(n).padStart(2, '0');
      return `[${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}]`;
    };

    const STAGE_LABEL: Record<string, string> = {
      queued: 'QUEUED',
      ingesting_commits: 'INGESTING_COMMITS',
      ingesting_pull_requests: 'INGESTING_PULL_REQUESTS',
      ingesting_issues: 'INGESTING_ISSUES',
      ingesting_review_threads: 'INGESTING_REVIEW_THREADS',
      extracting_intent: 'EXTRACTING_INTENT',
      idle: 'ANALYSIS_IDLE',
    };
    const stageLabel = (s: string | null) =>
      s ? (STAGE_LABEL[s] ?? s.toUpperCase().replace(/_/g, ' ')) : 'PENDING';

    function appendFeed(text: string, color = '#ae8882') {
      feedWrap.style.display = 'block';
      const line = document.createElement('div');
      line.style.color = color;
      line.textContent = `${nowTs()} ${text}`;
      feed.appendChild(line);
      feed.scrollTop = feed.scrollHeight;
    }

    async function postCompare(urlA: string, urlB: string): Promise<any> {
      const resp = await fetch(`${API_BASE}/api/compare`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ repo_a_url: urlA, repo_b_url: urlB }),
      });
      if (!resp.ok) {
        const err = await resp.json().catch(() => ({}));
        throw new Error(err.error ?? `HTTP ${resp.status}`);
      }
      return resp.json();
    }

    function analyzeHeaders() {
      return {
        'Content-Type': 'application/json',
        'X-Github-Token': keys.github,
        'X-Nim-Api-Key':  keys.nim,
      };
    }

    /** Start an analysis and poll its real status until terminal. */
    async function analyzeAndWait(url: string, label: string): Promise<void> {
      appendFeed(`UPLINKING ${label}...`, '#ffb4a8');
      const resp = await fetch(`${API_BASE}/api/analyze`, {
        method: 'POST',
        headers: analyzeHeaders(),
        body: JSON.stringify({ repo_url: url }),
      });
      if (!resp.ok) {
        const err = await resp.json().catch(() => ({}));
        throw new Error(err.error ?? `HTTP ${resp.status}`);
      }
      const data = await resp.json();
      const jobId = data.job_id as string;
      appendFeed(`${label} job started — ${jobId.slice(0, 8)}`);

      await new Promise<void>((resolve, reject) => {
        const poll = async () => {
          try {
            const r = await fetch(`${API_BASE}/api/repo/${jobId}/status`);
            if (!r.ok) { reject(new Error(`status endpoint ${r.status}`)); return; }
            const s = await r.json();
            if (s.status === 'failed' || s.status === 'terminated') {
              reject(new Error(s.error_message ?? s.status));
              return;
            }
            if (s.status === 'idle' || s.status === 'complete') {
              appendFeed(`${label} analysis complete`, '#22d3ee');
              resolve();
              return;
            }
            appendFeed(`${label} — ${stageLabel(s.stage)}`);
            setTimeout(poll, 3000);
          } catch (e: any) {
            reject(e);
          }
        };
        poll();
      });
    }

    function renderResults(data: any) {
      const c = data.comparison;
      const a = data.a;
      const b = data.b;

      document.getElementById('rh-a').textContent = `${a.owner}/${a.name}`.toUpperCase();
      document.getElementById('rh-b').textContent = `${b.owner}/${b.name}`.toUpperCase();
      document.getElementById('rh-a-sub').textContent =
        a.analyzed_at ? `ANALYZED ${new Date(a.analyzed_at).toUTCString()}` : '';
      document.getElementById('rh-b-sub').textContent =
        b.analyzed_at ? `ANALYZED ${new Date(b.analyzed_at).toUTCString()}` : '';
      document.getElementById('panel-a-title').textContent = `REPOSITORY_A — ${a.owner}/${a.name}`.toUpperCase();
      document.getElementById('panel-b-title').textContent = `REPOSITORY_B — ${b.owner}/${b.name}`.toUpperCase();

      // notes
      const notes = document.getElementById('notes-list');
      notes.innerHTML = '';
      (c.notes as string[]).forEach((n) => {
        const li = document.createElement('li');
        li.textContent = `» ${n}`;
        notes.appendChild(li);
      });

      // per-repo metrics + type bars
      renderMetrics('metrics-a', c.a);
      renderMetrics('metrics-b', c.b);

      // overlap
      const sharedTags = document.getElementById('shared-tags');
      const divTags    = document.getElementById('divergent-tags');
      sharedTags.innerHTML = '';
      divTags.innerHTML    = '';
      const shared = c.overlap.shared as string[];
      const aOnly  = c.overlap.a_only as string[];
      const bOnly  = c.overlap.b_only as string[];
      if (shared.length === 0) {
        const e = document.createElement('div');
        e.className = 'empty-note';
        e.textContent = 'NO_SHARED_CONTRIBUTORS';
        sharedTags.appendChild(e);
      } else {
        shared.forEach((h) => { const t = document.createElement('span'); t.className = 'tag shared'; t.textContent = h; sharedTags.appendChild(t); });
      }
      aOnly.forEach((h) => { const t = document.createElement('span'); t.className = 'tag a-only'; t.textContent = `A:${h}`; divTags.appendChild(t); });
      bOnly.forEach((h) => { const t = document.createElement('span'); t.className = 'tag b-only'; t.textContent = `B:${h}`; divTags.appendChild(t); });
      if (aOnly.length === 0 && bOnly.length === 0) {
        const e = document.createElement('div');
        e.className = 'empty-note';
        e.textContent = 'IDENTICAL_CONTRIBUTOR_SETS';
        divTags.appendChild(e);
      }

      results.style.display = 'block';
      results.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    const TYPE_COLORS: Record<string, string> = {
      decision: '#22d3ee',
      debate: '#ffb4a8',
      rejection: '#ef4444',
      architectural: '#a1a1a1',
    };

    function renderMetrics(containerId: string, prof: any) {
      const el = document.getElementById(containerId)!;
      el.innerHTML = '';

      const counts = prof.counts;
      const addRow = (label: string, val: string | number, color = '#e5e2e1') => {
        const row = document.createElement('div');
        row.className = 'metric-row';
        row.innerHTML =
          `<span>${label}</span><span class="val" style="color:${color};">${val}</span>`;
        el.appendChild(row);
      };

      addRow('INTENT_NODES', prof.total_nodes);
      addRow('COMMITS', counts.commits);
      addRow('PULL_REQUESTS', counts.pull_requests);
      addRow('ISSUES', counts.issues);
      addRow('MEAN_CONFIDENCE', `${prof.avg_confidence}%`);

      const dist = prof.type_distribution as Record<string, number>;
      const distEl = document.createElement('div');
      distEl.style.marginTop = '12px';
      Object.entries(dist).sort((x, y) => y[1] - x[1]).forEach(([type, count]) => {
        const color = TYPE_COLORS[type] ?? '#e5e2e1';
        const row = document.createElement('div');
        row.className = 'type-bar-row';
        row.innerHTML =
          `<div class="type-bar-top"><span style="text-transform:uppercase;color:${color};">${type}</span><span>${count}</span></div>` +
          `<div class="type-bar-track"><div class="type-bar-fill" style="width:${(count / Math.max(1, prof.total_nodes)) * 100}%;background:${color};"></div></div>`;
        distEl.appendChild(row);
      });
      el.appendChild(distEl);
    }

    async function run() {
      const urlA = inputA.value.trim();
      const urlB = inputB.value.trim();
      if (!urlA || !urlB) return;

      if (!keysSet()) {
        keyNotice.style.display = 'block';
        return;
      }
      keyNotice.style.display = 'none';
      results.style.display = 'none';
      feed.innerHTML = '';
      feedWrap.style.display = 'none';

      btn.disabled = true;
      btn.textContent = 'RUNNING...';
      try {
        const first = await postCompare(urlA, urlB);
        if (first.comparison.ready) {
          renderResults(first);
          return;
        }

        const label = (r: any) => `${r.owner}/${r.name}`.toUpperCase();
        const jobs: Promise<void>[] = [];
        if (first.a.status !== 'complete') {
          appendFeed(`${label(first.a)} not analyzed — starting analysis`, '#ffb4a8');
          jobs.push(analyzeAndWait(urlA, label(first.a)));
        }
        if (first.b.status !== 'complete') {
          appendFeed(`${label(first.b)} not analyzed — starting analysis`, '#ffb4a8');
          jobs.push(analyzeAndWait(urlB, label(first.b)));
        }
        await Promise.all(jobs);

        appendFeed('recomputing comparison');
        const second = await postCompare(urlA, urlB);
        if (!second.comparison.ready) {
          throw new Error('comparison still not ready after analysis');
        }
        renderResults(second);
      } catch (e: any) {
        appendFeed(`ERROR — ${e.message}`, '#cc0000');
      } finally {
        btn.disabled = false;
        btn.textContent = 'COMPARE_REPOSITORIES';
      }
    }

    function keysSet(): boolean {
      return keys.github.length > 0 && keys.nim.length > 0;
    }

    btn.addEventListener('click', run);
  </script>

</body>
</html>
