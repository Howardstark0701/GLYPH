---
// GLYPH OS — Contributor Intelligence Profiles
// src/pages/repo/[id]/contributors.astro
export const prerender = false;

const { id } = Astro.params;

// A UUID job id means this is a REAL analysis — seed profiles/histograms only
// render for slug/demo URLs; real jobs render honest placeholders that the
// client hydrates from GET /api/repo/:id/contributors.
const IS_UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id ?? '');

let repoOwner = 'unknown';
let repoName  = 'unknown';
try {
  const decoded = decodeURIComponent(id ?? '');
  const match   = decoded.match(/github\.com\/([^\/]+)\/([^\/\s]+)/);
  if (match) {
    repoOwner = match[1];
    repoName  = match[2].replace(/\.git$/, '');
  } else {
    const parts = decoded.split('/').filter(Boolean);
    if (parts.length >= 2) { repoOwner = parts[0]; repoName = parts[1]; }
    else if (parts.length === 1) { repoName = parts[0]; }
  }
} catch (_) {}

// A single expression, not `{repoOwner}/{repoName}`: the Astro compiler
// swallows a `/{expr}` that follows another expression in the page title, so
// writing the two halves separately rendered "unknown" and dropped the
// repository name entirely.
const repoSlug = `${repoOwner}/${repoName}`;

// ── Static seed (replaced by GET /repo/:id/contributors) ──
interface Contributor {
  handle:      string;
  role:        string;
  decisions:   number;
  debates:     number;
  rejections:  number;
  influence:   number;   // 0-100
  pattern:     string;
  reasoning:   string;
  nodeId:      string;   // display ID e.g. AP-992-X
}

const contributors: Contributor[] = [
  {
    handle:     'arch_priya',
    role:       'ARCHITECT',
    decisions:  142,
    debates:    892,
    rejections: 14,
    influence:  82,
    pattern:    'ARCHITECTURAL_AUTHORITY',
    reasoning:  'Prioritizes long-term scalability over immediate implementation speed. Reasoning often cites structural integrity and cross-module dependency resilience.',
    nodeId:     'AP-992-X',
  },
  {
    handle:     'lead_author',
    role:       'LEAD AUTHOR',
    decisions:  204,
    debates:    412,
    rejections: 29,
    influence:  74,
    pattern:    'SYSTEM_COHESION',
    reasoning:  'Focuses on consensus-building and documentation clarity. Tendency to favor proven design patterns over experimental optimizations.',
    nodeId:     'LA-104-Y',
  },
  {
    handle:     'dev_soren',
    role:       'REVIEWER',
    decisions:  88,
    debates:    310,
    rejections: 41,
    influence:  61,
    pattern:    'PERFORMANCE_CRITICAL',
    reasoning:  'Flags long-term maintenance risk consistently. Rejection-heavy profile. Prefers battle-tested over novel. Slows adoption cycles deliberately.',
    nodeId:     'DS-447-R',
  },
  {
    handle:     'infra_tolly',
    role:       'INFRA ENGINEER',
    decisions:  56,
    debates:    198,
    rejections: 22,
    influence:  48,
    pattern:    'INFRA_GATEKEEPER',
    reasoning:  'Controls deployment and infrastructure gates. Low debate presence but high veto frequency. Decisions cluster around operational concerns.',
    nodeId:     'IT-211-G',
  },
  {
    handle:     'sec_ananya',
    role:       'SECURITY ANALYST',
    decisions:  31,
    debates:    144,
    rejections: 18,
    influence:  39,
    pattern:    'SECURITY_HARDENING',
    reasoning:  'Intervenes on auth and credential surface decisions. Low volume, high specificity. BYOK model was her sole top-level architectural contribution.',
    nodeId:     'SA-089-S',
  },
  {
    handle:     'analytics_reed',
    role:       'MODERATOR',
    decisions:  19,
    debates:    267,
    rejections: 11,
    influence:  31,
    pattern:    'CONSENSUS_BUILDER',
    reasoning:  'Rarely authors decisions. Mediates contested debates. Contributor scoring feature was rejected under his watch — insufficient commit evidence.',
    nodeId:     'AR-033-M',
  },
];

const maxInfluence = Math.max(...contributors.map(c => c.influence));

const registryStats = {
  total:         contributors.length,
  totalDecisions: contributors.reduce((a, c) => a + c.decisions, 0),
  participation:  '94.2',
  avgInfluence:   (contributors.reduce((a, c) => a + c.influence, 0) / contributors.length).toFixed(1),
};

const initials = (h: string) =>
  h.split('_').map(w => w[0]).join('').toUpperCase().slice(0, 2);
import RepoNavbar from '../../../components/RepoNavbar.astro';
import RepoSidebar from '../../../components/RepoSidebar.astro';

---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GLYPH — Contributors — {repoSlug}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="glyph-repo-slug" content={repoSlug} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <!-- is:global is required, not cosmetic. Astro scopes page CSS with a
       [data-astro-cid-*] attribute that only server-rendered markup carries.
       Every element these pages build in JS (live-feed lines, hydrated
       decision/contributor cards, D3 nodes) is created with innerHTML or
       document.createElement and therefore has no scope attribute — under
       scoped CSS it renders completely unstyled. This page's stylesheet is
       self-contained and loaded by this page alone, so going global is safe. -->
  <style is:global>
    /* ── Reset ───────────────────────────────────────────── */
    *, *::before, *::after {
      box-sizing: border-box;
    }
    /* interactive elements animate on the shared easing */
    a, button, [role="button"], input, select, textarea {
      transition: border-color 120ms cubic-bezier(0.2,0.6,0.2,1),
                  color 120ms cubic-bezier(0.2,0.6,0.2,1),
                  background-color 120ms cubic-bezier(0.2,0.6,0.2,1);
    }
    ::selection { background: #ffb4a8; color: #131313; }
    :focus-visible { outline: 1px solid #ffb4a8; outline-offset: 2px; }
    html, body {
      margin: 0; padding: 0;
      background: #131313;
      color: #e5e2e1;
      font-family: 'Karla', sans-serif;
      height: 100%; overflow: hidden;
    }

    /* ── Type ─────────────────────────────────────────────── */
    .data-sm    { font-family:'JetBrains Mono',monospace; font-size:0.6875rem; line-height:1.2; }
    .label-caps { font-family:'JetBrains Mono',monospace; font-size:0.625rem; letter-spacing:0.1em; text-transform:uppercase; line-height:1; }
    #nav-center {
      padding:0 18px; display:flex; align-items:center; gap:16px;
    }
    #nav-center .wordmark {
      font-family:'Space Grotesk',sans-serif; font-weight:700;
      font-size:0.9rem; color:#ffb4a8; letter-spacing:-0.01em;
    }
    #nav-center .version {
      font-family:'JetBrains Mono',monospace; font-size:0.6rem; color:#a1a1a1;
    }
    #nav-right {
      display:flex; align-items:center; gap:8px; padding:0 16px 0 12px;
    }

    /* ══════════════════════════════════════════════════════
       LAYOUT
    ══════════════════════════════════════════════════════ */
    #layout {
      position:fixed; top: 48px; left:0; right:0; bottom:0; display:flex;
    }
    .sb-user-label {
      font-family:'JetBrains Mono',monospace; font-size:0.6rem;
      letter-spacing:0.1em; text-transform:uppercase; color:#cc0000;
      display:block;
    }
    .sb-user-sub {
      font-family:'JetBrains Mono',monospace; font-size:0.55rem;
      color:#5e3f3a; letter-spacing:0.06em; text-transform:uppercase;
    }
    .sidebar-spacer { flex:1; }
    .util-row { display:flex; gap:6px; }

    /* ══════════════════════════════════════════════════════
       MAIN AREA
    ══════════════════════════════════════════════════════ */
    #main-area {
      flex:1; display:flex; flex-direction:column; overflow:hidden; min-width:0;
    }

    /* ── Page header ─────────────────────────────────────── */
    #page-header {
      padding:14px 20px 12px; border-bottom:1px solid #262626; flex-shrink:0;
    }
    .breadcrumb-row { display:flex; align-items:center; gap:8px; margin-bottom:5px; }
    .bc-primary { font-family:'JetBrains Mono',monospace; font-size:0.6rem; letter-spacing:0.12em; text-transform:uppercase; color:#a1a1a1; }
    .bc-sep     { color:#3a3a3a; font-size:0.75rem; }
    .bc-status  { font-family:'JetBrains Mono',monospace; font-size:0.6rem; letter-spacing:0.12em; text-transform:uppercase; color:#cc0000; }
    .page-title { font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:1.75rem; color:#ffb4a8; line-height:1; margin:0 0 6px; letter-spacing:-0.01em; }
    .page-desc  { font-family:'Karla',sans-serif; font-size:0.875rem; color:#a1a1a1; line-height:1.5; margin:0; max-width:680px; }

    /* ── Content body ────────────────────────────────────── */
    #content-body {
      flex:1; display:grid;
      grid-template-columns: 1fr 240px;
      grid-template-rows: 1fr 160px;
      overflow:hidden; min-height:0;
    }

    /* ══════════════════════════════════════════════════════
       CONTRIBUTOR LIST — scrollable left col
    ══════════════════════════════════════════════════════ */
    #contrib-list {
      grid-column:1; grid-row:1;
      border-right:1px solid #262626;
      overflow-y:auto; padding:16px 20px;
      display:flex; flex-direction:column; gap:12px;
    }
    .contrib-loading {
      margin:auto; padding:40px 0; text-align:center;
      font-family:'JetBrains Mono',monospace; font-size:0.65rem;
      letter-spacing:0.1em; color:#a1a1a1;
      animation: cb-pulse 2s ease-in-out infinite;
    }
    @keyframes cb-pulse { 0%,100% { opacity:1; } 50% { opacity:0.4; } }
    #contrib-list::-webkit-scrollbar { width: 4px; }
    #contrib-list::-webkit-scrollbar-track { background: #0e0e0e; }
    #contrib-list::-webkit-scrollbar-thumb { background: #cc0000; }
    #contrib-list::-webkit-scrollbar-thumb:hover { background: #ff0000; }

    /* ── Contributor block ───────────────────────────────── */
    .contrib-block {
      background: #0e0e0e; border: 1px solid #262626;
      cursor: pointer;
    }
    .contrib-block:hover { border-color: rgba(204, 0, 0, 0.6); }

    /* Header row */
    .cb-header {
      display:flex; align-items:center; gap:12px;
      padding:10px 14px; border-bottom:1px solid #262626;
    }
    .cb-avatar {
      width:36px; height:36px; background:#1a1a1a;
      display:flex; align-items:center; justify-content:center;
      flex-shrink:0;
    }
    .cb-avatar-text {
      font-family:'JetBrains Mono',monospace; font-weight:700;
      font-size:0.75rem; color:#cc0000; letter-spacing:0.04em;
    }
    .cb-identity { flex:1; display:flex; flex-direction:column; gap:5px; }
    .cb-handle {
      font-family:'Space Grotesk',sans-serif; font-weight:600;
      font-size:0.9rem; color:#e5e2e1;
    }
    .cb-handle-prefix { color:#5e3f3a; }
    .cb-role-row { display:flex; align-items:center; gap:8px; }
    .cb-role-chip {
      font-family:'JetBrains Mono',monospace; font-size:0.5rem;
      letter-spacing:0.1em; text-transform:uppercase;
      color:#cc0000; border:1px solid #cc0000;
      padding:2px 6px; background:transparent; line-height:1.4;
    }
    .cb-influence-tag {
      font-family:'JetBrains Mono',monospace; font-size:0.55rem;
      letter-spacing:0.08em; text-transform:uppercase; color:#a1a1a1;
    }
    .cb-influence-val {
      font-family:'JetBrains Mono',monospace; font-weight:700;
      font-size:0.75rem; color:#cc0000;
    }
    .cb-node-id {
      font-family:'JetBrains Mono',monospace; font-size:0.55rem;
      color:#3a3a3a; letter-spacing:0.06em; margin-left:auto; align-self:flex-start;
    }

    /* Stats strip */
    .cb-stats {
      display:grid; grid-template-columns:repeat(3,1fr);
      border-bottom:1px solid #262626;
    }
    .cb-stat-cell {
      padding:9px 14px; border-right:1px solid #262626; text-align:center;
    }
    .cb-stat-cell:last-child { border-right:none; }
    .cb-stat-val {
      font-family:'JetBrains Mono',monospace; font-weight:700;
      font-size:1.1rem; color:#e5e2e1; display:block; line-height:1;
      margin-bottom:3px;
    }
    .cb-stat-label {
      font-family:'JetBrains Mono',monospace; font-size:0.5rem;
      letter-spacing:0.1em; text-transform:uppercase; color:#a1a1a1;
    }

    /* Reasoning profile */
    .cb-reasoning { padding:10px 14px; border-bottom:1px solid #262626; }
    .cb-reasoning-label {
      font-family:'JetBrains Mono',monospace; font-size:0.55rem;
      letter-spacing:0.1em; text-transform:uppercase; color:#cc0000;
      display:block; margin-bottom:5px;
    }
    .cb-reasoning-text {
      font-family:'Karla',sans-serif; font-style:italic;
      font-size:0.8125rem; color:#a1a1a1; line-height:1.5;
      display:-webkit-box; -webkit-line-clamp:2;
      -webkit-box-orient:vertical; overflow:hidden;
    }

    /* Footer row */
    .cb-footer {
      display:flex; align-items:center; justify-content:space-between;
      padding:7px 14px;
    }
    .cb-pattern-label { font-family:'JetBrains Mono',monospace; font-size:0.55rem; letter-spacing:0.1em; text-transform:uppercase; color:#a1a1a1; }
    .cb-pattern-val   { font-family:'JetBrains Mono',monospace; font-size:0.55rem; letter-spacing:0.1em; text-transform:uppercase; color:#cc0000; }
    .cb-id-tag        { font-family:'JetBrains Mono',monospace; font-size:0.55rem; color:#3a3a3a; }

    /* ══════════════════════════════════════════════════════
       RIGHT PANEL — registry stats + charts
    ══════════════════════════════════════════════════════ */
    #right-panel {
      grid-column:2; grid-row:1;
      border-bottom:1px solid #262626;
      background:#131313; overflow-y:auto;
      display:flex; flex-direction:column;
    }
    #right-panel::-webkit-scrollbar { width:3px; }
    #right-panel::-webkit-scrollbar-track { background:#131313; }
    #right-panel::-webkit-scrollbar-thumb { background:#262626; }

    .rp-section { padding:12px 14px; border-bottom:1px solid #262626; }
    .rp-section:last-child { border-bottom:none; }
    .rp-label {
      font-family:'JetBrains Mono',monospace; font-size:0.6rem;
      letter-spacing:0.12em; text-transform:uppercase; color:#cc0000;
      display:flex; align-items:center; gap:6px; margin-bottom:10px;
    }
    .rp-label-dot { width:6px; height:6px; background:#cc0000; flex-shrink:0; }

    /* Registry stat rows */
    .rp-stat-row {
      display:flex; align-items:baseline; justify-content:space-between;
      margin-bottom:8px;
    }
    .rp-stat-row:last-child { margin-bottom:0; }
    .rp-stat-key {
      font-family:'JetBrains Mono',monospace; font-size:0.55rem;
      letter-spacing:0.08em; text-transform:uppercase; color:#a1a1a1;
    }
    .rp-stat-val {
      font-family:'JetBrains Mono',monospace; font-weight:700;
      font-size:1.1rem; color:#e5e2e1; line-height:1;
    }

    /* Influence histogram */
    .inf-bar-row {
      display:flex; align-items:center; gap:8px; margin-bottom:6px;
    }
    .inf-bar-row:last-child { margin-bottom:0; }
    .inf-bar-handle {
      font-family:'JetBrains Mono',monospace; font-size:0.55rem;
      letter-spacing:0.04em; color:#a1a1a1; width:76px; flex-shrink:0;
      text-transform:uppercase;
    }
    .inf-bar-track { flex:1; height:3px; background:#1a1a1a; position:relative; }
    .inf-bar-fill  { height:3px; background:#cc0000; }
    .inf-bar-pct {
      font-family:'JetBrains Mono',monospace; font-size:0.55rem;
      color:#cc0000; width:30px; text-align:right; flex-shrink:0;
    }

    /* Pattern breakdown */
    .pattern-row {
      display:flex; align-items:center; gap:8px; margin-bottom:7px;
    }
    .pattern-row:last-child { margin-bottom:0; }
    .pattern-dot { width:5px; height:5px; background:#cc0000; flex-shrink:0; }
    .pattern-name {
      font-family:'JetBrains Mono',monospace; font-size:0.55rem;
      letter-spacing:0.06em; text-transform:uppercase; color:#a1a1a1; flex:1;
    }
    .pattern-owner {
      font-family:'JetBrains Mono',monospace; font-size:0.55rem;
      color:#5e3f3a;
    }

    /* ══════════════════════════════════════════════════════
       BOTTOM FEED
    ══════════════════════════════════════════════════════ */
    #feed-panel {
      grid-column:1/3; grid-row:2;
      display:flex; flex-direction:column;
      background:#0e0e0e; overflow:hidden;
    }
    #feed-header {
      padding:6px 14px; border-bottom:1px solid #262626;
      background:#131313; flex-shrink:0;
      display:flex; align-items:center; justify-content:space-between;
    }
    .feed-header-left {
      display:flex; align-items:center; gap:8px;
      font-family:'JetBrains Mono',monospace; font-size:0.6rem;
      letter-spacing:0.1em; text-transform:uppercase; color:#e5e2e1;
    }
    .feed-sq { width:7px; height:7px; background:#cc0000; }
    .feed-sep { color:#5e3f3a; }
    .feed-header-right {
      font-family:'JetBrains Mono',monospace; font-size:0.6rem; color:#a1a1a1;
    }
    /* Right side — EXECUTE_FETCH + util buttons */
    #feed-actions {
      display:flex; align-items:center; gap:8px;
    }
    #feed-exec-btn {
      background:#cc0000; border:none;
      font-family:'JetBrains Mono',monospace; font-size:0.6rem;
      letter-spacing:0.12em; text-transform:uppercase;
      color:#fff; padding:6px 14px; cursor:pointer;
    }
    #feed-exec-btn:hover { background:#ff0000; }
    .feed-ghost-btn {
      background:transparent; border:1px solid #262626;
      font-family:'JetBrains Mono',monospace; font-size:0.55rem;
      letter-spacing:0.1em; text-transform:uppercase;
      color:#a1a1a1; padding:5px 10px; cursor:pointer;
    }
    .feed-ghost-btn:hover { border-color:#cc0000; color:#cc0000; }

    #feed-body {
      flex: 1; overflow-y: auto; padding: 6px 14px;
      display: flex; flex-direction: column;
      mask-image: linear-gradient(to bottom, transparent, black 15%, black 85%, transparent);
      -webkit-mask-image: linear-gradient(to bottom, transparent, black 15%, black 85%, transparent);
    }
    #feed-body::-webkit-scrollbar { width: 4px; }
    #feed-body::-webkit-scrollbar-track { background: #0e0e0e; }
    #feed-body::-webkit-scrollbar-thumb { background: #cc0000; }
    #feed-body::-webkit-scrollbar-thumb:hover { background: #ff0000; }

    .f-line {
      font-family:'JetBrains Mono',monospace; font-size:0.6rem;
      line-height:1.65; white-space:nowrap; color:#a1a1a1; letter-spacing:0.04em;
    }
    .f-tag  { color:#cc0000; font-weight:700; }
    .f-mute { color:#a1a1a1; }
    .f-em   { color:#e5e2e1; }
    .f-rust { color:#5e3f3a; }
  </style>
</head>
<body>

  <!-- ════════════════════════════════════════════════════════
       NAVBAR
  ═════════════════════════════════════════════════════════ -->
  <RepoNavbar repoSlug={repoSlug} />

  <!-- ════════════════════════════════════════════════════════
       LAYOUT
  ═════════════════════════════════════════════════════════ -->
  <div id="layout">

    <!-- ── SIDEBAR ───────────────────────────────────────── -->
    <RepoSidebar id={id} active="contributors" />

    <!-- ── MAIN AREA ──────────────────────────────────────── -->
    <div id="main-area">

      <!-- Page header -->
      <header id="page-header">
        <div class="breadcrumb-row">
          <span class="bc-primary">CONTRIBUTOR_REGISTRY</span>
          <span class="bc-sep">/</span>
          <span class="bc-status">STATUS: PROFILES</span>
        </div>
        <h1 class="page-title">CONTRIBUTOR INTELLIGENCE PROFILES</h1>
        <p class="page-desc">
          Neural-extracted reasoning profiles for each contributor. Derived from decision authorship, debate participation, and rejection ownership.
        </p>
      </header>

      <div id="content-body">

        <!-- ── CONTRIBUTOR LIST ───────────────────────────── -->
        <div id="contrib-list" role="list" aria-label="Contributor profiles">
          {IS_UUID ? (
            <div class="contrib-loading">SYNCING_CONTRIBUTOR_PROFILES…</div>
          ) : (
          contributors.map((c) => (
            <div class="contrib-block" role="listitem" aria-label={`Contributor: ${c.handle}`}>

              <!-- Header -->
              <div class="cb-header">
                <div class="cb-avatar" aria-hidden="true">
                  <span class="cb-avatar-text">{initials(c.handle)}</span>
                </div>
                <div class="cb-identity">
                  <span class="cb-handle">
                    <span class="cb-handle-prefix">@</span>{c.handle}
                  </span>
                  <div class="cb-role-row">
                    <span class="cb-role-chip">{c.role}</span>
                    <span class="cb-influence-tag">INFLUENCE_WEIGHT:</span>
                    <span class="cb-influence-val">{c.influence}%</span>
                  </div>
                </div>
                <!-- Copy icon placeholder -->
                <div style="margin-left:auto;color:#3a3a3a;" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <rect x="3" y="3" width="8" height="8" stroke="currentColor" stroke-width="1"/>
                    <rect x="1" y="1" width="8" height="8" stroke="currentColor" stroke-width="1" fill="#131313"/>
                  </svg>
                </div>
              </div>

              <!-- Stats strip -->
              <div class="cb-stats" aria-label={`Stats: ${c.decisions} decisions, ${c.debates} debates, ${c.rejections} rejections`}>
                <div class="cb-stat-cell">
                  <span class="cb-stat-val">{c.decisions.toLocaleString()}</span>
                  <span class="cb-stat-label">DECISIONS</span>
                </div>
                <div class="cb-stat-cell">
                  <span class="cb-stat-val">{c.debates.toLocaleString()}</span>
                  <span class="cb-stat-label">DEBATES</span>
                </div>
                <div class="cb-stat-cell">
                  <span class="cb-stat-val">{c.rejections}</span>
                  <span class="cb-stat-label">REJECTIONS</span>
                </div>
              </div>

              <!-- Reasoning -->
              <div class="cb-reasoning">
                <span class="cb-reasoning-label">REASONING_PROFILE:</span>
                <p class="cb-reasoning-text">{c.reasoning}</p>
              </div>

              <!-- Footer -->
              <div class="cb-footer">
                <div style="display:flex;align-items:center;gap:6px;">
                  <span class="cb-pattern-label">DOMINANT_PATTERN:</span>
                  <span class="cb-pattern-val">{c.pattern}</span>
                </div>
                <span class="cb-id-tag">ID: {c.nodeId}</span>
              </div>

            </div>
          ))
          )}
        </div>

        <!-- ── RIGHT PANEL ────────────────────────────────── -->
        <aside id="right-panel" aria-label="Registry intelligence">

          <!-- Registry stats -->
          <div class="rp-section" id="registry-stats">
            <div class="rp-label">
              <span class="rp-label-dot" aria-hidden="true"></span>
              REGISTRY_STATS
            </div>
            <div class="rp-stat-row" aria-label={IS_UUID ? 'Total contributors pending' : `Total contributors: ${registryStats.total}`}>
              <span class="rp-stat-key">TOTAL CONTRIBUTORS</span>
              <span class="rp-stat-val" id="rs-total">{IS_UUID ? '—' : registryStats.total}</span>
            </div>
            <div class="rp-stat-row" aria-label={IS_UUID ? 'Total decisions pending' : `Total decisions: ${registryStats.totalDecisions}`}>
              <span class="rp-stat-key">TOTAL DECISIONS</span>
              <span class="rp-stat-val" id="rs-decisions">{IS_UUID ? '—' : registryStats.totalDecisions.toLocaleString()}</span>
            </div>
            <div class="rp-stat-row" aria-label={IS_UUID ? 'Participation pending' : `Participation: ${registryStats.participation}%`}>
              <span class="rp-stat-key">PARTICIPATION %</span>
              <span class="rp-stat-val" id="rs-participation">{IS_UUID ? '—' : registryStats.participation}%</span>
            </div>
            <div class="rp-stat-row" aria-label={IS_UUID ? 'Average influence pending' : `Average influence: ${registryStats.avgInfluence}%`}>
              <span class="rp-stat-key">AVG INFLUENCE</span>
              <span class="rp-stat-val" id="rs-influence">{IS_UUID ? '—' : registryStats.avgInfluence}%</span>
            </div>
          </div>

          <!-- Influence histogram -->
          <div class="rp-section" id="influence-hist">
            <div class="rp-label">
              <span class="rp-label-dot" aria-hidden="true"></span>
              INFLUENCE_HIST
            </div>
            {IS_UUID ? (
              <div class="contrib-loading">SYNCING_INFLUENCE_HIST…</div>
            ) : (
              contributors.map((c) => (
                <div class="inf-bar-row" aria-label={`${c.handle}: ${c.influence}%`}>
                  <span class="inf-bar-handle">{c.handle.replace('_',' ').toUpperCase().slice(0,10)}</span>
                  <div class="inf-bar-track" aria-hidden="true">
                    <div class="inf-bar-fill" style={`width:${Math.round(c.influence / maxInfluence * 100)}%`}></div>
                  </div>
                  <span class="inf-bar-pct">{c.influence}%</span>
                </div>
              ))
            )}
          </div>

          <!-- Pattern breakdown -->
          <div class="rp-section" id="pattern-breakdown">
            <div class="rp-label">
              <span class="rp-label-dot" aria-hidden="true"></span>
              PATTERN_BREAKDOWN
            </div>
            {IS_UUID ? (
              <div class="contrib-loading">SYNCING_PATTERN_BREAKDOWN…</div>
            ) : (
              contributors.map((c) => (
                <div class="pattern-row" aria-label={`${c.pattern}: ${c.handle}`}>
                  <span class="pattern-dot" aria-hidden="true"></span>
                  <span class="pattern-name">{c.pattern.replace(/_/g,' ').toLowerCase()}</span>
                  <span class="pattern-owner">@{c.handle.split('_')[0]}</span>
                </div>
              ))
            )}
          </div>

        </aside>

        <!-- ── BOTTOM FEED ────────────────────────────────── -->
        <section id="feed-panel" aria-labelledby="feed-title">
          <div id="feed-header">
            <div class="feed-header-left" id="feed-title">
              <span class="feed-sq" aria-hidden="true"></span>
              CONTRIBUTOR_INTEL_FEED
              <span class="feed-sep">//</span>
              ACTIVE
            </div>
            <div id="feed-actions">
              <span class="feed-header-right" style="margin-right:12px;">PROFILES: {IS_UUID ? '—' : contributors.length}</span>
              <button id="feed-exec-btn" type="button" aria-label="Execute fetch">EXECUTE_FETCH</button>
              <button class="feed-ghost-btn" type="button" aria-label="Export CSV">EXPORT_CSV</button>
              <button class="feed-ghost-btn" type="button" aria-label="Purge cache">PURGE_CACHE</button>
            </div>
          </div>
          <div id="feed-body" role="log" aria-label="Contributor intelligence feed" aria-live="polite">
            {IS_UUID ? (
              <div class="f-line"><span class="f-mute">[SYSTEM] Connecting to analysis service…</span></div>
            ) : (
            <Fragment>
            <div class="f-line"><span class="f-tag">[PROFILE]</span><span class="f-mute"> @arch_priya reasoning extracted: </span><span class="f-em">'PRIORITIZES_STRUCTURE'</span></div>
            <div class="f-line"><span class="f-mute">[INFLUENCE] @lead_author scored: </span><span class="f-em">74%</span><span class="f-mute"> aggregate authority</span></div>
            <div class="f-line"><span class="f-mute">[QUERY] Searching registry for 'performance' pattern matches...</span></div>
            <div class="f-line"><span class="f-mute">[MATCH] @dev_soren linked to pattern: </span><span class="f-em">PERFORMANCE_CRITICAL</span></div>
            <div class="f-line"><span class="f-mute">[SYSTEM] Cross-referencing decision history for @infra_tolly...</span></div>
            <div class="f-line"><span style="color:#cc0000;font-weight:700;">[ALERT]</span><span class="f-mute"> Minimal debate participation detected for </span><span class="f-em">@sec_ananya</span></div>
            <div class="f-line"><span class="f-tag">[PROFILE]</span><span class="f-mute"> @analytics_reed profile updated: </span><span class="f-em">'MODERATOR_TRAIT_DETECTED'</span></div>
            <div class="f-line"><span class="f-mute">[NETWORK] Synchronizing intelligence nodes across 12 clusters...</span></div>
            </Fragment>
            )}
          </div>
        </section>

      </div><!-- /content-body -->
    </div><!-- /main-area -->
  </div><!-- /layout -->

  <!-- ════════════════════════════════════════════════════════
       SCRIPTS
  ═════════════════════════════════════════════════════════ -->
  <!-- Seed payload as JSON: define:vars forces the script inline, which stops
       Astro bundling it and makes the ES imports below throw. -->
  <script type="application/json" id="glyph-seed" set:html={JSON.stringify({ seedContributors: contributors })}></script>

  <script>
    import { getJobId, apiBase, showEmptyState, appendErrorLine, startStatusFeed, apiFetch }
      from '../../../scripts/repo-view';

    const seedEl = document.getElementById('glyph-seed');
    const { seedContributors } = JSON.parse(seedEl?.textContent || '{"seedContributors":[]}');
    const API_BASE = apiBase();

    // ── Hydrate real contributor profiles from the API ────
    (function hydrateContributors() {
      const jobId = getJobId();
      if (!jobId) return;

      const initials = (h: string) =>
        h.split(/[_\-]/).slice(0, 2).map(p => (p[0] ?? '').toUpperCase()).join('') || '??';

      apiFetch(`${API_BASE}/api/repo/${jobId}/contributors`)
        .then(r => r.ok ? r.json() : null)
        .then(data => {
          const raw = data?.contributors;
          if (!Array.isArray(raw) || !raw.length) {
            const feed = document.getElementById('feed-body');
            showEmptyState(feed, 'NO_CONTRIBUTORS_SIGNALED',
              'This analysis isolated no authorship patterns for this repository.');
            return;
          }

          const maxNodes = Math.max(...raw.map((c: any) => c.total_nodes ?? 0), 1);
          const nodes = raw.map((c: any, idx: number) => {
            const decisions  = c.decisions ?? 0;
            const debates    = c.debates ?? 0;
            const rejections = c.rejections ?? 0;
            const total      = c.total_nodes ?? (decisions + debates + rejections);
            const influence  = Math.max(1, Math.round((total / maxNodes) * 100));
            const rejectionRate = total > 0 ? rejections / total : 0;
            // null when none of this contributor's nodes carried a model
            // score. Saying "0% mean confidence" about them would be an
            // invented reading of the data, so the clause is dropped instead.
            const rated      = c.avg_confidence !== null && c.avg_confidence !== undefined;
            const confidence = rated ? Math.round(c.avg_confidence) : null;

            const role = rejectionRate > 0.4
              ? 'REVIEWER / GATEKEEPER'
              : debates > decisions
                ? 'DEBATE LEADER'
                : 'DECISION AUTHOR';

            const pattern = rejectionRate > 0.4
              ? 'REJECTION_HARDENED'
              : debates > decisions && debates > rejections
                ? 'DEBATE_DRIVEN'
                : decisions > 0
                  ? 'DECISION_AUTHORITY'
                  : 'OBSERVER';

            const reasoning = rejectionRate > 0.4
              ? `Rejection-heavy profile — blocks proposals that lack evidence. ${rejections} proposals vetoed across ${debates} debate threads.`
              : debates > decisions
                ? `Consensus-builder — active in ${debates} debate threads, authors ${decisions} decisions. Pressures proposals through review.`
                : `Primary decision author — owns ${decisions} decisions directly. ${rejections} proposals rejected.${rated ? ` Signals at ${confidence}% mean confidence.` : ''}`;

            return {
              handle: c.handle, decisions, debates, rejections, influence, confidence, role, pattern, reasoning,
              nodeId: `CTB-${String(idx + 1).padStart(3, '0')}-${(c.handle.slice(0, 2) || 'XX').toUpperCase()}`,
            };
          });

          // Rebuild the card grid
          const list = document.getElementById('contrib-list');
          if (list) {
            list.innerHTML = '';
            nodes.forEach(c => {
              const block = document.createElement('div');
              block.className = 'contrib-block';
              block.setAttribute('role', 'listitem');
              block.setAttribute('aria-label', `Contributor: ${c.handle}`);
              block.innerHTML = `
                <div class="cb-header">
                  <div class="cb-avatar" aria-hidden="true"><span class="cb-avatar-text">${initials(c.handle)}</span></div>
                  <div class="cb-identity">
                    <span class="cb-handle"><span class="cb-handle-prefix">@</span>${c.handle}</span>
                    <div class="cb-role-row">
                      <span class="cb-role-chip">${c.role}</span>
                      <span class="cb-influence-tag">INFLUENCE_WEIGHT:</span>
                      <span class="cb-influence-val">${c.influence}%</span>
                    </div>
                  </div>
                  <div style="margin-left:auto;color:#3a3a3a;" aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                      <rect x="3" y="3" width="8" height="8" stroke="currentColor" stroke-width="1"/>
                      <rect x="1" y="1" width="8" height="8" stroke="currentColor" stroke-width="1" fill="#131313"/>
                    </svg>
                  </div>
                </div>
                <div class="cb-stats" aria-label="Stats: ${c.decisions} decisions, ${c.debates} debates, ${c.rejections} rejections">
                  <div class="cb-stat-cell"><span class="cb-stat-val">${c.decisions.toLocaleString()}</span><span class="cb-stat-label">DECISIONS</span></div>
                  <div class="cb-stat-cell"><span class="cb-stat-val">${c.debates.toLocaleString()}</span><span class="cb-stat-label">DEBATES</span></div>
                  <div class="cb-stat-cell"><span class="cb-stat-val">${c.rejections}</span><span class="cb-stat-label">REJECTIONS</span></div>
                </div>
                <div class="cb-reasoning">
                  <span class="cb-reasoning-label">REASONING_PROFILE:</span>
                  <p class="cb-reasoning-text">${c.reasoning}</p>
                </div>
                <div class="cb-footer">
                  <div style="display:flex;align-items:center;gap:6px;">
                    <span class="cb-pattern-label">DOMINANT_PATTERN:</span>
                    <span class="cb-pattern-val">${c.pattern}</span>
                  </div>
                  <span class="cb-id-tag">ID: ${c.nodeId}</span>
                </div>`;
              list.appendChild(block);
            });
          }

          // Registry stats
          const totalDecisions = nodes.reduce((a, c) => a + c.decisions, 0);
          const avgInfluence   = Math.round(nodes.reduce((a, c) => a + c.influence, 0) / nodes.length);
          const participation  = Math.min(100, Math.round(avgInfluence));
          const statVals = document.querySelectorAll('#registry-stats .rp-stat-row .rp-stat-val');
          if (statVals[0]) statVals[0].textContent = String(nodes.length);
          if (statVals[1]) statVals[1].textContent = totalDecisions.toLocaleString();
          if (statVals[2]) statVals[2].textContent = `${participation}%`;
          if (statVals[3]) statVals[3].textContent = `${avgInfluence}%`;

          // Influence histogram
          const hist = document.getElementById('influence-hist');
          if (hist) {
            hist.querySelectorAll('.inf-bar-row, .contrib-loading').forEach(el => el.remove());
            nodes.forEach(c => {
              const row = document.createElement('div');
              row.className = 'inf-bar-row';
              row.setAttribute('aria-label', `${c.handle}: ${c.influence}%`);
              row.innerHTML = `
                <span class="inf-bar-handle">${c.handle.replace('_', ' ').toUpperCase().slice(0, 10)}</span>
                <div class="inf-bar-track" aria-hidden="true">
                  <div class="inf-bar-fill" style="width:${Math.round(c.influence / Math.max(...nodes.map(n => n.influence)) * 100)}%"></div>
                </div>
                <span class="inf-bar-pct">${c.influence}%</span>`;
              hist.appendChild(row);
            });
          }

          // Pattern breakdown
          const patterns = document.getElementById('pattern-breakdown');
          if (patterns) {
            patterns.querySelectorAll('.pattern-row, .contrib-loading').forEach(el => el.remove());
            nodes.forEach(c => {
              const row = document.createElement('div');
              row.className = 'pattern-row';
              row.setAttribute('aria-label', `${c.pattern}: ${c.handle}`);
              row.innerHTML = `
                <span class="pattern-dot" aria-hidden="true"></span>
                <span class="pattern-name">${c.pattern.replace(/_/g, ' ').toLowerCase()}</span>
                <span class="pattern-owner">@${c.handle.split('_')[0]}</span>`;
              patterns.appendChild(row);
            });
          }

          // Profile counter in feed header
          const counter = document.querySelector('.feed-header-right');
          if (counter) counter.textContent = `PROFILES: ${nodes.length}`;
        })
        .catch(() => {
          const body = document.getElementById('feed-body');
          // "showing static preview" was untrue — nothing was shown at all, and
          // the panel below stayed on its SYNCING placeholder for ever. Say
          // what happened and clear the placeholder.
          appendErrorLine(body, 'ANALYSIS SERVICE UNREACHABLE — no data loaded');
          showEmptyState(
            document.getElementById('contrib-list'),
            'SERVICE_UNREACHABLE',
            'The analysis API did not respond. Check the backend is running, then reload.',
          );
        });
    })();

    // ── Execute fetch ─────────────────────────────────────
    (function() {
      const btns = [
        document.getElementById('feed-exec-btn'),
      ];
      btns.forEach(btn => {
        if (!btn) return;
        btn.addEventListener('click', () => {
          btn.textContent = 'FETCHING...';
          setTimeout(() => { btn.textContent = 'EXECUTE_FETCH'; }, 2000);
        });
      });
    })();

    // ── Live feed ─────────────────────────────────────────
    (function initFeed() {
      const body = document.getElementById('feed-body');
      if (!body) return;

      // Real jobs stream actual analysis stage; only demo URLs fabricate.
      // Wipe the server-rendered placeholder first so no seed line survives.
      if (getJobId()) {
        body.innerHTML = '';
        startStatusFeed(body);
        return;
      }

      const cs      = seedContributors;
      const handles = cs.map(c => c.handle);
      const patterns= cs.map(c => c.pattern);
      let   hi = 0, pi = 0, di = 1, ri = 1, pri = 9821;

      function ts() {
        const d = new Date();
        return `${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}:${String(d.getSeconds()).padStart(2,'0')}`;
      }

      const pool = [
        () => `<span class="f-tag">[PROFILE]</span><span class="f-rust"> @${handles[hi++ % handles.length]}</span><span class="f-mute"> — reasoning profile extracted</span>`,
        () => `<span class="f-mute">[INFLUENCE] </span><span class="f-em">@${handles[hi % handles.length]}</span><span class="f-mute"> scored </span><span class="f-em">${Math.floor(Math.random()*50+30)}%</span><span class="f-mute"> influence</span>`,
        () => `<span class="f-mute">[PATTERN] DOMINANT_PATTERN: </span><span class="f-em">${patterns[pi++ % patterns.length]}</span><span class="f-mute"> assigned to </span><span class="f-rust">@${handles[hi % handles.length]}</span>`,
        () => `<span class="f-mute">[DECISION] </span><span class="f-em">@${handles[hi % handles.length]}</span><span class="f-mute"> authored DECISION_${String(di++).padStart(2,'0')}</span>`,
        () => `<span class="f-mute">[DEBATE] </span><span class="f-em">@${handles[hi % handles.length]}</span><span class="f-mute"> opened debate thread PR #${pri++}</span>`,
        () => `<span class="f-mute">[REJECTION] </span><span class="f-em">@${handles[hi % handles.length]}</span><span class="f-mute"> owns REJECTION_RECORD_${String(ri++).padStart(2,'0')}</span>`,
        () => `<span class="f-mute">[MATCH] Heuristic overlap found between </span><span class="f-em">@${handles[0]}</span><span class="f-mute"> and </span><span class="f-em">@${handles[2]}</span>`,
        () => `<span class="f-mute">[QUERY] Fetching authorship weight for PR-${pri}...</span>`,
        () => `<span class="f-mute">[DECRYPT] Reasoning hashes validated for </span><span class="f-em">@${handles[hi % handles.length]}</span>`,
        () => `<span style="color:#cc0000;font-weight:700;">[ALERT]</span><span class="f-mute"> Minimal debate participation detected for </span><span class="f-em">@${handles[hi % handles.length]}</span>`,
        () => `<span class="f-mute">[NETWORK] Synchronizing intelligence nodes across ${Math.floor(Math.random()*8+8)} clusters...</span>`,
      ];

      let idx = 0;
      setInterval(() => {
        const line = document.createElement('div');
        line.className = 'f-line';
        line.innerHTML = pool[idx % pool.length]();
        idx++;
        body.appendChild(line);
        body.scrollTop = body.scrollHeight;
        while (body.children.length > 40) body.removeChild(body.firstChild);
      }, 2000);
    })();
  </script>

</body>
</html>
