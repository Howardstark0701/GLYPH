---
// GLYPH OS — Rejection Vault
// src/pages/repo/[id]/rejections.astro
export const prerender = false;

const { id } = Astro.params;

// A UUID job id means this is a REAL analysis — seed cards only render for
// slug/demo URLs; real jobs render an honest placeholder hydrated by the client.
const IS_UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id ?? '');

// Decode repo slug from id param
let repoOwner = 'unknown';
let repoName  = 'unknown';
try {
  const decoded = decodeURIComponent(id ?? '');
  const match   = decoded.match(/github\.com\/([^\/]+)\/([^\/\s]+)/);
  if (match) {
    repoOwner = match[1];
    repoName  = match[2].replace(/\.git$/, '');
  } else {
    const parts = decoded.split('/').filter(Boolean);
    if (parts.length >= 2) { repoOwner = parts[0]; repoName = parts[1]; }
    else if (parts.length === 1) { repoName = parts[0]; }
  }
} catch (_) {}

const repoSlug = `${repoOwner}/${repoName}`;
const repoId   = `${repoOwner}-${repoName}`.toLowerCase();

// ── Static rejection data (populated from GET /repo/:id/rejections in prod) ──
interface Rejection {
  index:       number;
  title:       string;
  contributor: string;
  timestamp:   string;
  reason?:     string;   // only on "critical" cards
}

const rejections: Rejection[] = [
  { index: 1,  title: 'ASYNC_BATCH_PROCESSOR',       contributor: 'dev_marcus',       timestamp: '2024-02-14T09:12:44Z' },
  { index: 2,  title: 'MONOLITH_REWRITE_ATTEMPT',    contributor: 'arch_priya',       timestamp: '2024-03-01T14:38:02Z', reason: 'DEBATE_UNRESOLVED' },
  { index: 3,  title: 'GRAPHQL_MIGRATION_LAYER',      contributor: 'dev_soren',        timestamp: '2024-03-18T11:05:19Z' },
  { index: 4,  title: 'REDIS_CACHE_INTEGRATION',     contributor: 'infra_tolly',      timestamp: '2024-04-02T16:22:55Z' },
  { index: 5,  title: 'WEBSOCKET_REALTIME_FEED',     contributor: 'dev_marcus',       timestamp: '2024-04-11T08:47:31Z', reason: 'INSUFFICIENT_COMMIT_EVIDENCE' },
  { index: 6,  title: 'OAUTH_PROVIDER_SWITCH',       contributor: 'sec_ananya',       timestamp: '2024-04-29T13:14:08Z' },
  { index: 7,  title: 'RATE_LIMIT_BYPASS_MODULE',    contributor: 'dev_soren',        timestamp: '2024-05-07T10:33:22Z' },
  { index: 8,  title: 'MULTI_TENANT_SCHEMA',         contributor: 'arch_priya',       timestamp: '2024-05-22T17:01:47Z', reason: 'DEBATE_UNRESOLVED' },
  { index: 9,  title: 'STREAMING_DIFF_ENGINE',       contributor: 'dev_marcus',       timestamp: '2024-06-03T09:55:13Z' },
  { index: 10, title: 'CONTRIBUTOR_SCORING_V1',      contributor: 'analytics_reed',   timestamp: '2024-06-19T15:28:39Z' },
  { index: 11, title: 'FULL_TEXT_SEARCH_INDEX',      contributor: 'infra_tolly',      timestamp: '2024-07-08T12:09:04Z', reason: 'INSUFFICIENT_COMMIT_EVIDENCE' },
  { index: 12, title: 'WEBHOOK_EVENT_PIPELINE',      contributor: 'dev_soren',        timestamp: '2024-07-24T11:42:17Z' },
];

// Pre-compute padded IDs: repo_id-001, repo_id-002 ...
const padIdx = (n: number) => String(n).padStart(3, '0');
import RepoNavbar from '../../../components/RepoNavbar.astro';
import RepoSidebar from '../../../components/RepoSidebar.astro';

---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GLYPH — Rejection Vault — {repoSlug}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="glyph-repo-slug" content={repoSlug} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <!-- is:global is required, not cosmetic. Astro scopes page CSS with a
       [data-astro-cid-*] attribute that only server-rendered markup carries.
       Every element these pages build in JS (live-feed lines, hydrated
       decision/contributor cards, D3 nodes) is created with innerHTML or
       document.createElement and therefore has no scope attribute — under
       scoped CSS it renders completely unstyled. This page's stylesheet is
       self-contained and loaded by this page alone, so going global is safe. -->
  <style is:global>
    /* ── Reset ────────────────────────────────────────────── */
    *, *::before, *::after {
      box-sizing: border-box;
    }
    /* interactive elements animate on the shared easing */
    a, button, [role="button"], input, select, textarea {
      transition: border-color 120ms cubic-bezier(0.2,0.6,0.2,1),
                  color 120ms cubic-bezier(0.2,0.6,0.2,1),
                  background-color 120ms cubic-bezier(0.2,0.6,0.2,1);
    }
    ::selection { background: #ffb4a8; color: #131313; }
    :focus-visible { outline: 1px solid #ffb4a8; outline-offset: 2px; }
    html, body {
      margin: 0; padding: 0;
      background: #131313;
      color: #e5e2e1;
      font-family: 'Karla', sans-serif;
      height: 100%;
      overflow: hidden;
    }

    /* ── Type helpers ─────────────────────────────────────── */
    .data-sm    { font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem; line-height: 1rem; }
    .label-caps { font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; line-height: 1rem; }

    /* ══════════════════════════════════════════════════════
       LAYOUT — sidebar + main
    ══════════════════════════════════════════════════════ */
    #layout {
      position: fixed;
      top: 48px; left: 0; right: 0; bottom: 0;
      display: flex;
    }

    /* Logout sits at bottom */
    .sidebar-spacer { flex: 1; }

    /* ══════════════════════════════════════════════════════
       MAIN AREA
    ══════════════════════════════════════════════════════ */
    #main-area {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      min-width: 0;
    }

    /* ── Page header ──────────────────────────────────────── */
    #page-header {
      padding: 18px 24px 16px;
      border-bottom: 1px solid #262626;
      flex-shrink: 0;
    }

    .breadcrumb-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 8px;
    }
    .breadcrumb-row .bc-vault {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #cc0000;
    }
    .breadcrumb-row .bc-sep {
      color: #262626;
      font-size: 0.75rem;
    }
    .breadcrumb-row .bc-status {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #a1a1a1;
    }

    .page-title {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 2rem;
      color: #ffb4a8;
      line-height: 1;
      margin: 0 0 10px;
    }
    .page-desc {
      font-family: 'Karla', sans-serif;
      font-size: 0.875rem;
      color: #a1a1a1;
      line-height: 1.5;
      max-width: 640px;
      margin: 0;
    }

    /* ── Scrollable content ───────────────────────────────── */
    #content-scroll {
      flex: 1;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      min-height: 0;
    }
    #content-scroll::-webkit-scrollbar { width: 3px; }
    #content-scroll::-webkit-scrollbar-track { background: #131313; }
    #content-scroll::-webkit-scrollbar-thumb { background: #262626; }

    /* ── Strikethrough on rejected titles ────────────────── */
    .card-title {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 600;
      font-size: 0.8rem;
      color: #e5e2e1;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      margin: 0 0 8px;
      line-height: 1.2;
      position: relative;
      display: inline-block;
    }
    .card-title::after {
      content: '';
      position: absolute;
      left: 0;
      top: 50%;
      width: 100%;
      height: 1px;
      background-color: #cc0000;
    }

    /* ── Utilitarian grid background on content area ──────── */
    #content-scroll {
      flex: 1;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      min-height: 0;
      background-image:
        linear-gradient(to right, #1a1a1a 1px, transparent 1px),
        linear-gradient(to bottom, #1a1a1a 1px, transparent 1px);
      background-size: 20px 20px;
    }
    #card-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1px;
      padding: 20px 24px;
      background: #262626; /* gap color from bg bleed */
    }
    .grid-loading {
      grid-column: 1 / -1; padding: 60px 0; text-align:center;
      font-family:'JetBrains Mono',monospace; font-size:0.65rem;
      letter-spacing:0.1em; color:#a1a1a1;
      animation: gv-pulse 2s ease-in-out infinite;
    }
    @keyframes gv-pulse { 0%,100% { opacity:1; } 50% { opacity:0.4; } }

    /* Individual rejection card */
    .rejection-card {
      background: #0e0e0e;
      border: 1px solid #262626;
      padding: 12px 14px;
      display: flex;
      flex-direction: column;
      gap: 0;
      position: relative;
    }

    /* Top meta row */
    .card-meta-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 8px;
    }
    .card-id {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      color: #a1a1a1;
      letter-spacing: 0.04em;
    }
    .rejected-chip {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.55rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #cc0000;
      border: 1px solid #cc0000;
      padding: 2px 6px;
      background: transparent;
      line-height: 1;
    }

    /* Title */
    .card-title {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 600;
      font-size: 0.8rem;
      color: #e5e2e1;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      margin: 0 0 8px;
      line-height: 1.2;
    }

    /* Rejection reason row (critical cards only) */
    .card-reason-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 8px;
      padding-bottom: 8px;
      border-bottom: 1px solid #1e1e1e;
    }
    .card-reason-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.55rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #a1a1a1;
      flex-shrink: 0;
    }
    .card-reason-val {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.55rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #cc0000;
      text-align: right;
    }

    /* Divider above metadata */
    .card-divider {
      width: 100%;
      height: 1px;
      background: #262626;
      margin-bottom: 8px;
    }

    /* Metadata rows */
    .card-data-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 5px;
    }
    .card-data-row:last-child { margin-bottom: 0; }
    .card-data-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.55rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #a1a1a1;
    }
    .card-data-val {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      color: #e5e2e1;
      text-align: right;
    }
    .card-data-val.contributor { color: #a1a1a1; }

    /* ══════════════════════════════════════════════════════
       BOTTOM TERMINAL PANEL
    ══════════════════════════════════════════════════════ */
    #terminal-panel {
      flex-shrink: 0;
      background: #0e0e0e;
      border-top: 1px solid #262626;
      height: 160px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    #terminal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 6px 14px;
      border-bottom: 1px solid #262626;
      flex-shrink: 0;
      background: #131313;
    }

    .terminal-header-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .terminal-header-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #a1a1a1;
    }
    .live-feed-chip {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.55rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #cc0000;
      border: 1px solid #cc0000;
      padding: 1px 6px;
      background: transparent;
    }

    .terminal-header-right {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      color: #a1a1a1;
      letter-spacing: 0.06em;
    }

    #terminal-body {
      flex: 1;
      overflow-y: auto;
      padding: 6px 14px;
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    #terminal-body::-webkit-scrollbar { width: 3px; }
    #terminal-body::-webkit-scrollbar-track { background: #0e0e0e; }
    #terminal-body::-webkit-scrollbar-thumb { background: #262626; }

    .t-line {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      line-height: 1.65;
      color: #a1a1a1;
      white-space: nowrap;
      letter-spacing: 0.04em;
    }
    .t-ts    { color: #5e3f3a; }
    .t-key   { color: #a1a1a1; }
    .t-ok    { color: #a1a1a1; }
    .t-red   { color: #cc0000; font-weight: 700; }
    .t-entry { color: #e5e2e1; }
  </style>
</head>
<body>

  <!-- ════════════════════════════════════════════════════════
       TOP NAVBAR
  ═════════════════════════════════════════════════════════ -->
  <RepoNavbar repoSlug={repoSlug} />

  <!-- ════════════════════════════════════════════════════════
       LAYOUT
  ═════════════════════════════════════════════════════════ -->
  <div id="layout">

    <!-- ── LEFT SIDEBAR ─────────────────────────────────── -->
    <RepoSidebar id={id} active="rejections" />

    <!-- ── MAIN AREA ─────────────────────────────────────── -->
    <div id="main-area">

      <!-- Page header -->
      <header id="page-header">
        <div class="breadcrumb-row" aria-label="Page location">
          <span class="bc-vault">REJECTION_VAULT</span>
          <span class="bc-sep" aria-hidden="true">|</span>
          <span class="bc-status">STATUS: SECURE_CONTAINMENT</span>
        </div>
        <h1 class="page-title">INDEX OF FAILED PROPOSITIONS</h1>
        <p class="page-desc">
          The following entries have been analyzed, extracted, and subsequently terminated
          from active development history. No further modification is permitted.
          Historical record only.
        </p>
      </header>

      <!-- Scrollable content -->
      <div id="content-scroll">

        <!-- Rejection card grid -->
        <div id="card-grid" role="list" aria-label="Rejected propositions">

          {IS_UUID ? (
            <div class="grid-loading">SYNCING_REJECTION_VAULT…</div>
          ) : (
            rejections.map((r) => (
              <article class="rejection-card" role="listitem" aria-label={`Rejection: ${r.title}`}>

                <!-- Top meta row -->
                <div class="card-meta-row">
                  <span class="card-id" aria-label={`Entry ID: ${repoId}-${padIdx(r.index)}`}>
                    ID: {repoId}-{padIdx(r.index)}
                  </span>
                  <span class="rejected-chip" role="status" aria-label="Status: Rejected">REJECTED</span>
                </div>

                <!-- Title -->
                <h2 class="card-title">{r.title}</h2>

                <!-- Rejection reason (critical cards only) -->
                {r.reason && (
                  <div class="card-reason-row" aria-label={`Rejection reason: ${r.reason}`}>
                    <span class="card-reason-label">REJECTION_REASON:</span>
                    <span class="card-reason-val">{r.reason}</span>
                  </div>
                )}

                <!-- Divider -->
                <div class="card-divider" aria-hidden="true"></div>

                <!-- Metadata rows -->
                <div class="card-data-row" aria-label={`Contributor: @${r.contributor}`}>
                  <span class="card-data-label">CONTRIBUTOR:</span>
                  <span class="card-data-val contributor">@{r.contributor}</span>
                </div>

                <div class="card-data-row" aria-label={`Timestamp: ${r.timestamp}`}>
                  <span class="card-data-label">TIMESTAMP:</span>
                  <span class="card-data-val">{r.timestamp.replace('T', ' ').replace('Z', '')}</span>
                </div>

              </article>
            ))
          )}

        </div><!-- /card-grid -->

      </div><!-- /content-scroll -->

      <!-- Bottom terminal panel -->
      <footer id="terminal-panel" aria-label="Vault access logs">
        <div id="terminal-header">
          <div class="terminal-header-left">
            <span class="terminal-header-label">VAULT_ACCESS_LOGS</span>
            <span class="live-feed-chip" role="status">LIVE_FEED</span>
          </div>
          <div class="terminal-header-right">
            ENTRIES: <span id="entry-count">{IS_UUID ? '—' : rejections.length}</span>
            &nbsp;&nbsp;
            <!-- "MEMORY %" was a made-up gauge derived from the seed count.
                 Show the actual data source instead. -->
            SOURCE: <span class="t-ok">/api/repo/:id/rejections</span>
          </div>
        </div>

        <div id="terminal-body" role="log" aria-label="Vault access log entries" aria-live="polite">
          {IS_UUID ? (
            <div class="t-line"><span class="t-key">SYSTEM:</span> <span class="t-ok">Connecting to analysis service…</span></div>
          ) : (
            <Fragment>
              <div class="t-line"><span class="t-ts">[14:21:28]</span> <span class="t-key">DATABASE_CONNECT:</span> <span class="t-ok">SUCCESS</span></div>
              <div class="t-line"><span class="t-ts">[14:21:32]</span> <span class="t-key">SCAN_INTERVAL:</span> <span class="t-ok">0.082ms</span></div>
              <div class="t-line"><span class="t-ts">[14:21:48]</span> <span class="t-key">LOG_FLUSH:</span> <span class="t-ok">COMPLETED</span></div>
              <div class="t-line"><span class="t-ts">[14:21:55]</span> <span class="t-key">UNAUTHORIZED_ATTEMPT:</span> <span class="t-ok">@unknown_probe</span> (<span class="t-red">REFUSED</span>)</div>
              <div class="t-line"><span class="t-ts">[14:22:01]</span> <span class="t-key">REJECTION_ARCHIVE:</span> <span class="t-entry">ENTRY_{repoId}-001</span> (<span class="t-red">LOCKED</span>)</div>
            </Fragment>
          )}
        </div>
      </footer>

    </div><!-- /main-area -->
  </div><!-- /layout -->

  <!-- ════════════════════════════════════════════════════════
       SCRIPTS
  ═════════════════════════════════════════════════════════ -->
  <!-- Seed payload as JSON: define:vars forces the script inline, which stops
       Astro bundling it and makes the ES imports below throw. -->
  <script type="application/json" id="glyph-seed" set:html={JSON.stringify({ repoId, rejectionCount: rejections.length })}></script>

  <script>
    import { getJobId, apiBase, showEmptyState, appendErrorLine, startStatusFeed, apiFetch }
      from '../../../scripts/repo-view';

    const seedEl = document.getElementById('glyph-seed');
    const { repoId, rejectionCount } = JSON.parse(seedEl?.textContent || '{"repoId":"","rejectionCount":0}');
    const API_BASE = apiBase();

    // ── Card click → vault access log entry ───────────────
    (function initCardClicks() {
      const body = document.getElementById('terminal-body');
      if (!body) return;

      document.querySelectorAll('.rejection-card').forEach(card => {
        card.addEventListener('click', () => {
          const idEl = card.querySelector('.card-id');
          const entryId = idEl ? idEl.textContent?.replace('ID: ', '').trim() : 'UNKNOWN';
          const d = new Date();
          const ts = `[${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}:${String(d.getSeconds()).padStart(2,'0')}]`;
          const line = document.createElement('div');
          line.className = 't-line';
          line.innerHTML = `<span class="t-ts">${ts}</span> <span class="t-key">ARCHIVE_ACCESS:</span> <span class="t-entry">${entryId}</span> - <span class="t-red">PERMISSION_DENIED</span>`;
          body.appendChild(line);
          body.scrollTop = body.scrollHeight;
          while (body.children.length > 12) body.removeChild(body.firstChild!);
        });
      });
    })();

    // ── Fetch real rejections and hydrate card grid ────────
    (function hydrateRejections() {
      const jobId = getJobId();
      if (!jobId) return; // static seed data is fine for slug-based URLs

      apiFetch(`${API_BASE}/api/repo/${jobId}/rejections`)
        .then(r => r.ok ? r.json() : null)
        .then(data => {
          const grid = document.getElementById('card-grid');
          if (!data?.rejections?.length) {
            showEmptyState(grid, 'NO_REJECTIONS_SEALED',
              'This analysis sealed no rejection records for this repository.');
            return;
          }
          if (!grid) return;

          // Replace grid contents with real data
          grid.innerHTML = '';
          data.rejections.forEach((r: any, idx: number) => {
            const padIdx = String(idx + 1).padStart(3, '0');
            const cardId = `${repoId}-${padIdx}`;
            const title  = (r.title ?? 'UNKNOWN').toUpperCase().replace(/\s+/g, '_');
            const contrib = Array.isArray(r.contributors) ? r.contributors[0] ?? 'unknown' : 'unknown';
            const ts = r.timestamp ?? '';

            const reasonRow = r.reasoning
              ? `<div class="card-reason-row">
                   <span class="card-reason-label">REJECTION_REASON:</span>
                   <span class="card-reason-val">${r.reasoning.toUpperCase().split(' ').slice(0,3).join('_')}</span>
                 </div>`
              : '';

            const card = document.createElement('article');
            card.className = 'rejection-card';
            card.setAttribute('role', 'listitem');
            card.innerHTML = `
              <div class="card-meta-row">
                <span class="card-id">ID: ${cardId}</span>
                <span class="rejected-chip">REJECTED</span>
              </div>
              <h2 class="card-title">${title}</h2>
              ${reasonRow}
              <div class="card-divider"></div>
              <div class="card-data-row">
                <span class="card-data-label">CONTRIBUTOR:</span>
                <span class="card-data-val contributor">@${contrib}</span>
              </div>
              <div class="card-data-row">
                <span class="card-data-label">TIMESTAMP:</span>
                <span class="card-data-val">${ts.replace('T',' ').replace('Z','')}</span>
              </div>`;
            grid.appendChild(card);
          });

          // Update entry count
          const ec = document.getElementById('entry-count');
          if (ec) ec.textContent = String(data.total ?? data.rejections.length);
        })
        .catch(() => {
          const body = document.getElementById('terminal-body');
          // "showing static preview" was untrue — nothing was shown at all, and
          // the panel below stayed on its SYNCING placeholder for ever. Say
          // what happened and clear the placeholder.
          appendErrorLine(body, 'ANALYSIS SERVICE UNREACHABLE — no data loaded');
          showEmptyState(
            document.getElementById('card-grid'),
            'SERVICE_UNREACHABLE',
            'The analysis API did not respond. Check the backend is running, then reload.',
          );
        });
    })();

    // ── Live vault access log ─────────────────────────────
    (function initTerminal() {
      const body = document.getElementById('terminal-body');
      if (!body) return;

      // Real jobs stream the actual analysis stage; only demo URLs fabricate.
      // Wipe the server-rendered placeholder so no seed line survives.
      if (getJobId()) {
        body.innerHTML = '';
        startStatusFeed(body);
        return;
      }

      const probes: string[] = ['@unknown_probe', '@crawler_77', '@anon_agent', '@ext_scraper'];
      const locked: string[] = [];
      for (let i = 1; i <= rejectionCount; i++) {
        locked.push(`${repoId}-${String(i).padStart(3, '0')}`);
      }

      let lockIdx = 0, probeIdx = 0;

      function nowTs(): string {
        const d = new Date();
        const h = String(d.getHours()).padStart(2, '0');
        const m = String(d.getMinutes()).padStart(2, '0');
        const s = String(d.getSeconds()).padStart(2, '0');
        return `[${h}:${m}:${s}]`;
      }

      const events: (() => string)[] = [
        () => `<span class="t-ts">${nowTs()}</span> <span class="t-key">SCAN_INTERVAL:</span> <span class="t-ok">${(Math.random() * 0.2).toFixed(3)}ms</span>`,
        () => `<span class="t-ts">${nowTs()}</span> <span class="t-key">INTEGRITY_CHECK:</span> <span class="t-ok">PASS</span>`,
        () => `<span class="t-ts">${nowTs()}</span> <span class="t-key">UNAUTHORIZED_ATTEMPT:</span> <span class="t-ok">${probes[probeIdx++ % probes.length]}</span> (<span class="t-red">REFUSED</span>)`,
        () => `<span class="t-ts">${nowTs()}</span> <span class="t-key">REJECTION_ARCHIVE:</span> <span class="t-entry">ENTRY_${locked[lockIdx++ % locked.length]}</span> (<span class="t-red">LOCKED</span>)`,
        () => `<span class="t-ts">${nowTs()}</span> <span class="t-key">LOG_FLUSH:</span> <span class="t-ok">COMPLETED</span>`,
        () => `<span class="t-ts">${nowTs()}</span> <span class="t-key">VAULT_SEAL:</span> <span class="t-ok">INTACT</span>`,
        () => `<span class="t-ts">${nowTs()}</span> <span class="t-key">DB_HEARTBEAT:</span> <span class="t-ok">OK — ${Math.floor(Math.random()*10+4)}ms</span>`,
      ];

      let evIdx = 0;
      setInterval(() => {
        const line = document.createElement('div');
        line.className = 't-line';
        line.innerHTML = events[evIdx % events.length]();
        evIdx++;
        body.appendChild(line);
        body.scrollTop = body.scrollHeight;
        while (body.children.length > 30) body.removeChild(body.firstChild!);
      }, 2200);
    })();
  </script>

</body>
</html>
