---
// GLYPH OS — Chronological Decision Index
// src/pages/repo/[id]/decisions.astro
export const prerender = false;

const { id } = Astro.params;

// A UUID job id means this is a REAL analysis — seed data only renders for
// slug/demo URLs. Real jobs render an honest placeholder that the client
// hydrates from GET /api/repo/:id/decisions.
const IS_UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id ?? '');

let repoOwner = 'unknown';
let repoName  = 'unknown';
try {
  const decoded = decodeURIComponent(id ?? '');
  const match   = decoded.match(/github\.com\/([^\/]+)\/([^\/\s]+)/);
  if (match) {
    repoOwner = match[1];
    repoName  = match[2].replace(/\.git$/, '');
  } else {
    const parts = decoded.split('/').filter(Boolean);
    if (parts.length >= 2) { repoOwner = parts[0]; repoName = parts[1]; }
    else if (parts.length === 1) { repoName = parts[0]; }
  }
} catch (_) {}

// A single expression, not `{repoOwner}/{repoName}`: the Astro compiler
// swallows a `/{expr}` that follows another expression in the page title, so
// writing the two halves separately rendered "unknown" and dropped the
// repository name entirely.
const repoSlug = `${repoOwner}/${repoName}`;

// ── Static seed data (demo/slug URLs only) ────────────────
interface Decision {
  index:       number;
  title:       string;
  summary:     string;
  sha:         string;
  confidence:  number;
  contributor: string;
  timestamp:   string;
  status:      'STABLE' | 'CRITICAL' | 'RESOLVED';
}

const decisions: Decision[] = [
  { index:1,  title:'INIT_REPO_STRUCTURE',       summary:'Established core monorepo architecture leveraging workspace-level abstractions. Prioritizing modular hermeticity and build-time efficiency.',                                  sha:'7f3a9e2', confidence:98, contributor:'arch_priya',   timestamp:'2024-02-09T11:02Z', status:'STABLE'   },
  { index:2,  title:'ADOPT_AXUM_FRAMEWORK',       summary:'Migration from prototype Tower service to full Axum stack for ergonomic routing and type-safe state management. High throughput baseline achieved.',                           sha:'d92c1b0', confidence:92, contributor:'lead_author',  timestamp:'2024-02-21T16:30Z', status:'CRITICAL'  },
  { index:3,  title:'POSTGRESQL_OVER_SQLITE',     summary:'Relational data model mandates ACID guarantees at scale. SQLite ruled out after stress tests revealed lock contention at 500 concurrent analysis jobs.',                       sha:'33ab8f4', confidence:88, contributor:'dev_soren',    timestamp:'2024-03-04T09:17Z', status:'STABLE'   },
  { index:4,  title:'ASYNC_RUNTIME_TOKIO',        summary:'Tokio selected over async-std following benchmark suite showing 22% lower tail latency on GitHub API ingestion workloads with full feature set.',                              sha:'a1f042c', confidence:95, contributor:'arch_priya',   timestamp:'2024-03-14T14:55Z', status:'STABLE'   },
  { index:5,  title:'BYOK_CREDENTIAL_MODEL',      summary:'No server-side key storage. All GitHub PAT and NIM API keys travel as per-request headers, discarded after use. Eliminates entire secret-management attack surface.',          sha:'5c8b3d1', confidence:99, contributor:'sec_ananya',   timestamp:'2024-03-28T10:22Z', status:'STABLE'   },
  { index:6,  title:'NVIDIA_NIM_INTEGRATION',     summary:'Structured JSON prompting via llama-3.1-nemotron-70b. Temperature 0.1 for deterministic extraction. Markdown fence stripping required due to model output formatting.',       sha:'e74f901', confidence:81, contributor:'lead_author',  timestamp:'2024-04-08T13:40Z', status:'CRITICAL'  },
  { index:7,  title:'SHUTTLE_DEPLOYMENT_CHOICE',  summary:'Shuttle.rs selected for zero-config Rust deployment. Shared PostgreSQL provisioning removes infrastructure overhead. Trade-off: limited egress control accepted.',             sha:'2b6d5a7', confidence:76, contributor:'infra_tolly',  timestamp:'2024-04-19T08:11Z', status:'STABLE'   },
  { index:8,  title:'SQLX_OVER_DIESEL',           summary:'SQLx chosen for compile-time verified queries without ORM overhead. Diesel macro complexity deemed unsuitable for rapid schema iteration at current phase.',                   sha:'9f1c3e8', confidence:90, contributor:'dev_soren',    timestamp:'2024-05-02T15:33Z', status:'STABLE'   },
  { index:9,  title:'REQWEST_HTTP_CLIENT',        summary:'reqwest 0.12 with JSON feature selected for GitHub and NIM API calls. Connection pooling via Client::new() shared across AppState. Timeout set to 30s.',                      sha:'4a7b2f0', confidence:85, contributor:'arch_priya',   timestamp:'2024-05-17T11:09Z', status:'STABLE'   },
  { index:10, title:'PAGINATION_STRATEGY',        summary:'Hard cap at 10 pages × 100 items per ingestion call. Prevents runaway rate-limit exhaustion on large repos. Configurable per-repo override planned for v2.',                  sha:'c3d9e61', confidence:78, contributor:'lead_author',  timestamp:'2024-06-01T09:44Z', status:'RESOLVED' },
  { index:11, title:'ERROR_HANDLING_PATTERN',     summary:'Unified AppError enum implementing IntoResponse for Axum. All variant arms map to deterministic HTTP status codes. No panic paths in production handlers.',                   sha:'7e4a8b3', confidence:94, contributor:'dev_soren',    timestamp:'2024-06-18T14:27Z', status:'STABLE'   },
  { index:12, title:'CORS_MIDDLEWARE_ADDED',      summary:'tower-http CorsLayer configured to allow Vercel and localhost:4321 origins. All methods permitted. Headers: Any. Deployed before frontend integration phase.',               sha:'1d5f7c9', confidence:88, contributor:'infra_tolly',  timestamp:'2024-07-04T10:15Z', status:'STABLE'   },
];

const stats = {
  total:        decisions.length,
  avgConf:      Math.round(decisions.reduce((a, d) => a + d.confidence, 0) / decisions.length),
  contributors: [...new Set(decisions.map(d => d.contributor))].length,
  timeSpanDays: 214,
};

const confBuckets = [
  { label: 'HIGH (90%+)',    pct: Math.round(decisions.filter(d => d.confidence >= 90).length / decisions.length * 100) },
  { label: 'MED (70–89%)',   pct: Math.round(decisions.filter(d => d.confidence >= 70 && d.confidence < 90).length / decisions.length * 100) },
  { label: 'LOW (50–69%)',   pct: Math.round(decisions.filter(d => d.confidence >= 50 && d.confidence < 70).length / decisions.length * 100) },
  { label: 'MINIMAL (<50%)', pct: Math.round(decisions.filter(d => d.confidence < 50).length / decisions.length * 100) },
];

const topMakers = Object.entries(
  decisions.reduce((acc, d) => {
    acc[d.contributor] = (acc[d.contributor] ?? 0) + 1;
    return acc;
  }, {} as Record<string, number>)
)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 3)
  .map(([handle, count]) => ({ handle, count, pct: Math.round(count / decisions.length * 100) }));

// Real (UUID) jobs must never render seed-derived numbers. Every stat below
// is served as an em-dash placeholder and hydrated from
// GET /api/repo/:id/decisions by the client. Only slug/demo URLs see seeds.
const seedStats      = IS_UUID ? null : stats;
const seedBuckets    = IS_UUID ? []   : confBuckets;
const seedTopMakers  = IS_UUID ? []   : topMakers;
const BUCKET_LABELS  = confBuckets.map(b => b.label);

const statusColor = (s: Decision['status']) =>
  s === 'CRITICAL' ? '#cc0000' : s === 'RESOLVED' ? '#5e3f3a' : '#a1a1a1';
import RepoNavbar from '../../../components/RepoNavbar.astro';
import RepoSidebar from '../../../components/RepoSidebar.astro';

---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GLYPH — Decision Index — {repoSlug}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="glyph-repo-slug" content={repoSlug} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <!-- is:global is required, not cosmetic. Astro scopes page CSS with a
       [data-astro-cid-*] attribute that only server-rendered markup carries.
       Every element these pages build in JS (live-feed lines, hydrated
       decision/contributor cards, D3 nodes) is created with innerHTML or
       document.createElement and therefore has no scope attribute — under
       scoped CSS it renders completely unstyled. This page's stylesheet is
       self-contained and loaded by this page alone, so going global is safe. -->
  <style is:global>
    /* ── Reset ───────────────────────────────────────────── */
    *, *::before, *::after {
      box-sizing: border-box;
    }
    /* interactive elements animate on the shared easing */
    a, button, [role="button"], input, select, textarea {
      transition: border-color 120ms cubic-bezier(0.2,0.6,0.2,1),
                  color 120ms cubic-bezier(0.2,0.6,0.2,1),
                  background-color 120ms cubic-bezier(0.2,0.6,0.2,1);
    }
    ::selection { background: #ffb4a8; color: #131313; }
    :focus-visible { outline: 1px solid #ffb4a8; outline-offset: 2px; }
    html, body {
      margin: 0; padding: 0;
      background: #131313;
      color: #e5e2e1;
      font-family: 'Karla', sans-serif;
      height: 100%;
      overflow: hidden;
    }

    /* ── Type helpers ─────────────────────────────────────── */
    .mono      { font-family: 'JetBrains Mono', monospace; }
    .display   { font-family: 'Space Grotesk', sans-serif; }
    .data-sm   { font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem; line-height: 1.2; }
    .label-caps{ font-family: 'JetBrains Mono', monospace; font-size: 0.625rem; letter-spacing: 0.1em; text-transform: uppercase; line-height: 1; }

    /* ══════════════════════════════════════════════════════
       LAYOUT
    ══════════════════════════════════════════════════════ */
    #layout {
      position: fixed; top: 48px; left: 0; right: 0; bottom: 0;
      display: flex;
    }
    .sidebar-spacer { flex: 1; }
    .util-row { display: flex; gap: 6px; }

    /* ══════════════════════════════════════════════════════
       MAIN AREA
    ══════════════════════════════════════════════════════ */
    #main-area {
      flex: 1; display: flex; flex-direction: column;
      overflow: hidden; min-width: 0;
    }

    /* ── Page header ──────────────────────────────────────── */
    #page-header {
      padding: 16px 20px 14px; border-bottom: 1px solid #262626; flex-shrink: 0;
    }
    .breadcrumb-row {
      display: flex; align-items: center; gap: 8px; margin-bottom: 6px;
    }
    .bc-label { font-family:'JetBrains Mono',monospace; font-size:0.6rem; letter-spacing:0.12em; text-transform:uppercase; color:#cc0000; }
    .bc-sep   { color: #3a3a3a; }
    .bc-status{ font-family:'JetBrains Mono',monospace; font-size:0.6rem; letter-spacing:0.12em; text-transform:uppercase; color:#a1a1a1; }
    .page-title {
      font-family: 'Space Grotesk', sans-serif; font-weight: 700;
      font-size: 1.9rem; color: #ffb4a8; line-height: 1; margin: 0 0 8px;
      letter-spacing: -0.01em;
    }
    .page-desc { font-family:'Karla',sans-serif; font-size:0.875rem; color:#a1a1a1; line-height:1.5; margin:0; max-width:680px; }

    /* ── Content body ─────────────────────────────────────── */
    #content-body {
      flex: 1; display: grid;
      grid-template-columns: 1fr 260px;
      grid-template-rows: 1fr 140px;
      overflow: hidden; min-height: 0;
    }

    /* ══════════════════════════════════════════════════════
       TIMELINE COLUMN — scrollable
    ══════════════════════════════════════════════════════ */
    #timeline-col {
      grid-column: 1; grid-row: 1;
      border-right: 1px solid #262626;
      display: flex; flex-direction: column;
      overflow: hidden; min-height: 0;
    }

    /* D3 chronological timeline strip (fixed height on top) */
    /* Chart strip: the chronology scatter and the per-month density grid sit
       side by side. The scatter alone was ~1000px wide for a couple of dozen
       points; splitting the strip gives both marks a sensible density without
       spending any extra vertical space, which the decision list needs. */
    #chart-strip {
      flex-shrink: 0;
      display: flex;
      align-items: stretch;
      height: 214px;
      border-bottom: 1px solid #262626;
    }

    #d3-panel {
      flex: 1 1 auto;
      min-width: 0;
      border-right: 1px solid #262626;
      padding: 12px 16px 6px;
      position: relative;
    }

    /* ── Per-month decision density ───────────────────────── */
    /* Sized to the grid itself (24px gutter + 12 x 16px cells + gaps = 252px)
       plus padding, so no width is parked as dead space beside it — the
       scatter takes the remainder. */
    #month-panel {
      flex: 0 0 auto;
      width: 300px;
      padding: 12px 16px 8px;
      display: flex;
      flex-direction: column;
      min-width: 0;
      position: relative;
    }

    #month-title {
      font-family:'JetBrains Mono',monospace; font-size:0.55rem;
      letter-spacing:0.08em; text-transform:uppercase; color:#cc0000;
      margin-bottom: 8px;
      display: flex; align-items: baseline; justify-content: space-between; gap: 8px;
      white-space: nowrap;
    }
    /* Totals wear a text token, not a ramp colour — ramp ink is data ink. */
    #month-total { color:#5e3f3a; letter-spacing:0.08em; flex-shrink:0; }

    /* Centred so a repository spanning one year does not leave its single row
       stranded at the top of the panel. */
    #month-grid-wrap {
      flex: 1; min-height: 0; overflow: hidden;
      display: flex; flex-direction: column; justify-content: center;
    }

    /* Column headings: month initials, deliberately recessive. */
    /* Fixed 16px cells rather than 1fr: the row count varies with the history
       length, and fluid cells made a six-year repository overflow the strip
       and silently lose its most recent year off the bottom. */
    .mg-months {
      display: grid;
      grid-template-columns: 24px repeat(12, 18px);
      gap: 2px;
      margin-bottom: 2px;
    }
    .mg-month-label {
      font-family:'JetBrains Mono',monospace; font-size:0.5rem;
      color:#5e3f3a; text-align:center; letter-spacing:0.04em;
      user-select: none;
    }

    .mg-row {
      display: grid;
      grid-template-columns: 24px repeat(12, 18px);
      gap: 2px;
      margin-bottom: 2px;
    }
    .mg-year-label {
      font-family:'JetBrains Mono',monospace; font-size:0.5rem;
      color:#a1a1a1; letter-spacing:0.04em;
      display: flex; align-items: center;
      user-select: none;
    }

    /* 18px, not the ~11px a contributions graph uses: these are pointer and
       keyboard targets. A tiled grid has no dead space to expand a hit area
       into — the pointer always lands on some cell — so the target is the cell
       itself, and it is sized generously rather than to convention. */
    .mg-cell {
      width: 18px; height: 18px;
      background: #1c1c1c;              /* zero: recedes toward the surface */
      border: 1px solid transparent;
      padding: 0;
      cursor: default;
      /* The cell is the hit target; it lifts on hover and on keyboard focus. */
      transition: outline-color 90ms cubic-bezier(0.2,0.6,0.2,1);
      outline: 1px solid transparent;
      outline-offset: 0;
    }
    .mg-cell[data-level="0"] { cursor: default; }
    .mg-cell:not([data-level="0"]) { cursor: pointer; }
    .mg-cell:hover,
    .mg-cell:focus-visible {
      outline-color: #e5e2e1;
    }
    /* Months outside the analysed range read as absent, not as zero. */
    .mg-cell.mg-void { background: transparent; border-color: #1c1c1c; }

    /* Legend — the sequential ramp, GitHub's LESS→MORE convention. */
    #month-legend {
      display: flex; align-items: center; gap: 6px;
      margin-top: 8px;
      font-family:'JetBrains Mono',monospace; font-size:0.5rem;
      letter-spacing:0.1em; text-transform:uppercase; color:#5e3f3a;
    }
    #month-legend .lg-swatch {
      width: 9px; height: 9px; flex-shrink: 0;
      border: 1px solid transparent;
    }
    #month-legend .lg-spacer { flex: 1; }

    #month-empty {
      flex: 1; display: flex; align-items: center; justify-content: center;
      font-family:'JetBrains Mono',monospace; font-size:0.6rem;
      letter-spacing:0.08em; color:#5e3f3a; text-align: center;
    }

    /* Shared tooltip for the grid cells. */
    #mg-tip {
      position: absolute;
      pointer-events: none;
      z-index: 40;
      display: none;
      background: #0e0e0e;
      border: 1px solid #262626;
      padding: 5px 8px;
      font-family:'JetBrains Mono',monospace;
      font-size: 0.55rem;
      letter-spacing: 0.06em;
      white-space: nowrap;
      color: #a1a1a1;
    }
    /* Value leads, label follows. */
    #mg-tip .tip-value { color:#e5e2e1; font-weight:700; }
    #d3-title {
      font-family:'JetBrains Mono',monospace; font-size:0.55rem;
      letter-spacing:0.12em; text-transform:uppercase; color:#cc0000;
      margin-bottom: 4px;
    }
    #d3-chart { width: 100%; height: calc(100% - 18px); position: relative; }
    .tl-chart-empty {
      font-family:'JetBrains Mono',monospace; font-size:0.65rem;
      letter-spacing:0.1em; color:#5e3f3a; text-align:center;
      padding-top: 60px;
    }

    /* Scrollable decision list below the chart */
    #timeline-scroll {
      flex: 1; overflow-y: auto; position: relative;
      padding: 20px 24px 20px 20px; min-height: 0;
    }
    #timeline-scroll::-webkit-scrollbar { width: 4px; }
    #timeline-scroll::-webkit-scrollbar-track { background: #0e0e0e; }
    #timeline-scroll::-webkit-scrollbar-thumb { background: #cc0000; }
    #timeline-scroll::-webkit-scrollbar-thumb:hover { background: #ff0000; }

    /* Vertical timeline spine */
    .timeline-spine {
      position: absolute; left: 36px; top: 20px; bottom: 20px;
      width: 1px; background: #cc0000;
    }

    .timeline-item {
      position: relative; display: flex; align-items: flex-start;
      gap: 16px; margin-bottom: 28px;
    }
    .timeline-item:last-child { margin-bottom: 0; }

    .timeline-loading {
      position: relative; margin-left: 52px; padding: 28px 0;
      font-family:'JetBrains Mono',monospace; font-size:0.65rem;
      letter-spacing:0.1em; color:#a1a1a1;
      animation: tl-pulse 2s ease-in-out infinite;
    }
    @keyframes tl-pulse { 0%,100% { opacity:1; } 50% { opacity:0.4; } }

    /* Square dot on the spine */
    .tl-dot {
      width: 8px; height: 8px; background: #cc0000;
      flex-shrink: 0; margin-top: 14px; position: relative; z-index: 1;
    }

    /* Decision card */
    .decision-card {
      flex: 1; background: #0e0e0e; border: 1px solid #262626;
      padding: 0; overflow: hidden;
      cursor: pointer;
    }
    .decision-card:hover { border-color: rgba(204, 0, 0, 0.5); }

    .dc-top {
      display: flex; align-items: center; justify-content: space-between;
      padding: 8px 12px 6px;
    }
    .dc-id-ts {
      display: flex; align-items: center; gap: 10px;
    }
    .dc-id {
      font-family:'JetBrains Mono',monospace; font-size:0.55rem;
      letter-spacing:0.1em; text-transform:uppercase; color:#cc0000;
    }
    .dc-ts {
      font-family:'JetBrains Mono',monospace; font-size:0.55rem;
      color:#5e3f3a; letter-spacing:0.04em;
    }
    .dc-status-chip {
      font-family:'JetBrains Mono',monospace; font-size:0.5rem;
      letter-spacing:0.1em; text-transform:uppercase;
      border: 1px solid; padding: 2px 6px; line-height: 1;
      background: transparent;
    }

    .dc-title {
      font-family:'Space Grotesk',sans-serif; font-weight:600;
      font-size:0.9rem; color:#e5e2e1; text-transform:uppercase;
      letter-spacing:0.01em; padding: 0 12px 6px; line-height: 1.2; margin: 0;
    }

    /* LLM-written summaries run considerably longer than the seed copy this
       was sized for, and the clamp alone let a third line bleed past the card
       edge. An explicit max-height matching the clamp guarantees a clean cut. */
    .dc-summary {
      font-family:'Karla',sans-serif; font-size:0.8125rem; color:#a1a1a1;
      line-height:1.45; padding: 0 12px 10px;
      display: -webkit-box; -webkit-line-clamp: 3;
      -webkit-box-orient: vertical; overflow: hidden;
      max-height: calc(1.45em * 3 + 10px);
    }

    .dc-footer {
      display: flex; align-items: center; justify-content: space-between;
      padding: 7px 12px; border-top: 1px solid #262626;
    }
    .dc-footer-left { display: flex; align-items: center; gap: 12px; }
    .dc-commit-label { font-family:'JetBrains Mono',monospace; font-size:0.55rem; letter-spacing:0.1em; text-transform:uppercase; color:#a1a1a1; }
    .dc-commit-val   { font-family:'JetBrains Mono',monospace; font-size:0.6rem; color:#cc0000; }
    .dc-conf-label   { font-family:'JetBrains Mono',monospace; font-size:0.55rem; letter-spacing:0.1em; text-transform:uppercase; color:#a1a1a1; }
    .dc-conf-val     { font-family:'JetBrains Mono',monospace; font-size:0.6rem; color:#e5e2e1; }
    .dc-contributor  { font-family:'JetBrains Mono',monospace; font-size:0.6rem; color:#5e3f3a; }

    /* ══════════════════════════════════════════════════════
       INTELLIGENCE SIDEBAR — right col
    ══════════════════════════════════════════════════════ */
    #intel-sidebar {
      grid-column: 2; grid-row: 1;
      border-bottom: 1px solid #262626;
      background: #131313; overflow-y: auto;
      display: flex; flex-direction: column;
    }
    #intel-sidebar::-webkit-scrollbar { width: 4px; }
    #intel-sidebar::-webkit-scrollbar-track { background: #0e0e0e; }
    #intel-sidebar::-webkit-scrollbar-thumb { background: #cc0000; }
    #intel-sidebar::-webkit-scrollbar-thumb:hover { background: #ff0000; }

    .intel-section {
      padding: 12px 14px; border-bottom: 1px solid #262626;
    }
    .intel-section:last-child { border-bottom: none; }
    .intel-section-label {
      font-family:'JetBrains Mono',monospace; font-size:0.6rem;
      letter-spacing:0.12em; text-transform:uppercase; color:#cc0000;
      display:block; margin-bottom:10px;
    }

    /* Stats grid — 2×2 */
    .stats-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 12px 8px;
    }
    .stat-cell {}
    .stat-cell-label {
      font-family:'JetBrains Mono',monospace; font-size:0.55rem;
      letter-spacing:0.1em; text-transform:uppercase; color:#a1a1a1;
      display:block; margin-bottom:3px;
    }
    .stat-cell-value {
      font-family:'JetBrains Mono',monospace; font-weight:700;
      font-size:1.3rem; color:#e5e2e1; line-height:1;
    }
    .stat-cell-value.accent { color: #e5e2e1; }

    /* Confidence distribution bars */
    .conf-bar-row {
      display: flex; align-items: center; gap: 8px;
      margin-bottom: 7px;
    }
    .conf-bar-row:last-child { margin-bottom: 0; }
    .conf-bar-label {
      font-family:'JetBrains Mono',monospace; font-size:0.55rem;
      letter-spacing:0.06em; text-transform:uppercase; color:#a1a1a1;
      width: 86px; flex-shrink: 0;
    }
    .conf-bar-track {
      flex: 1; height: 3px; background: #1a1a1a; position: relative;
    }
    .conf-bar-fill { height: 3px; background: #cc0000; }
    .conf-unrated-note {
      display: block;
      margin-top: 0.4rem;
      font-size: 0.55rem;
      letter-spacing: 0.05em;
      color: #5e3f3a;
    }

    .conf-bar-pct {
      font-family:'JetBrains Mono',monospace; font-size:0.55rem;
      color:#cc0000; width: 28px; text-align:right; flex-shrink:0;
    }

    /* Top makers */
    .maker-row { margin-bottom: 9px; }
    .maker-row:last-child { margin-bottom: 0; }
    .maker-header {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 4px;
    }
    .maker-handle {
      font-family:'JetBrains Mono',monospace; font-weight:600;
      font-size:0.65rem; color:#e5e2e1;
    }
    .maker-count {
      font-family:'JetBrains Mono',monospace; font-size:0.6rem; color:#a1a1a1;
    }
    .maker-bar-track { width:100%; height:1px; background:#262626; position:relative; }
    .maker-bar-fill  { height:1px; background:#cc0000; }

    /* ══════════════════════════════════════════════════════
       BOTTOM STREAM PANEL
    ══════════════════════════════════════════════════════ */
    #stream-panel {
      grid-column: 1 / 3; grid-row: 2;
      background: #0e0e0e; border-top: 1px solid #262626;
      display: flex; flex-direction: column; overflow: hidden;
    }
    #stream-header {
      padding: 6px 14px; border-bottom: 1px solid #262626;
      background: #131313; flex-shrink: 0;
      display: flex; align-items: center; justify-content: space-between;
    }
    .stream-header-left {
      display: flex; align-items: center; gap: 8px;
      font-family:'JetBrains Mono',monospace; font-size:0.6rem;
      letter-spacing:0.1em; text-transform:uppercase; color:#e5e2e1;
    }
    .stream-live-sq { width:7px; height:7px; background:#cc0000; flex-shrink:0; }
    .stream-sep { color:#5e3f3a; margin: 0 2px; }
    .stream-header-right {
      font-family:'JetBrains Mono',monospace; font-size:0.6rem;
      letter-spacing:0.06em; color:#a1a1a1;
    }
    #stream-body {
      flex: 1; overflow-y: auto; padding: 6px 14px;
      display: flex; flex-direction: column; gap: 0;
    }
    #stream-body::-webkit-scrollbar { width: 4px; }
    #stream-body::-webkit-scrollbar-track { background: #0e0e0e; }
    #stream-body::-webkit-scrollbar-thumb { background: #cc0000; }
    #stream-body::-webkit-scrollbar-thumb:hover { background: #ff0000; }
    .s-line {
      font-family:'JetBrains Mono',monospace; font-size:0.6rem;
      line-height:1.6; white-space:nowrap; color:#a1a1a1; letter-spacing:0.04em;
    }
    .s-ts      { color: #5e3f3a; }
    .s-tag     { color: #a1a1a1; }
    .s-tag-sys { color: #cc0000; font-weight: 700; }
    .s-em      { color: #e5e2e1; }
    .s-red     { color: #cc0000; }
    .s-pulse   { animation: pulse-opacity 2s ease-in-out infinite; }
    @keyframes pulse-opacity {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0.4; }
    }
  </style>
</head>
<body>

  <!-- ════════════════════════════════════════════════════════
       NAVBAR
  ═════════════════════════════════════════════════════════ -->
  <RepoNavbar repoSlug={repoSlug} />

  <!-- ════════════════════════════════════════════════════════
       LAYOUT
  ═════════════════════════════════════════════════════════ -->
  <div id="layout">

    <!-- ── SIDEBAR ───────────────────────────────────────── -->
    <RepoSidebar id={id} active="decisions" />

    <!-- ── MAIN AREA ──────────────────────────────────────── -->
    <div id="main-area">

      <!-- Page header -->
      <header id="page-header">
        <div class="breadcrumb-row">
          <span class="bc-label">DECISION_LEDGER</span>
          <span class="bc-sep">/</span>
          <span class="bc-status">STATUS: INDEXED</span>
        </div>
        <h1 class="page-title">CHRONOLOGICAL DECISION INDEX</h1>
        <p class="page-desc">
          Architectural lineage extracted from high-fidelity commit history and neural-link developer logs.
          Validating system evolution through structural shifts and dependency resolutions.
        </p>
      </header>

      <!-- Content -->
      <div id="content-body">

        <!-- ── TIMELINE ──────────────────────────────────── -->
        <section id="timeline-col" aria-label="Decision timeline">
          <!-- Chronology scatter + per-month density grid -->
          <div id="chart-strip">
            <div id="d3-panel">
              <div id="d3-title">CHRONOLOGICAL_DECISION_TIMELINE — TIME × CONFIDENCE</div>
              <div id="d3-chart" aria-label="Decision chronology scatter chart"></div>
            </div>

            <div id="month-panel">
              <div id="month-title">
                <span>DECISION_DENSITY — PER_MONTH</span>
                <span id="month-total">—</span>
              </div>
              <!-- Built by renderMonthGrid(); every count it shows is also in
                   the decision list below, so the grid enhances and never gates. -->
              <div id="month-grid-wrap" role="img" aria-label="Decision density per month">
                <div id="month-empty">AWAITING_ANALYSIS_DATA</div>
              </div>
              <div id="month-legend" aria-hidden="true">
                <span>Less</span>
                <span class="lg-swatch" style="background:#1c1c1c;"></span>
                <span class="lg-swatch" style="background:#6a4741;"></span>
                <span class="lg-swatch" style="background:#cc0000;"></span>
                <span class="lg-swatch" style="background:#f4735c;"></span>
                <span class="lg-swatch" style="background:#ffb4a8;"></span>
                <span>More</span>
                <span class="lg-spacer"></span>
              </div>
              <div id="mg-tip" role="status" aria-live="polite"></div>
            </div>
          </div>

          <!-- Scrollable decision list -->
          <div id="timeline-scroll">
          <!-- Vertical spine -->
          <div class="timeline-spine" aria-hidden="true"></div>

          <div id="timeline-list" role="list" aria-label="Architectural decisions">
            {IS_UUID ? (
              <div class="timeline-loading">SYNCING_DECISION_LEDGER…</div>
            ) : (
              decisions.map((d) => (
                <div class="timeline-item" role="listitem" aria-label={`Decision: ${d.title}`}>
                  <div class="tl-dot" aria-hidden="true"></div>
                  <div class="decision-card">
                    <div class="dc-top">
                      <div class="dc-id-ts">
                        <span class="dc-id">DECISION_{String(d.index).padStart(2,'0')} // {d.timestamp.replace('T',' ').replace('Z','')}</span>
                      </div>
                      <span
                        class="dc-status-chip"
                        style={`color:${statusColor(d.status)};border-color:${statusColor(d.status)};`}
                      >{d.status}</span>
                    </div>
                    <h2 class="dc-title">{d.title}</h2>
                    <p class="dc-summary">{d.summary}</p>
                    <div class="dc-footer">
                      <div class="dc-footer-left">
                        <span class="dc-commit-label">COMMIT:</span>
                        <span class="dc-commit-val">{d.sha}</span>
                        <span class="dc-conf-label">CONFIDENCE:</span>
                        <span class="dc-conf-val">{d.confidence}%</span>
                      </div>
                      <span class="dc-contributor">@{d.contributor}</span>
                    </div>
                  </div>
                </div>
              ))
            )}
          </div><!-- /timeline-list -->
          </div><!-- /timeline-scroll -->
        </section>

        <!-- ── INTELLIGENCE SIDEBAR ──────────────────────── -->
        <aside id="intel-sidebar" aria-label="Decision intelligence">

          <!-- Stats -->
          <div class="intel-section">
            <span class="intel-section-label">DECISION_STATS</span>
            <div class="stats-grid">
              <div class="stat-cell">
                <span class="stat-cell-label">TOTAL</span>
                <span class="stat-cell-value" id="stat-total">{seedStats ? seedStats.total : '—'}</span>
              </div>
              <div class="stat-cell">
                <span class="stat-cell-label">AVG CONFIDENCE</span>
                <span class="stat-cell-value" id="stat-conf">{seedStats ? `${seedStats.avgConf}%` : '—'}</span>
              </div>
              <div class="stat-cell">
                <span class="stat-cell-label">CONTRIBUTORS</span>
                <span class="stat-cell-value" id="stat-contribs">{seedStats ? seedStats.contributors : '—'}</span>
              </div>
              <div class="stat-cell">
                <span class="stat-cell-label">TIME SPAN</span>
                <span class="stat-cell-value" id="stat-span" style="font-size:1rem;">{seedStats ? `${seedStats.timeSpanDays} days` : '—'}</span>
              </div>
            </div>
          </div>

          <!-- Confidence distribution -->
          <div class="intel-section">
            <span class="intel-section-label">CONFIDENCE_DISTRIBUTION</span>
            <div id="conf-dist">
              {(seedBuckets.length ? seedBuckets : BUCKET_LABELS.map(label => ({ label, pct: null }))).map((b) => (
                <div class="conf-bar-row" data-bucket={b.label}>
                  <span class="conf-bar-label">{b.label}</span>
                  <div class="conf-bar-track" aria-hidden="true">
                    <div class="conf-bar-fill" style={`width:${b.pct ?? 0}%`}></div>
                  </div>
                  <span class="conf-bar-pct">{b.pct === null ? '—' : `${b.pct}%`}</span>
                </div>
              ))}
            </div>
            <span class="conf-unrated-note" id="conf-unrated-note"></span>
          </div>

          <!-- Top decision makers -->
          <div class="intel-section">
            <span class="intel-section-label">TOP_DECISION_MAKERS</span>
            <div id="top-makers">
              {seedTopMakers.length ? seedTopMakers.map((m) => (
                <div class="maker-row">
                  <div class="maker-header">
                    <span class="maker-handle">@{m.handle}</span>
                    <span class="maker-count">{m.count} decisions</span>
                  </div>
                  <div class="maker-bar-track" aria-hidden="true">
                    <div class="maker-bar-fill" style={`width:${m.pct}%`}></div>
                  </div>
                </div>
              )) : (
                <div class="maker-row"><span class="maker-count">AWAITING_ANALYSIS_DATA</span></div>
              )}
            </div>
          </div>

        </aside>

        <!-- ── BOTTOM STREAM ─────────────────────────────── -->
        <section id="stream-panel" aria-labelledby="stream-title">
          <div id="stream-header">
            <div class="stream-header-left" id="stream-title">
              <span class="stream-live-sq" aria-hidden="true"></span>
              DECISION_STREAM
              <span class="stream-sep">//</span>
              INDEXED
            </div>
            <span class="stream-header-right">TOTAL: <span id="stream-total">{IS_UUID ? '—' : decisions.length}</span></span>
          </div>
          <div id="stream-body" role="log" aria-label="Decision stream" aria-live="polite">
            {IS_UUID ? (
              <div class="s-line"><span class="s-tag-sys">[SYSTEM]</span><span class="s-tag"> Connecting to analysis service…</span></div>
            ) : (
              <Fragment>
                <div class="s-line"><span class="s-tag-sys">[SYSTEM]</span><span class="s-tag"> BOOT_SEQUENCE: INITIALIZING DECISION_ENGINE_V4...</span></div>
                <div class="s-line"><span class="s-tag">[AUTH]</span><span class="s-tag"> SESSION_TOKEN: VALIDATED for USER_OPERATOR</span></div>
                <div class="s-line"><span class="s-tag">[FETCH]</span><span class="s-tag"> INDEXING REMOTE_LEDGER: decisions endpoint</span></div>
                <div class="s-line"><span class="s-tag">[INDEX]</span><span class="s-em"> SUCCESS: {decisions.length} ENTRIES PARSED FROM COMMIT_LOG</span></div>
                {decisions.slice(0, 4).map((d) => (
                  <div class="s-line">
                    <span class="s-tag">[LOG]</span>
                    <span class="s-tag"> PARSING </span>
                    <span class="s-em">DECISION_{String(d.index).padStart(2,'0')}: {d.title}</span>
                    <span class="s-tag"> ({d.sha})</span>
                  </div>
                ))}
                <div class="s-line s-pulse"><span class="s-tag">[LISTENING]</span><span class="s-tag"> AWAITING REAL-TIME ARCHITECTURAL EVENTS...</span></div>
              </Fragment>
            )}
          </div>
        </section>

      </div><!-- /content-body -->
    </div><!-- /main-area -->
  </div><!-- /layout -->

  <!-- ════════════════════════════════════════════════════════
       SCRIPTS
  ═════════════════════════════════════════════════════════ -->
  <!-- Seed payload for the demo (slug) view. Passed as JSON rather than via
       define:vars: define:vars forces the script inline, which stops Astro
       bundling it — the ES imports below then throw
       "Cannot use import statement outside a module" and kill all hydration. -->
  <script type="application/json" id="glyph-seed" set:html={JSON.stringify({ seedDecisions: decisions })}></script>

  <script>
    import { getJobId, apiBase, showEmptyState, appendErrorLine, startStatusFeed, apiFetch, shortRef }
      from '../../../scripts/repo-view';
    import * as d3 from 'd3';

    const seedEl = document.getElementById('glyph-seed');
    const { seedDecisions } = JSON.parse(seedEl?.textContent || '{"seedDecisions":[]}');
    const API_BASE = apiBase();

    // ── D3 chronological timeline ─────────────────────────
    // Renders each decision at (timestamp × confidence). Height encodes
    // confidence, size encodes confidence, colour encodes the derived
    // stability status. Works for both seed (slug) and real API data.
    function renderTimeline(items: any[]) {
      const wrap = document.getElementById('d3-chart');
      if (!wrap) return;
      wrap.innerHTML = '';

      const W = wrap.clientWidth || 780;
      const H = 158;
      const M = { top: 16, right: 14, bottom: 26, left: 34 };

      // Confidence is 0–1 from the API but 0–100 in seed data — normalise.
      // A null confidence means the model never rated that decision. It is
      // not a zero, and plotting it as one parked real findings on the floor
      // of the y-axis, so unrated decisions are left off this chart; the
      // dated list below still carries them.
      const pts = items
        .map((d: any) => {
          const t = d.timestamp ? new Date(d.timestamp) : null;
          if (!t || isNaN(t.getTime())) return null;
          const raw  = d.confidence;
          if (raw === null || raw === undefined) return null;
          const conf = raw > 1 ? Math.round(raw) : Math.round(raw * 100);
          return {
            t, conf,
            title: (d.title ?? 'UNKNOWN').toUpperCase().replace(/\s+/g, '_'),
            contributor: Array.isArray(d.contributors) ? d.contributors[0] ?? 'unknown' : 'unknown',
          };
        })
        .filter(Boolean)
        .sort((a: any, b: any) => a.t - b.t);

      if (pts.length === 0) {
        const e = document.createElement('div');
        e.className = 'tl-chart-empty';
        e.textContent = 'NO_TIMESTAMPED_DECISIONS';
        wrap.appendChild(e);
        return;
      }

      const svg = d3.select(wrap)
        .append('svg')
        .attr('width', W).attr('height', H)
        .attr('viewBox', `0 0 ${W} ${H}`)
        .style('display', 'block');

      const x = d3.scaleTime()
        .domain(d3.extent(pts, (d: any) => d.t) as [Date, Date])
        .range([M.left, W - M.right]);

      const y = d3.scaleLinear().domain([0, 100]).range([H - M.bottom, M.top]);

      // Horizontal confidence gridlines
      svg.append('g')
        .selectAll('line')
        .data([25, 50, 75])
        .join('line')
        .attr('x1', M.left).attr('x2', W - M.right)
        .attr('y1', (d: number) => y(d)).attr('y2', (d: number) => y(d))
        .attr('stroke', '#1e1e1e').attr('stroke-width', 1);

      // Axes
      const xg = svg.append('g')
        .attr('transform', `translate(0,${H - M.bottom})`)
        // Span-aware ticks. '%b %y' alone renders "Jan 22", which reads as a
        // day-of-month; real decision histories span years, so pick a format
        // that matches the range actually being shown.
        .call(
          d3.axisBottom(x).ticks(6).tickFormat(((v: any) => {
            const [a, b] = x.domain() as [Date, Date];
            const days = Math.abs(+b - +a) / 86400000;
            if (days > 730) return d3.timeFormat('%Y')(v);
            if (days > 60)  return d3.timeFormat("%b '%y")(v);
            return d3.timeFormat('%d %b')(v);
          }) as any)
        );
      xg.selectAll('text').attr('fill', '#a1a1a1').style('font-size', '9px');
      xg.selectAll('path,line').attr('stroke', '#2a2a2a');

      const yg = svg.append('g')
        .attr('transform', `translate(${M.left},0)`)
        .call(d3.axisLeft(y).ticks(4).tickSize(-(W - M.left - M.right)));
      yg.selectAll('text').attr('fill', '#5e3f3a').style('font-size', '9px');
      yg.selectAll('line').attr('stroke', '#1e1e1e');
      yg.selectAll('path').attr('stroke', 'none');

      // Chronological sequence line
      const seq = d3.line<{ t: Date; conf: number }>()
        .x((d: any) => x(d.t))
        .y((d: any) => y(d.conf))
        .curve(d3.curveMonotoneX);
      svg.append('path')
        .datum(pts as any)
        .attr('d', seq)
        .attr('fill', 'none')
        .attr('stroke', '#2a2a2a')
        .attr('stroke-width', 1)
        .attr('stroke-dasharray', '3 3');

      // Tooltip
      const tip = d3.select(wrap)
        .append('div')
        .style('position', 'absolute')
        .style('display', 'none')
        .style('background', '#0e0e0e')
        .style('border', '1px solid #cc0000')
        .style('padding', '6px 10px')
        .style('font-family', 'JetBrains Mono, monospace')
        .style('font-size', '0.625rem')
        .style('line-height', '1.5')
        .style('color', '#e5e2e1')
        .style('pointer-events', 'none')
        .style('z-index', '50');

      // Decision points — colour by derived stability, size by confidence.
      svg.selectAll('circle')
        .data(pts)
        .join('circle')
        .attr('cx', (d: any) => x(d.t))
        .attr('cy', (d: any) => y(d.conf))
        .attr('r', (d: any) => 3 + (d.conf / 100) * 5)
        .attr('fill', (d: any) => d.conf >= 90 ? '#22d3ee' : d.conf >= 70 ? '#a1a1a1' : '#ef4444')
        .attr('stroke', '#131313')
        .attr('stroke-width', 1)
        .style('cursor', 'crosshair')
        .on('mouseenter', (event: any, d: any) => {
          tip
            .style('display', 'block')
            .html(`<div style="color:#cc0000;font-weight:700;">${d.title}</div>` +
                  `<div>CONF ${d.conf}% &nbsp;·&nbsp; @${d.contributor}</div>` +
                  `<div style="color:#5e3f3a;">${d.t.toISOString().slice(0, 10)}</div>`);
        })
        .on('mousemove', (event: any) => {
          const [px, py] = d3.pointer(event, wrap);
          tip.style('left', `${px + 14}px`).style('top', `${py - 8}px`);
        })
        .on('mouseleave', () => tip.style('display', 'none'));
    }

    // ── Per-month decision density grid ───────────────────
    // A GitHub-contributions-style matrix: one row per year, one cell per
    // month, cell colour encoding how many decisions landed that month.
    // Sequential encoding on a single hue drawn from GLYPH's own tokens —
    // dim rust → #cc0000 → coral → #ffb4a8 — validated as an ordinal ramp
    // against the #131313 surface (monotone lightness, adjacent ΔL ≥ 0.06,
    // dim end ≥ 2:1, hue spread 3°).
    const MG_RAMP = ['#6a4741', '#cc0000', '#f4735c', '#ffb4a8'];
    const MG_ZERO = '#1c1c1c';
    const MG_MONTHS = ['J', 'F', 'M', 'A', 'M', 'J', 'J', 'A', 'S', 'O', 'N', 'D'];
    const MG_MONTH_NAMES = ['January','February','March','April','May','June',
                            'July','August','September','October','November','December'];

    /** Map a count onto a ramp step.
     *  Decision histories are sparse — a busy month is often only three or four
     *  nodes — so below that, count maps to step directly and every increment is
     *  visible. Pure quartiles would collapse 1 and 2 into the same colour and
     *  never use the dim step at all. Above it, quartiles keep the scale bounded. */
    function mgLevel(count, max) {
      if (count <= 0) return 0;
      if (max <= 4) return Math.min(count, 4);
      const q = count / max;
      if (q <= 0.25) return 1;
      if (q <= 0.5)  return 2;
      if (q <= 0.75) return 3;
      return 4;
    }

    function renderMonthGrid(items) {
      const wrap  = document.getElementById('month-grid-wrap');
      const total = document.getElementById('month-total');
      const tip   = document.getElementById('mg-tip');
      const panel = document.getElementById('month-panel');
      if (!wrap) return;

      // Bucket by calendar month. Undated insights are excluded from the grid
      // but still counted in the list below, so the header says how many.
      const buckets = new Map();          // "YYYY-M" -> count
      let dated = 0;
      let minY = Infinity, maxY = -Infinity;

      items.forEach((d) => {
        const raw = d.timestamp;
        if (!raw) return;
        const t = new Date(raw);
        if (Number.isNaN(+t)) return;
        dated++;
        const y = t.getFullYear();
        const m = t.getMonth();
        if (y < minY) minY = y;
        if (y > maxY) maxY = y;
        const key = `${y}-${m}`;
        buckets.set(key, (buckets.get(key) ?? 0) + 1);
      });

      if (!dated) {
        wrap.innerHTML = '';
        const msg = document.createElement('div');
        msg.id = 'month-empty';
        msg.textContent = items.length
          ? 'NO_DATED_DECISIONS'
          : 'NO_DECISIONS_EXTRACTED';
        wrap.appendChild(msg);
        if (total) total.textContent = '—';
        return;
      }

      const max = Math.max(...buckets.values());
      if (total) {
        total.textContent = dated === items.length
          ? `${dated} DATED`
          : `${dated}/${items.length} DATED`;
      }

      // Bound the row count so a decade-long history stays legible in the strip.
      const MAX_ROWS = 7;
      if (maxY - minY + 1 > MAX_ROWS) minY = maxY - (MAX_ROWS - 1);

      wrap.innerHTML = '';

      // Month headings
      const head = document.createElement('div');
      head.className = 'mg-months';
      head.appendChild(document.createElement('span'));       // year-label gutter
      MG_MONTHS.forEach((label) => {
        const el = document.createElement('span');
        el.className = 'mg-month-label';
        el.textContent = label;
        head.appendChild(el);
      });
      wrap.appendChild(head);

      const now = new Date();
      const showTip = (el, text) => {
        if (!tip || !panel) return;
        tip.textContent = '';
        const strong = document.createElement('span');
        strong.className = 'tip-value';
        strong.textContent = text.value;              // value leads
        const rest = document.createElement('span');
        rest.textContent = ` ${text.label}`;          // label follows
        tip.appendChild(strong);
        tip.appendChild(rest);
        tip.style.display = 'block';

        const pr = panel.getBoundingClientRect();
        const cr = el.getBoundingClientRect();
        const left = cr.left - pr.left + cr.width / 2 - tip.offsetWidth / 2;
        tip.style.left = `${Math.max(4, Math.min(left, pr.width - tip.offsetWidth - 4))}px`;
        tip.style.top  = `${cr.top - pr.top - tip.offsetHeight - 6}px`;
      };
      const hideTip = () => { if (tip) tip.style.display = 'none'; };

      for (let y = minY; y <= maxY; y++) {
        const row = document.createElement('div');
        row.className = 'mg-row';

        const yl = document.createElement('span');
        yl.className = 'mg-year-label';
        yl.textContent = `'${String(y).slice(2)}`;    // '22, '23 …
        row.appendChild(yl);

        for (let m = 0; m < 12; m++) {
          const count = buckets.get(`${y}-${m}`) ?? 0;
          const level = mgLevel(count, max);

          // A month that has not happened yet is absent, not empty.
          const future = y > now.getFullYear()
            || (y === now.getFullYear() && m > now.getMonth());

          const cell = document.createElement('button');
          cell.type = 'button';
          cell.className = 'mg-cell' + (future ? ' mg-void' : '');
          cell.dataset.level = String(level);
          if (!future) cell.style.background = level === 0 ? MG_ZERO : MG_RAMP[level - 1];

          const label = `${MG_MONTH_NAMES[m]} ${y}`;
          if (future) {
            cell.disabled = true;
            cell.setAttribute('aria-hidden', 'true');
            cell.tabIndex = -1;
          } else {
            // Reachable without hovering, for screen readers and for the
            // keyboard path the tooltip mirrors.
            const noun = count === 1 ? 'decision' : 'decisions';
            cell.setAttribute('aria-label', `${count} ${noun} in ${label}`);
            const payload = { value: `${count} ${noun.toUpperCase()}`, label: `· ${label}` };
            cell.addEventListener('pointerenter', () => showTip(cell, payload));
            cell.addEventListener('pointermove',  () => showTip(cell, payload));
            cell.addEventListener('pointerleave', hideTip);
            cell.addEventListener('focus',        () => showTip(cell, payload));
            cell.addEventListener('blur',         hideTip);
          }
          row.appendChild(cell);
        }
        wrap.appendChild(row);
      }
    }

    /// Reduce a source reference to something worth showing next to COMMIT:
    /// a 7-char SHA when one is present, else a PR/issue number, else the
    /// trimmed reference itself.

    // ── Hydrate from real API ─────────────────────────────
    (function hydrateDecisions() {
      const jobId = getJobId();
      if (!jobId) return;

      const list = document.getElementById('timeline-list');

      apiFetch(`${API_BASE}/api/repo/${jobId}/decisions`)
        .then(r => r.ok ? r.json() : null)
        .then(data => {
          if (!data?.decisions?.length) {
            // Honest empty state — this job produced no decision nodes.
            showEmptyState(list, 'NO_DECISIONS_EXTRACTED',
              'This analysis produced no decision nodes for this repository.');
            // The D3 scatter has nothing to plot; say so rather than
            // leaving an empty chart frame that reads as "still loading".
            const chart = document.getElementById('d3-chart');
            if (chart) {
              chart.innerHTML =
                '<div style="display:flex;align-items:center;justify-content:center;height:100%;' +
                'font-family:JetBrains Mono,monospace;font-size:0.625rem;letter-spacing:0.08em;' +
                'color:#5e3f3a;">NO_TIMELINE_DATA</div>';
            }
            renderMonthGrid([]);
            return;
          }
          if (!list) return;
          list.innerHTML = '';

          data.decisions.forEach((d, idx) => {
            const title   = (d.title ?? 'UNKNOWN').toUpperCase().replace(/\s+/g, '_');
            const summary = d.summary ?? '';
            const ref     = Array.isArray(d.source_refs) ? d.source_refs[0] : undefined;
            // Refs arrive loosely formatted — "a1b2c3d", "commit: a1b2c3d",
            // "PR #1822". Blindly taking the first 7 characters rendered
            // "COMMIT: commit:", so pull out the actual identifier.
            const sha     = shortRef(ref);
            // null means the model returned no score for this decision.
            // Rendering that as 0% asserted near-total doubt about findings
            // that are often the best-evidenced ones in the set.
            const rated   = d.confidence !== null && d.confidence !== undefined;
            const conf    = rated ? Math.round(d.confidence * 100) : null;
            const contrib = Array.isArray(d.contributors) ? d.contributors[0] ?? 'unknown' : 'unknown';
            const ts      = (d.timestamp ?? '').replace('T', ' ').replace('Z', '');
            const padIdx  = String(idx + 1).padStart(2, '0');

            // Status derived honestly from confidence, not a hardcoded label.
            // With no score there is nothing to derive, so say so.
            const status = !rated ? 'UNRATED'
                         : conf >= 90 ? 'STABLE'
                         : conf >= 70 ? 'RESOLVED' : 'CRITICAL';
            const color  = !rated ? '#5e3f3a'
                         : conf >= 90 ? '#22d3ee'
                         : conf >= 70 ? '#a1a1a1' : '#ef4444';

            const item = document.createElement('div');
            item.className = 'timeline-item';
            item.setAttribute('role', 'listitem');
            item.innerHTML = `
              <div class="tl-dot"></div>
              <div class="decision-card">
                <div class="dc-top">
                  <div class="dc-id-ts">
                    <span class="dc-id">DECISION_${padIdx} // ${ts}</span>
                  </div>
                  <span class="dc-status-chip" style="color:${color};border-color:${color};">${status}</span>
                </div>
                <h2 class="dc-title">${title}</h2>
                <p class="dc-summary">${summary}</p>
                <div class="dc-footer">
                  <div class="dc-footer-left">
                    <span class="dc-commit-label">COMMIT:</span>
                    <span class="dc-commit-val">${sha}</span>
                    <span class="dc-conf-label">CONFIDENCE:</span>
                    <span class="dc-conf-val">${rated ? conf + '%' : '—'}</span>
                  </div>
                  <span class="dc-contributor">@${contrib}</span>
                </div>
              </div>`;
            list.appendChild(item);
          });

          const tot = document.getElementById('stream-total');
          if (tot) tot.textContent = String(data.total ?? data.decisions.length);

          // Real decisions on the chronological scatter.
          renderTimeline(data.decisions);

          // Intelligence sidebar — every number below is derived from the
          // decision nodes the backend actually returned.
          hydrateStats(data.decisions);
          renderMonthGrid(data.decisions);
        })
        .catch(() => {
          const body = document.getElementById('stream-body');
          // "showing static preview" was untrue — nothing was shown at all, and
          // the panel below stayed on its SYNCING placeholder for ever. Say
          // what happened and clear the placeholder.
          appendErrorLine(body, 'ANALYSIS SERVICE UNREACHABLE — no data loaded');
          showEmptyState(
            document.getElementById('timeline-list'),
            'SERVICE_UNREACHABLE',
            'The analysis API did not respond. Check the backend is running, then reload.',
          );
        });
    })();

    // ── Intelligence sidebar hydration (real jobs only) ───
    // Recomputes TOTAL / AVG CONFIDENCE / CONTRIBUTORS / TIME SPAN, the
    // confidence histogram and the top decision makers straight from the
    // API payload. Nothing here can fall back to seed values.
    function hydrateStats(items) {
      const set = (id, val) => {
        const el = document.getElementById(id);
        if (el) el.textContent = val;
      };

      // Only decisions the model actually scored count toward the average
      // and the histogram. Treating an unscored decision as 0% both invented
      // a rating and dragged the headline average down.
      const confs = items
        .filter(d => d.confidence !== null && d.confidence !== undefined)
        .map(d => Math.round(d.confidence * 100));
      const avg   = confs.length
        ? Math.round(confs.reduce((a, c) => a + c, 0) / confs.length)
        : null;
      const unrated = items.length - confs.length;

      const people = new Set();
      items.forEach(d => {
        (Array.isArray(d.contributors) ? d.contributors : []).forEach(c => {
          if (c) people.add(String(c));
        });
      });

      const times = items
        .map(d => Date.parse(d.timestamp ?? ''))
        .filter(t => !Number.isNaN(t));
      const spanDays = times.length >= 2
        ? Math.max(1, Math.round((Math.max(...times) - Math.min(...times)) / 86400000))
        : null;

      set('stat-total',    String(items.length));
      set('stat-conf',     avg === null ? '—' : `${avg}%`);
      set('stat-contribs', String(people.size));
      set('stat-span',     spanDays === null ? 'N/A' : `${spanDays} days`);

      // Confidence histogram — same four buckets, real counts.
      const buckets = [
        ['HIGH (90%+)',    confs.filter(c => c >= 90).length],
        ['MED (70–89%)',   confs.filter(c => c >= 70 && c < 90).length],
        ['LOW (50–69%)',   confs.filter(c => c >= 50 && c < 70).length],
        ['MINIMAL (<50%)', confs.filter(c => c < 50).length],
      ];
      buckets.forEach(([label, count]) => {
        const row = document.querySelector(`.conf-bar-row[data-bucket="${label}"]`);
        if (!row) return;
        const fill = row.querySelector('.conf-bar-fill');
        const out  = row.querySelector('.conf-bar-pct');
        // With nothing rated there is no distribution to show — an em-dash
        // rather than four bars all reading 0%.
        const pct = confs.length ? Math.round(count / confs.length * 100) : null;
        if (fill) fill.style.width = (pct ?? 0) + '%';
        if (out)  out.textContent  = pct === null ? '—' : pct + '%';
      });

      // Say plainly how much of the set the distribution above covers.
      const note = document.getElementById('conf-unrated-note');
      if (note) {
        note.textContent = unrated > 0
          ? `${unrated} of ${items.length} unrated by the model`
          : '';
      }

      // Top decision makers — real handles, real counts.
      const tally = {};
      items.forEach(d => {
        const c = Array.isArray(d.contributors) ? d.contributors[0] : null;
        if (c) tally[c] = (tally[c] ?? 0) + 1;
      });
      const ranked = Object.entries(tally).sort((a, b) => b[1] - a[1]).slice(0, 3);
      const host = document.getElementById('top-makers');
      if (!host) return;
      if (!ranked.length) {
        host.innerHTML =
          '<div class="maker-row"><span class="maker-count">NO_CONTRIBUTOR_ATTRIBUTION</span></div>';
        return;
      }
      host.innerHTML = ranked.map(([handle, count]) => {
        const pct = Math.round(count / items.length * 100);
        return `<div class="maker-row">
            <div class="maker-header">
              <span class="maker-handle">@${handle}</span>
              <span class="maker-count">${count} decision${count === 1 ? '' : 's'}</span>
            </div>
            <div class="maker-bar-track" aria-hidden="true">
              <div class="maker-bar-fill" style="width:${pct}%"></div>
            </div>
          </div>`;
      }).join('');
    }

    // ── Demo (slug) timeline from seed data ───────────────
    if (!getJobId()) {
      renderTimeline(seedDecisions);
      renderMonthGrid(seedDecisions);
    }

    // The EXECUTE_FETCH button that used to sit here fetched nothing: it set
    // its own label to "FETCHING..." for two seconds and changed it back. The
    // shared sidebar's RE_ANALYZE control dispatches a real analysis instead.

    // ── Live stream ───────────────────────────────────────
    (function initStream() {
      const body    = document.getElementById('stream-body');
      if (!body) return;

      // Real jobs stream the actual analysis stage; only slug/demo URLs
      // (getJobId() === null) get the fabricated boot sequence. Wipe the
      // server-rendered placeholder line first so nothing seeded survives.
      if (getJobId()) {
        body.innerHTML = '';
        startStatusFeed(body);
        return;
      }

      const decisions = seedDecisions;
      const tags  = ['LOG', 'EVENT', 'SYSTEM', 'LINK', 'CONFIDENCE', 'CONTRIBUTOR'];
      const shas  = ['7f3a9e2','d92c1b0','33ab8f4','a1f042c','5c8b3d1','e74f901'];
      const handles = ['arch_priya','lead_author','dev_soren','infra_tolly','sec_ananya'];
      let di = 0, si = 0, hi = 0, decNum = decisions.length + 1;

      function nowTs() {
        const d = new Date();
        return `[${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}:${String(d.getSeconds()).padStart(2,'0')}]`;
      }

      const generators = [
        () => `<span class="s-ts">${nowTs()}</span><span class="s-tag"> [INDEX] </span><span class="s-em">DECISION_${String(decNum++).padStart(2,'0')}</span><span class="s-tag"> written to ledger</span>`,
        () => `<span class="s-ts">${nowTs()}</span><span class="s-tag"> [LINK] </span><span class="s-tag">commit </span><span class="s-red">${shas[si++ % shas.length]}</span><span class="s-tag"> → DECISION_${String(decNum - 1).padStart(2,'0')}</span>`,
        () => `<span class="s-ts">${nowTs()}</span><span class="s-tag"> [CONFIDENCE] </span><span class="s-tag">score </span><span class="s-em">${Math.floor(Math.random()*30+70)}%</span><span class="s-tag"> assigned</span>`,
        () => `<span class="s-ts">${nowTs()}</span><span class="s-tag"> [CONTRIBUTOR] </span><span class="s-em">@${handles[hi++ % handles.length]}</span><span class="s-tag"> flagged as author</span>`,
        () => `<span class="s-ts">${nowTs()}</span><span class="s-tag"> [NEW_DECISION_PENDING] </span><span class="s-tag">Caching strategy for /v${Math.floor(Math.random()*3+1)}/nodes</span>`,
        () => `<span class="s-ts">${nowTs()}</span><span class="s-tag"> [SYSTEM] </span><span class="s-tag">ANALYZING IMPACT on EXISTING_DATA_STRUCTURES...</span>`,
      ];

      let gIdx = 0;
      setInterval(() => {
        const line = document.createElement('div');
        line.className = 's-line';
        line.innerHTML = generators[gIdx % generators.length]();
        gIdx++;
        body.appendChild(line);
        body.scrollTop = body.scrollHeight;
        while (body.children.length > 40) body.removeChild(body.firstChild);
      }, 2000);
    })();
  </script>

</body>
</html>
