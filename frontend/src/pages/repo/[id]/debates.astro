  <!-- ════════════════════════════════════════════════════════
       SCRIPTS
  ═════════════════════════════════════════════════════════ -->
  <!-- Seed payload as JSON: define:vars forces the script inline, which stops
       Astro bundling it and makes the ES imports below throw. -->
  <script type="application/json" id="glyph-seed" set:html={JSON.stringify({ sentimentBars, prNumber: debateThread.prNumber, contributors })}></script>

  <script>
    import { getJobId, apiBase, showEmptyState, appendErrorLine, startStatusFeed } from '../../../scripts/repo-view';

    const seedEl = document.getElementById('glyph-seed');
    const { sentimentBars, prNumber, contributors } =
      JSON.parse(seedEl?.textContent || '{"sentimentBars":[],"prNumber":0,"contributors":[]}');
    const API_BASE = apiBase();

    // ── Status bar: real job + API facts, not invented host telemetry ──
    (function initStatusBar() {
      const job = document.getElementById('sb-job');
      const api = document.getElementById('sb-api');
      const id  = getJobId();
      if (job) job.textContent = id ? id.slice(0, 8).toUpperCase() : 'DEMO';
      if (api) {
        try { api.textContent = new URL(API_BASE).host; }
        catch { api.textContent = API_BASE; }
      }
    })();

    function nowTs() {
      const d = new Date();
      return `[${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}:${String(d.getSeconds()).padStart(2, '0')}]`;
    }
    // ── Execute fetch ─────────────────────────────────────
    (function() {
      const btn = document.getElementById('execute-fetch');
      if (!btn) return;
      btn.addEventListener('click', () => {
        btn.textContent = 'FETCHING...';
        setTimeout(() => { btn.textContent = 'EXECUTE_FETCH'; }, 2000);
      });
    })();

    // ── Hydrate ALL panels from real API ──────────────────
    // Real jobs (UUID ids) get every panel rendered from
    // GET /api/repo/:id/debates — no seed values survive.
    (function hydrateDebates() {
      const jobId = getJobId();
      if (!jobId) return;

      const setText = (id: string, val: string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = val;
      };

      fetch(`${API_BASE}/api/repo/${jobId}/debates`)
        .then(r => (r.ok ? r.json() : null))
        .then(data => {
          const debates = Array.isArray(data?.debates) ? data.debates : [];
          const m = data?.metrics ?? {};

          // ── No measurable debate threads → honest empty state ──
          if (!debates.length) {
            const feed = document.getElementById('feed-body');
            showEmptyState(feed, 'NO_DEBATE_THREADS',
              'This analysis surfaced no measurable debate threads for this repository.');
            const heat = document.getElementById('heatmap-body');
            if (heat) {
              heat.className = 'hm-empty';
              heat.textContent = 'NO_DEBATES_DETECTED';
            }
            const ts = document.getElementById('thread-status');
            if (ts) ts.textContent = 'NO_DEBATES';
            return;
          }

          const total = debates.length;
          const confidence = (d: any) => d.confidence ?? 0;
          const avgConf = Math.round(
            (debates.reduce((s, d) => s + confidence(d), 0) / total) * 100
          );
          const bars = debates.map(d => Math.round(confidence(d) * 100));
          const topics = new Set(
            debates.map(d => (d.title ?? '').trim().toLowerCase()).filter(Boolean)
          ).size;
          const lowConf = debates.filter(d => confidence(d) < 0.5).length;

          // Contributor participation across threads.
          const participation = new Map<string, number>();
          const perThread = new Map<string, Set<number>>();
          debates.forEach((d, i) => {
            const list = Array.isArray(d.contributors) ? d.contributors : [];
            for (const h of list) {
              participation.set(h, (participation.get(h) ?? 0) + 1);
              if (!perThread.has(h)) perThread.set(h, new Set());
              perThread.get(h)!.add(i);
            }
          });
          const ranked = [...participation.entries()].sort((a, b) => b[1] - a[1]);
          const topHandles = ranked.slice(0, 12).map(([h]) => h);
          const avgParticipants = debates.reduce(
            (s, d) => s + (Array.isArray(d.contributors) ? d.contributors.length : 0),
            0
          ) / total;

          // Expose real bars to the D3 chart module (separate script block).
          (window as any).__GLYPH_DEBATES__ = { bars, count: total };
          window.dispatchEvent(new CustomEvent('glyph:debates-updated'));

          // ── Header stats ──
          setText('hs-total', String(total));
          setText('hs-conf', `${avgConf}%`);

          // ── Sentiment / contention metrics ──
          setText('sm-agreement', `${m.agreement_pct ?? 0}%`);
          setText('sm-contention', `${m.contention_pct ?? 0}%`);
          setText('sm-topics', String(topics));
          setText('sm-lowconf', String(lowConf));

          // ── Density stats ──
          setText('ds-total', String(total));
          setText('ds-participants', avgParticipants ? avgParticipants.toFixed(1) : '—');

          // ── Thread identity from the lead debate ──
          const first = debates[0];
          const threadId = document.querySelector('.thread-id');
          if (threadId) {
            const pr    = first?.source_refs?.[0] ?? 'N/A';
            const topic = (first?.title ?? 'UNKNOWN_DEBATE').toUpperCase().replace(/\s+/g, '_');
            const contention = m.contention_pct ?? 0;
            const status = contention >= 50 ? 'HEATED' : contention >= 20 ? 'ACTIVE' : 'RESOLVED';
            const statusColor = status === 'HEATED' ? '#cc0000' : status === 'ACTIVE' ? '#5e3f3a' : '#a1a1a1';
            threadId.innerHTML =
              `THREAD_ID: PR_${pr}_${topic}` +
              `<span style="margin: 0 8px; color: #262626;">//</span>` +
              `STATUS: <span class="thread-status" style="color: ${statusColor}">${status}</span>`;
          }

          // ── Interaction heatmap: contributor × debate participation ──
          const heat = document.getElementById('heatmap-body');
          if (heat) {
            if (!topHandles.length) {
              heat.className = 'hm-empty';
              heat.textContent = 'NO_PARTICIPANTS_DETECTED';
            } else {
              const rows = topHandles.slice(0, 10);
              const cols = Math.min(debates.length, 24);
              let html = '';
              rows.forEach((h) => {
                const set = perThread.get(h) ?? new Set<number>();
                let cells = '';
                for (let c = 0; c < cols; c++) {
                  const active = set.has(c);
                  cells += active
                    ? '<div class="hm-cell" style="background:#cc0000;opacity:0.85;" aria-hidden="true"></div>'
                    : '<div class="hm-cell" style="background:#1a1a1a;opacity:0.4;" aria-hidden="true"></div>';
                }
                const short = h.replace(/^@/, '').slice(0, 10);
                html += `<div class="hm-row"><span class="hm-label" title="${h}">${short}</span>${cells}</div>`;
              });
              heat.className = '';
              heat.innerHTML = html;
            }
          }

          // ── Key actor profiles: top participants by debate count ──
          const profiles = document.getElementById('profiles-live');
          if (profiles) {
            if (!ranked.length) {
              profiles.className = 'profiles-loading';
              profiles.textContent = 'NO_DISTINCT_PARTICIPANTS_IN_DEBATES';
            } else {
              profiles.className = '';
              profiles.innerHTML = ranked.slice(0, 3).map(([handle, count]) => {
                const clean = handle.replace(/^@/, '');
                const initials = clean.split(/[^A-Za-z0-9]/).map(w => w[0]).join('')
                  .toUpperCase().slice(0, 2) || '?';
                const share = Math.round((count / total) * 100);
                const engagement = count >= Math.ceil(total / 2)
                  ? 'HIGH_ENGAGEMENT'
                  : count >= Math.ceil(total / 4) ? 'ACTIVE' : 'PARTICIPANT';
                return (
                  `<div class="profile-card" role="listitem" aria-label="Contributor: ${clean}">` +
                  `<div class="profile-top">` +
                  `<div class="profile-avatar" aria-hidden="true"><span class="profile-avatar-initials">${initials}</span></div>` +
                  `<div class="profile-info">` +
                  `<span class="profile-handle">${clean}</span>` +
                  `<span class="profile-role-chip" role="status">${engagement}</span>` +
                  `</div></div>` +
                  `<div class="profile-metric" aria-label="Debates participated: ${count} of ${total}">` +
                  `<div class="metric-header-row"><span class="metric-lbl">DEBATES</span>` +
                  `<span class="metric-pct">${count}/${total}</span></div>` +
                  `<div class="metric-track" aria-hidden="true"><div class="metric-fill" style="width:${share}%"></div></div>` +
                  `</div></div>`
                );
              }).join('');
            }
          }

          // ── Feed: append an honest findings summary line ──
          const feed = document.getElementById('feed-body');
          if (feed) {
            const line = document.createElement('div');
            line.className = 'feed-line';
            line.style.fontWeight = '700';
            line.innerHTML =
              `<span class="f-ts">[${nowTs()}]</span> <span style="color:#a1a1a1;">DATA:</span> ` +
              `<span style="color:#e5e2e1;">FOUND ${total} DEBATE THREAD${total === 1 ? '' : 'S'} · ` +
              `${avgParticipants.toFixed(1)} PARTICIPANTS AVG · ${avgConf}% AVG CONFIDENCE</span>`;
            feed.appendChild(line);
            feed.scrollTop = feed.scrollHeight;
          }
        })
        .catch(() => {
          const body = document.getElementById('feed-body');
          appendErrorLine(body, 'COULD NOT REACH ANALYSIS SERVICE — showing static preview');
        });
    })();

    // ── Live analysis feed ────────────────────────────────
    (function initFeed() {
      const body = document.getElementById('feed-body');
      if (!body) return;

      // Real jobs stream actual analysis stage; only demo URLs fabricate.
      if (getJobId()) {
        startStatusFeed(body);
        return;
      }

      const handles = contributors.map(c => c.handle);
      const shas    = ['0xf3a91c2', '0xa9e3f14', '0x2c4d801', '0x7b1c339', '0x1d5a0c8'];
      const topics  = ['AUTH_REDESIGN', 'DB_SCHEMA_V3', 'API_GATEWAY', 'NIM_PIPELINE', 'INGESTION_LAYER'];
      let   decIdx  = 7;
      let   ri = 0, si = 0, ti = 0;

      type Level = 'INFO' | 'ALERT' | 'ANALYSIS' | 'DATA' | 'LOG' | 'CRITICAL';

      const pool: Array<() => { level: Level; body: string }> = [
        () => ({ level: 'INFO',     body: `Scanning PR thread <span class="f-em">#${prNumber + ri++}</span>...` }),
        () => ({ level: 'ALERT',    body: `High-frequency interaction: <span class="f-em">'${handles[0]}'</span> and <span class="f-em">'${handles[1]}'</span>.` }),
        () => ({ level: 'ANALYSIS', body: `Debate centered on <span class="f-em">${topics[ti++ % topics.length]}</span> in commit <span class="f-em">${shas[si++ % shas.length]}</span>.` }),
        () => ({ level: 'DATA',     body: `Contention index rising: <span class="f-em">+${Math.floor(Math.random()*12+2)}%</span> in last 10 minutes.` }),
        () => ({ level: 'INFO',     body: `Generating intent node for <span class="f-em">decision_id: #ARCHITECTURAL_DECISION_${String(decIdx++).padStart(3,'0')}</span>...` }),
        () => ({ level: 'CRITICAL', body: `Position conflict in <span class="f-em">'${handles[1]}'</span> argument. Dismissive tone flagged.` }),
        () => ({ level: 'LOG',      body: `Buffer synchronized. Waiting for next payload...` }),
        () => ({ level: 'DATA',     body: `NIM response latency: <span class="f-em">${Math.floor(Math.random()*80+120)}ms</span>.` }),
        () => ({ level: 'INFO',     body: `Extracting contributor reasoning: <span class="f-em">${handles[ri % handles.length]}</span>.` }),
        () => ({ level: 'ANALYSIS', body: `Rejection candidate flagged: <span class="f-em">ABANDONED_FEATURE_0${String(Math.floor(Math.random()*20)+1).padStart(2,'0')}</span>.` }),
      ];

      let poolIdx = 0;
      const cls: Record<Level, string> = {
        INFO: 'f-info', ALERT: 'f-alert', ANALYSIS: 'f-info',
        DATA: 'f-info', LOG: 'f-info', CRITICAL: 'f-critical',
      };

      setInterval(() => {
        const entry = pool[poolIdx % pool.length]();
        poolIdx++;
        const line = document.createElement('div');
        line.className = 'feed-line';
        line.innerHTML = `<span class="f-ts">${nowTs()}</span><span class="${cls[entry.level]}"> ${entry.level}: </span><span class="f-body">${entry.body}</span>`;
        body.appendChild(line);
        body.scrollTop = body.scrollHeight;
        while (body.children.length > 40) { body.removeChild(body.firstChild); }
      }, 2000);
    })();
  </script>

  <!-- ── D3 Sentiment bar chart ─────────────────────────── -->
  <script>
    // d3 is bundled from node_modules rather than fetched from a CDN so the
    // charts still render with no network (offline demo / bad venue wifi).
    import * as d3 from 'd3';

    const sentimentBars = JSON.parse(
      document.getElementById('glyph-seed')?.textContent || '{"sentimentBars":[]}'
    ).sentimentBars;

    const wrap = document.getElementById('sentiment-chart-wrap');
    if (!wrap) throw new Error();

    const W   = wrap.offsetWidth  || 400;
    const H   = wrap.offsetHeight || 120;
    const PAD = { top: 10, right: 4, bottom: 4, left: 4 };

    const svg = d3.select('#sentiment-svg')
      .attr('viewBox', `0 0 ${W} ${H}`)
      .attr('preserveAspectRatio', 'none');

    // Real jobs (UUID) feed real confidence bars via __GLYPH_DEBATES__;
    // demo/slug URLs fall back to the static seed.
    const realBars = () => (window as any).__GLYPH_DEBATES__?.bars;
    const isReal   = () => Array.isArray(realBars()) && realBars().length > 0;
    const pickData = () => (isReal() ? realBars() : sentimentBars);

    function render(data: number[]) {
      svg.selectAll('*').remove();

      const maxVal = d3.max(data) ?? 1;

      const x = d3.scaleBand()
        .domain(data.map((_, i) => String(i)))
        .range([PAD.left, W - PAD.right])
        .padding(0.25);

      const y = d3.scaleLinear()
        .domain([0, maxVal])
        .range([H - PAD.bottom, PAD.top]);

      // Dotted horizontal gridlines only — 4 levels
      const gridVals = [0.25, 0.5, 0.75, 1.0].map(f => f * maxVal);
      svg.append('g').selectAll('line')
        .data(gridVals)
        .enter()
        .append('line')
        .attr('x1', PAD.left)
        .attr('x2', W - PAD.right)
        .attr('y1', d => y(d))
        .attr('y2', d => y(d))
        .attr('stroke', '#262626')
        .attr('stroke-width', 1)
        .attr('stroke-dasharray', '3 3');

      // Bars — filled #cc0000, no radius
      svg.append('g').selectAll('rect')
        .data(data)
        .enter()
        .append('rect')
        .attr('x',      (_, i) => x(String(i)) ?? 0)
        .attr('y',      d => y(d))
        .attr('width',  x.bandwidth())
        .attr('height', d => H - PAD.bottom - y(d))
        .attr('fill',   '#cc0000');
    }

    render(pickData());

    // Re-render when the async hydrate completes for real jobs.
    window.addEventListener('glyph:debates-updated', () => {
      if (isReal()) render(realBars());
    });
  </script>

  <!-- Bottom status bar -->
  <div id="status-bar" aria-label="System status">
    <!-- Real job/transport facts. The previous MEM/CPU readout was invented
         — GLYPH has no access to host telemetry from the browser. -->
    <div class="sb-left">
      <span class="sb-item">JOB: <span id="sb-job">—</span></span>
      <span class="sb-item">API: <span id="sb-api">—</span></span>
    </div>
    <div class="sb-right">
      <span class="sb-item accent">BYOK: KEYS_NEVER_STORED</span>
    </div>
  </div>

</body>
</html>
