---
// GLYPH OS — Repository Analysis Dashboard
// src/pages/repo/[id].astro
export const prerender = false;

const { id } = Astro.params;

// A UUID job id means this is a REAL analysis. Demo chrome (seed callouts,
// probability matrix, neural forecast) is only rendered for slug URLs; real
// jobs render honest placeholders that the client hydrates from the API.
const IS_UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id ?? '');

// Decode the repo URL/id and extract owner/name
let repoOwner = 'unknown';
let repoName  = 'unknown';
try {
  const decoded = decodeURIComponent(id ?? '');
  // Support both full URL (https://github.com/owner/name) and owner/name slug
  const match = decoded.match(/github\.com\/([^\/]+)\/([^\/\s]+)/);
  if (match) {
    repoOwner = match[1];
    repoName  = match[2].replace(/\.git$/, '');
  } else {
    const parts = decoded.split('/').filter(Boolean);
    if (parts.length >= 2) { repoOwner = parts[0]; repoName = parts[1]; }
    else if (parts.length === 1) { repoName = parts[0]; }
  }
} catch (_) {}

const repoSlug    = `${repoOwner}/${repoName}`;
const repoContext = `${repoOwner}_${repoName}_ANALYSIS`.toUpperCase();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GLYPH — {repoSlug}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="glyph-repo-slug" content={repoSlug} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <!-- is:global is required, not cosmetic. Astro scopes page CSS with a
       [data-astro-cid-*] attribute that only server-rendered markup carries.
       Every element these pages build in JS (live-feed lines, hydrated
       decision/contributor cards, D3 nodes) is created with innerHTML or
       document.createElement and therefore has no scope attribute — under
       scoped CSS it renders completely unstyled. This page's stylesheet is
       self-contained and loaded by this page alone, so going global is safe. -->
  <style is:global>
    /* ── Reset ────────────────────────────────────────────── */
    *, *::before, *::after {
      box-sizing: border-box;
    }
    html, body {
      margin: 0; padding: 0;
      background: #131313;
      color: #e5e2e1;
      font-family: 'Karla', sans-serif;
      height: 100%;
      overflow: hidden; /* dashboard is fixed-layout */
    }
    /* interactive elements animate on the shared easing */
    a, button, [role="button"], input, select, textarea {
      transition: border-color 120ms cubic-bezier(0.2,0.6,0.2,1),
                  color 120ms cubic-bezier(0.2,0.6,0.2,1),
                  background-color 120ms cubic-bezier(0.2,0.6,0.2,1);
    }
    ::selection { background: #ffb4a8; color: #131313; }
    :focus-visible { outline: 1px solid #ffb4a8; outline-offset: 2px; }

    /* ── Type helpers ─────────────────────────────────────── */
    .mono       { font-family: 'JetBrains Mono', monospace; }
    .display    { font-family: 'Space Grotesk', sans-serif; }
    .data-sm    { font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem; line-height: 1rem; }
    .label-caps { font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; line-height: 1rem; }

    /* ── Color helpers ────────────────────────────────────── */
    .c-muted  { color: #a1a1a1; }
    .c-red    { color: #cc0000; }
    .c-em     { color: #e5e2e1; }
    .c-hero   { color: #ffb4a8; }
    .c-rust   { color: #5e3f3a; }

    /* ══════════════════════════════════════════════════════
       TOP NAVBAR  — 48px fixed
    ══════════════════════════════════════════════════════ */
    #navbar {
      position: fixed;
      top: 0; left: 0; right: 0;
      height: 48px;
      background: #131313;
      border-bottom: 1px solid #262626;
      display: grid;
      /* glyph-title | search | right-actions */
      grid-template-columns: auto 1fr auto;
      align-items: center;
      padding: 0 16px 0 0;
      z-index: 200;
    }

    /* GLYPH brand — left edge */
    #nav-brand {
      padding: 0 16px;
      display: flex;
      align-items: center;
      height: 100%;
    }
    #nav-brand a {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 1.25rem;
      color: #ffb4a8;
      text-decoration: none;
      letter-spacing: -0.01em;
      position: relative;
      display: inline-block;
      animation: brand-glitch 4s infinite steps(1);
    }
    /* RGB-split glitch layers behind the brand — same look as the landing hero */
    #nav-brand a::before,
    #nav-brand a::after {
      content: 'GLYPH';
      position: absolute;
      top: 0;
      left: 0;
      pointer-events: none;
      animation: brand-glitch 4s infinite steps(1);
    }
    #nav-brand a::before { color: #cc0000; transform: translate(-1px, 0); }
    #nav-brand a::after  { color: #22d3ee; transform: translate(1px, 0); }
    @keyframes brand-glitch {
      0%, 90%, 100% { clip-path: inset(0 0 0 0); transform: translate(0); opacity: 1; }
      91% { clip-path: inset(20% 0 40% 0); transform: translate(-2px, 1px); opacity: 0.85; }
      92% { clip-path: inset(0 0 0 0); transform: translate(0); opacity: 1; }
      95% { clip-path: inset(70% 0 10% 0); transform: translate(2px, -1px); opacity: 0.9; }
      96% { clip-path: inset(0 0 0 0); transform: translate(0); opacity: 1; }
    }

    /* Search */
    #nav-search {
      display: flex;
      align-items: center;
      border: 1px solid #262626;
      height: 28px;
    }
    #nav-search input {
      flex: 1;
      background: #131313;
      border: none;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6875rem;
      color: #e5e2e1;
      padding: 0 10px;
      height: 100%;
      letter-spacing: 0.04em;
    }
    #nav-search input::placeholder { color: #3a3a3a; }

    /* Right action buttons */
    #nav-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      padding-left: 16px;
    }
    .nav-icon-btn {
      width: 28px;
      height: 28px;
      background: transparent;
      border: 1px solid #262626;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #a1a1a1;
      padding: 0;
    }
    .nav-icon-btn:hover { border-color: #cc0000; color: #cc0000; }

    /* ══════════════════════════════════════════════════════
       LAYOUT  — sidebar + main + stream, below navbar
    ══════════════════════════════════════════════════════ */
    #layout {
      position: fixed;
      top: 48px;
      left: 0; right: 0; bottom: 0;
      display: grid;
      /* The stream column was 260px, which clipped every log line mid-word
         (backend error messages carry full API URLs). Wider + wrapping. */
      grid-template-columns: 172px minmax(0, 1fr) 320px;
    }

    /* ══════════════════════════════════════════════════════
       LEFT SIDEBAR  — 172px
    ══════════════════════════════════════════════════════ */
    #sidebar {
      background: #131313;
      border-right: 1px solid #262626;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .sidebar-nav {
      flex: 1;
      display: flex;
      flex-direction: column;
      padding-top: 8px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #a1a1a1;
      cursor: pointer;
      user-select: none;
      text-decoration: none;
      background: transparent;
      width: 100%;
      text-align: left;
      border-left: 2px solid transparent;
    }
    .nav-item:hover:not(.active) { color: #e5e2e1; background: #1a1a1a; }
    .nav-item.active { border-left-color: #cc0000; color: #ffffff; background: transparent; }
    .nav-item svg { flex-shrink: 0; }

    .sidebar-footer {
      border-top: 1px solid #262626;
      padding: 10px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    #execute-fetch {
      width: 100%;
      background: #cc0000;
      border: none;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #ffffff;
      padding: 8px 0;
      cursor: pointer;
      text-align: center;
    }
    #execute-fetch:hover { background: #ff0000; }

    .sidebar-util-row {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .util-btn {
      flex: 1;
      display: flex;
      align-items: center;
      gap: 5px;
      background: transparent;
      border: 1px solid #262626;
      color: #a1a1a1;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.55rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 5px 6px;
      cursor: pointer;
    }
    .util-btn:hover { border-color: #cc0000; color: #cc0000; }

    /* ══════════════════════════════════════════════════════
       MAIN AREA
    ══════════════════════════════════════════════════════ */
    #main-area {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      min-width: 0;
    }

    /* Page header strip */
    #page-header {
      padding: 14px 20px 12px;
      border-bottom: 1px solid #262626;
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      flex-shrink: 0;
    }
    #page-header-left .page-title {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 1.6rem;
      color: #e5e2e1;
      line-height: 1;
      margin: 0;
    }
    #page-header-left .page-context {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #a1a1a1;
      margin-top: 5px;
    }
    #page-header-right {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 3px;
    }
    #page-header-right .uptime,
    #page-header-right .heartbeat {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      color: #a1a1a1;
      letter-spacing: 0.06em;
    }
    #page-header-right .heartbeat-status { color: #cc0000; }

    /* Content grid */
    #content-grid {
      flex: 1;
      display: grid;
      grid-template-columns: 1fr 240px;
      grid-template-rows: 1fr;
      gap: 0;
      overflow: hidden;
      min-height: 0;
    }

    /* ══════════════════════════════════════════════════════
       DECISION GRAPH PANEL  — top-left
    ══════════════════════════════════════════════════════ */
    #graph-panel {
      grid-column: 1;
      grid-row: 1;
      border-right: 1px solid #262626;
      border-bottom: 1px solid #262626;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      background: #0e0e0e;
    }
    .panel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 14px;
      border-bottom: 1px solid #262626;
      flex-shrink: 0;
      background: #131313;
    }
    .panel-header-left  { font-family:'JetBrains Mono',monospace; font-size:0.6rem; letter-spacing:0.12em; text-transform:uppercase; color:#a1a1a1; }
    .panel-header-right { font-family:'JetBrains Mono',monospace; font-size:0.6rem; letter-spacing:0.06em; color:#a1a1a1; }
    .panel-header-sep   { color: #cc0000; margin: 0 6px; }

    #graph-container {
      flex: 1;
      position: relative;
      overflow: hidden;
      /* tactical-map framing: hairline inset frame + faint grid */
      box-shadow: inset 0 0 0 1px rgba(38, 38, 38, 0.5);
      background-image: radial-gradient(rgba(38, 38, 38, 0.35) 1px, transparent 1px);
      background-size: 18px 18px;
    }
    #graph-svg { width: 100%; height: 100%; display: block; }

    /* D3 node rects */
    .g-node rect {
      fill: #131313;
      stroke: #cc0000;
      stroke-width: 1;
    }
    .g-node text.node-title {
      font-family: 'JetBrains Mono', monospace;
      font-size: 8px;
      fill: #e5e2e1;
      font-weight: 600;
    }
    .g-node text.node-sha {
      font-family: 'JetBrains Mono', monospace;
      font-size: 7px;
      fill: #a1a1a1;
    }

    /* D3 links */
    .g-link-decision { stroke: #cc0000; stroke-width: 1; fill: none; }
    .g-link-rejected { stroke: #cc0000; stroke-width: 1; fill: none; stroke-dasharray: 4 3; }
    .g-link-debate   { stroke: #5e3f3a; stroke-width: 1; fill: none; }

    /* Pagination dots */
    #graph-pagination {
      position: absolute;
      bottom: 12px;
      left: 14px;
      display: flex;
      gap: 5px;
      align-items: center;
    }
    .page-dot {
      width: 8px;
      height: 8px;
      background: #262626;
      cursor: pointer;
    }
    .page-dot.active { background: #cc0000; }

    /* ══════════════════════════════════════════════════════
       INTELLIGENCE SIDEBAR  — top-right
    ══════════════════════════════════════════════════════ */
    #intel-panel {
      grid-column: 2;
      grid-row: 1;
      border-bottom: 1px solid #262626;
      display: flex;
      flex-direction: column;
      overflow-y: auto;
      background: #131313;
    }

    .intel-section {
      padding: 12px 14px;
      border-bottom: 1px solid #262626;
    }
    .intel-section:last-child { border-bottom: none; }

    .intel-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #cc0000;
      margin-bottom: 10px;
      display: block;
    }

    /* Metric rows */
    .metric-row {
      margin-bottom: 10px;
    }
    .metric-row:last-child { margin-bottom: 0; }
    .metric-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 4px;
    }
    .metric-name {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #a1a1a1;
    }
    .metric-pct {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.06em;
      color: #cc0000;
    }
    .metric-bar-track {
      width: 100%;
      height: 1px;
      background: #262626;
      position: relative;
    }
    .metric-bar-fill {
      height: 1px;
      background: #cc0000;
      position: absolute;
      top: 0; left: 0;
    }

    /* Neural forecast body */
    .forecast-body {
      font-family: 'Karla', sans-serif;
      font-size: 0.75rem;
      color: #a1a1a1;
      line-height: 1.5;
      margin-bottom: 12px;
    }
    .forecast-body .sha-inline { color: #cc0000; font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; }

    #override-btn {
      width: 100%;
      background: #cc0000;
      border: none;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #ffffff;
      padding: 8px 0;
      cursor: pointer;
      text-align: center;
    }
    #override-btn:hover { background: #ff0000; }

    /* ══════════════════════════════════════════════════════
       LIVE STREAM PANEL  — right column 260px
    ══════════════════════════════════════════════════════ */
    #stream-panel {
      display: flex;
      flex-direction: column;
      overflow: hidden;
      background: #111113;
      border-left: 1px solid #262626;
      height: calc(100vh - 48px);
    }
    #stream-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 7px 14px;
      border-bottom: 1px solid #262626;
      flex-shrink: 0;
      background: #131313;
    }
    .stream-header-left {
      display: flex;
      align-items: center;
      gap: 8px;
      min-width: 0;
      overflow: hidden;
      white-space: nowrap;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #e5e2e1;
    }
    .stream-live-sq {
      width: 7px;
      height: 7px;
      background: #cc0000;
      flex-shrink: 0;
      animation: stream-live-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    @keyframes stream-live-pulse {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0.25; }
    }
    .stream-header-right {
      flex-shrink: 0;
      white-space: nowrap;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #a1a1a1;
    }
    #stream-body {
      flex: 1;
      overflow-y: auto;
      padding: 8px 14px;
      display: flex;
      flex-direction: column;
      gap: 1px;
    }
    /* Log lines wrap instead of being clipped: a real backend error carries
       a full API URL and used to disappear past the panel edge. */
    .stream-line {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      line-height: 1.6;
      color: #a1a1a1;
      letter-spacing: 0.04em;
      white-space: normal;
      overflow-wrap: anywhere;
      word-break: break-word;
      display: flex;
      gap: 8px;
      align-items: flex-start;
    }
    .stream-line .ln       { color: #3a3a3a; min-width: 10px; flex-shrink: 0; }
    .stream-line .ln-critical { color: #cc0000; font-weight: 700; }
    .stream-line .ev-tr    { font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; line-height: 1.6; letter-spacing: 0.04em; color: #a1a1a1; min-width: 0; overflow-wrap: anywhere; }
    .stream-line .ev-cr    { font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; line-height: 1.6; letter-spacing: 0.04em; color: #cc0000; font-weight: 700; min-width: 0; overflow-wrap: anywhere; }
    .stream-line .ev-kw { color: #e5e2e1; }

    /* Scrollbar */
    #stream-body::-webkit-scrollbar { width: 3px; }
    #stream-body::-webkit-scrollbar-track { background: #0e0e0e; }
    #stream-body::-webkit-scrollbar-thumb { background: #262626; }

    /* ── Global custom scrollbar (terminal feel) ──────────── */
    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-track { background: #0e0e0e; }
    ::-webkit-scrollbar-thumb { background: #353535; }
    ::-webkit-scrollbar-thumb:hover { background: #cc0000; }

    /* ── Page title glitch ────────────────────────────────── */
    .page-title {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 1.6rem;
      color: #e5e2e1;
      line-height: 1;
      margin: 0;
      animation: glitch-title 5s infinite;
    }
    @keyframes glitch-title {
      0%,  97%, 100% { transform: translate(0); }
      98%             { transform: translate(-1px, 1px); }
      99%             { transform: translate(1px, -1px); }
    }

    /* ── SVG node pulse ───────────────────────────────────── */
    .node-pulse {
      animation: node-pulse-anim 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    @keyframes node-pulse-anim {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0.3; }
    }

    /* ── Conflict map callout boxes ───────────────────────── */
    .conflict-callout {
      position: absolute;
      padding: 6px 10px;
      background: rgba(13, 13, 13, 0.85);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      z-index: 10;
      cursor: crosshair;
    }
    .conflict-callout.active-branch { border: 1px solid #cc0000; }
    .conflict-callout.passive-branch { border: 1px solid #262626; }
    .callout-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #cc0000;
      margin-bottom: 3px;
    }
    .callout-label.muted { color: #a1a1a1; }
    .callout-hash {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.55rem;
      color: #5e3f3a;
    }
    .callout-underline {
      width: 48px;
      height: 1px;
      background: #cc0000;
      margin-top: 6px;
    }
    .callout-underline.muted { background: #262626; }

    /* ── Graph state overlay (real status, not fake data) ─── */
    #graph-state {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-align: center;
      pointer-events: none;
      z-index: 5;
    }
    #graph-state[hidden] { display: none; }
    .graph-state-code {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.2em;
      color: #a1a1a1;
    }
    #graph-state[data-tone='error'] .graph-state-code    { color: #cc0000; }
    #graph-state[data-tone='pending'] .graph-state-code  { color: #ffb4a8; }
    #graph-state[data-tone='muted'] .graph-state-code    { color: #a1a1a1; }
    .graph-state-msg {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      color: #3a3a3a;
      max-width: 72%;
    }

    /* ── Scanline overlay ─────────────────────────────────── */
    #scanline-overlay {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 999;
      overflow: hidden;
      opacity: 0.03;
    }
    #scanline-bar {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 2px;
      background: #ffb4a8;
      animation: scanline 4s linear infinite;
    }
    @keyframes scanline {
      from { top: 0; }
      to   { top: 100%; }
    }
  </style>
</head>
<body>

  <!-- ════════════════════════════════════════════════════════
       TOP NAVBAR
  ═════════════════════════════════════════════════════════ -->
  <nav id="navbar" aria-label="Dashboard navigation">

    <!-- GLYPH brand -->
    <div id="nav-brand">
      <a href="/" aria-label="Return to GLYPH home">GLYPH</a>
    </div>

    <!-- Search -->
    <div id="nav-search" role="search">
      <input
        type="search"
        placeholder="LOCATE_ENTITY..."
        autocomplete="off"
        spellcheck="false"
        aria-label="Locate entity in repository graph"
      />
    </div>

    <!-- Right icon buttons -->
    <div id="nav-actions" aria-label="Dashboard actions">
      <!-- Contributors -->
      <button class="nav-icon-btn" aria-label="View contributors" title="Contributors">
        <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
          <circle cx="5" cy="4" r="2" stroke="currentColor" stroke-width="1"/>
          <circle cx="9" cy="4" r="2" stroke="currentColor" stroke-width="1"/>
          <path d="M1 11c0-2 1.8-3 4-3s4 1 4 3" stroke="currentColor" stroke-width="1" fill="none"/>
          <path d="M9 8c1.5 0 3 0.8 3 3" stroke="currentColor" stroke-width="1" fill="none"/>
        </svg>
      </button>
      <!-- Issues -->
      <button class="nav-icon-btn" aria-label="View issues" title="Issues">
        <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
          <rect x="1" y="1" width="11" height="11" stroke="currentColor" stroke-width="1"/>
          <line x1="6.5" y1="4" x2="6.5" y2="7" stroke="currentColor" stroke-width="1.2"/>
          <rect x="6" y="8.5" width="1" height="1" fill="currentColor"/>
        </svg>
      </button>
      <!-- Network -->
      <button class="nav-icon-btn" aria-label="View network graph" title="Network">
        <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
          <rect x="5.5" y="0.5" width="2" height="2" fill="currentColor"/>
          <rect x="0.5" y="5.5" width="2" height="2" fill="currentColor"/>
          <rect x="10.5" y="5.5" width="2" height="2" fill="currentColor"/>
          <rect x="5.5" y="10.5" width="2" height="2" fill="currentColor"/>
          <line x1="6.5" y1="2.5" x2="6.5" y2="5.5" stroke="currentColor" stroke-width="1"/>
          <line x1="2.5" y1="6.5" x2="5.5" y2="6.5" stroke="currentColor" stroke-width="1"/>
          <line x1="7.5" y1="6.5" x2="10.5" y2="6.5" stroke="currentColor" stroke-width="1"/>
          <line x1="6.5" y1="7.5" x2="6.5" y2="10.5" stroke="currentColor" stroke-width="1"/>
        </svg>
      </button>
    </div>
  </nav>

  <!-- ════════════════════════════════════════════════════════
       LAYOUT
  ═════════════════════════════════════════════════════════ -->
  <div id="layout">

    <!-- ── LEFT SIDEBAR ─────────────────────────────────── -->
    <aside id="sidebar" aria-label="Navigation sidebar">
      <nav class="sidebar-nav" aria-label="Analysis sections">

        <a class="nav-item active" href={`/repo/${id}`} aria-label="Terminal" aria-current="page">
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M2 3l3 2-3 2" stroke="currentColor" stroke-width="1.2" fill="none"/>
            <line x1="6" y1="7" x2="8" y2="7" stroke="currentColor" stroke-width="1.2"/>
          </svg>
          TERMINAL
        </a>

        <a class="nav-item" href={`/repo/${id}/decisions`} aria-label="Decisions">
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M2 5l2 2 4-4" stroke="currentColor" stroke-width="1.2" fill="none"/>
          </svg>
          DECISIONS
        </a>

        <a class="nav-item" href={`/repo/${id}/debates`} aria-label="Debates">
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <rect x="1" y="2" width="5" height="4" stroke="currentColor" stroke-width="1" fill="none"/>
            <path d="M4 6v1.5l2.5-1.5H9V4H7" stroke="currentColor" stroke-width="1" fill="none"/>
          </svg>
          DEBATES
        </a>

        <a class="nav-item" href={`/repo/${id}/rejections`} aria-label="Rejections">
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <line x1="1" y1="1" x2="9" y2="9" stroke="currentColor" stroke-width="1.2"/>
            <line x1="9" y1="1" x2="1" y2="9" stroke="currentColor" stroke-width="1.2"/>
          </svg>
          REJECTIONS
        </a>

        <a class="nav-item" href={`/repo/${id}/contributors`} aria-label="Contributors">
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <circle cx="3.5" cy="3" r="1.5" stroke="currentColor" stroke-width="1"/>
            <path d="M1 8.5c0-1.5 1-2.5 2.5-2.5s2.5 1 2.5 2.5" stroke="currentColor" stroke-width="1" fill="none"/>
            <circle cx="7" cy="3" r="1.5" stroke="currentColor" stroke-width="1"/>
            <path d="M5.5 8.5c0-1.5 1-2.5 2.5-2.5s2.5 1 2.5 2.5" stroke="currentColor" stroke-width="1" fill="none"/>
          </svg>
          CONTRIBUTORS
        </a>

        <a class="nav-item" href={`/repo/${id}/summary`} aria-label="Summary">
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <rect x="2" y="1" width="6" height="8" stroke="currentColor" stroke-width="1" fill="none"/>
            <line x1="3.5" y1="3.5" x2="6.5" y2="3.5" stroke="currentColor" stroke-width="0.8"/>
            <line x1="3.5" y1="5" x2="7.5" y2="5" stroke="currentColor" stroke-width="0.8"/>
            <line x1="3.5" y1="6.5" x2="5.5" y2="6.5" stroke="currentColor" stroke-width="0.8"/>
          </svg>
          SUMMARY
        </a>

      </nav>

      <div class="sidebar-footer">
        <button id="execute-fetch" type="button" aria-label="Execute fetch — trigger repository analysis">
          EXECUTE_FETCH
        </button>
        <div class="sidebar-util-row">
          <button id="sys-log-btn" class="util-btn" aria-label="Open system log">
            <svg width="8" height="8" viewBox="0 0 8 8" fill="none" aria-hidden="true">
              <rect x="0" y="0" width="8" height="8" stroke="currentColor" stroke-width="1" fill="none"/>
              <line x1="1.5" y1="2.5" x2="6.5" y2="2.5" stroke="currentColor" stroke-width="0.8"/>
              <line x1="1.5" y1="4" x2="6.5" y2="4" stroke="currentColor" stroke-width="0.8"/>
              <line x1="1.5" y1="5.5" x2="4.5" y2="5.5" stroke="currentColor" stroke-width="0.8"/>
            </svg>
            SYS_LOG
          </button>
          <button id="terminate-btn" class="util-btn" aria-label="Terminate session">
            <svg width="8" height="8" viewBox="0 0 8 8" fill="none" aria-hidden="true">
              <line x1="1" y1="1" x2="7" y2="7" stroke="currentColor" stroke-width="1"/>
              <line x1="7" y1="1" x2="1" y2="7" stroke="currentColor" stroke-width="1"/>
            </svg>
            TERMINATE
          </button>
          <button id="export-btn" class="util-btn" aria-label="Export full analysis report (JSON + Markdown)">
            <svg width="8" height="8" viewBox="0 0 8 8" fill="none" aria-hidden="true">
              <line x1="4" y1="0" x2="4" y2="5" stroke="currentColor" stroke-width="1"/>
              <line x1="1.5" y1="3" x2="4" y2="5.5" stroke="currentColor" stroke-width="1"/>
              <line x1="6.5" y1="3" x2="4" y2="5.5" stroke="currentColor" stroke-width="1"/>
              <line x1="0" y1="7" x2="8" y2="7" stroke="currentColor" stroke-width="1"/>
            </svg>
            EXPORT
          </button>
        </div>
      </div>
    </aside>

    <!-- ── MAIN AREA ─────────────────────────────────────── -->
    <div id="main-area">

      <!-- Page header -->
      <header id="page-header">
        <div id="page-header-left">
          <!-- The state word tracks the real job status (see the status
               poller below). Hardcoding "ACTIVE" made a failed job's header
               contradict its own STATUS: FAILED readout. -->
          <h1 class="page-title">SYSTEM RECONSTRUCTION: <span id="recon-state" style="color:#cc0000;">{IS_UUID ? 'CONNECTING' : 'ACTIVE'}</span></h1>
          <p class="page-context" data-repo-context>THREAD CONTEXT: {repoContext}</p>
        </div>
        <div id="page-header-right">
          <span class="uptime">UPTIME: <span id="uptime-val">00:00:00:00</span></span>
          <span class="heartbeat">STATUS: <span class="heartbeat-status" id="heartbeat-val">HEARTBEAT_STABLE</span></span>
        </div>
      </header>

      <!-- Content grid -->
      <div id="content-grid">

        <!-- ── DECISION GRAPH ──────────────────────────── -->
        <section id="graph-panel" aria-labelledby="graph-header-label">
          <div class="panel-header">
            <span class="panel-header-left" id="graph-header-label">
              MAP_OVERLAY_01
              <span class="panel-header-sep">//</span>
              DECISION_GRAPH
            </span>
            <span class="panel-header-right" id="graph-stats">
              NODES: <span id="node-count">0</span>&nbsp;&nbsp;DENSITY: <span id="graph-density">0</span>%
            </span>
          </div>
          <div id="graph-container" role="img" aria-label="Interactive decision graph">
            <svg id="graph-svg" aria-hidden="true"></svg>

            <!-- Conflict callouts — decorative demo chrome, never on real jobs -->
            {!IS_UUID && (
              <>
                <div class="conflict-callout active-branch" style="top:25%;left:30%;" aria-hidden="true">
                  <div class="callout-label">BRANCH_A // KERNEL</div>
                  <div class="callout-hash">H_HASH: 0x9f22...</div>
                  <div class="callout-underline"></div>
                </div>
                <div class="conflict-callout passive-branch" style="bottom:30%;right:22%;" aria-hidden="true">
                  <div class="callout-label muted">BRANCH_B // USER_AUTH</div>
                  <div class="callout-hash">H_HASH: 0xc41b...</div>
                  <div class="callout-underline muted"></div>
                </div>

                <!-- SVG connection between callouts -->
                <svg style="position:absolute;inset:0;width:100%;height:100%;opacity:0.3;pointer-events:none;" aria-hidden="true">
                  <line x1="33%" y1="25%" x2="75%" y2="66%" stroke="#cc0000" stroke-width="1" stroke-dasharray="4"/>
                  <circle class="node-pulse" cx="33%" cy="25%" r="3" fill="#cc0000"/>
                  <circle cx="75%" cy="66%" r="3" fill="#cc0000"/>
                </svg>
              </>
            )}

            {!IS_UUID && (
              <div id="graph-pagination" aria-label="Graph layer controls" role="group">
                <div class="page-dot active" role="button" tabindex="0" aria-label="Layer 1" aria-pressed="true"></div>
                <div class="page-dot" role="button" tabindex="0" aria-label="Layer 2" aria-pressed="false"></div>
                <div class="page-dot" role="button" tabindex="0" aria-label="Layer 3" aria-pressed="false"></div>
              </div>
            )}

            <!-- Real status overlay — replaces demo data on failure/empty/pending -->
            <div id="graph-state" hidden aria-live="polite">
              <span id="graph-state-code" class="graph-state-code"></span>
              <span id="graph-state-msg" class="graph-state-msg"></span>
            </div>
          </div>
        </section>

        <!-- ── INTELLIGENCE SIDEBAR ────────────────────── -->
        <aside id="intel-panel" aria-label="Intelligence analysis">

          {IS_UUID ? (
            <>
              <!-- Graph metrics (hydrated from GET /graph) -->
              <div class="intel-section">
                <span class="intel-label">GRAPH_METRICS</span>

                <div class="metric-row" role="group" aria-label="Total intent nodes">
                  <div class="metric-header">
                    <span class="metric-name">NODES_TOTAL</span>
                    <span class="metric-pct" id="intel-nodes">—</span>
                  </div>
                  <div class="metric-bar-track" aria-hidden="true">
                    <div class="metric-bar-fill" id="intel-nodes-fill" style="width:0%"></div>
                  </div>
                </div>

                <div class="metric-row" role="group" aria-label="Graph link count">
                  <div class="metric-header">
                    <span class="metric-name">LINK_COUNT</span>
                    <span class="metric-pct" id="intel-links">—</span>
                  </div>
                  <div class="metric-bar-track" aria-hidden="true">
                    <div class="metric-bar-fill" id="intel-links-fill" style="width:0%"></div>
                  </div>
                </div>

                <div class="metric-row" role="group" aria-label="Graph density">
                  <div class="metric-header">
                    <span class="metric-name">DENSITY</span>
                    <span class="metric-pct" id="intel-density">—</span>
                  </div>
                  <div class="metric-bar-track" aria-hidden="true">
                    <div class="metric-bar-fill" id="intel-density-fill" style="width:0%"></div>
                  </div>
                </div>
              </div>

              <!-- Forecast: honest until graph data arrives -->
              <div class="intel-section">
                <span class="intel-label">NEURAL_FORECAST</span>
                <p class="forecast-body" id="forecast-body">
                  AWAITING GRAPH DATA…
                </p>
              </div>
            </>
          ) : (
            <>
              <!-- Probability matrix -->
              <div class="intel-section">
                <span class="intel-label">PROBABILITY_MATRIX_X</span>

                <div class="metric-row" role="group" aria-label="Reconstruction success metric">
                  <div class="metric-header">
                    <span class="metric-name">RECONSTRUCTION_SUCCESS</span>
                    <span class="metric-pct">82.4%</span>
                  </div>
                  <div class="metric-bar-track" aria-hidden="true">
                    <div class="metric-bar-fill" style="width:82.4%"></div>
                  </div>
                </div>

                <div class="metric-row" role="group" aria-label="Intent confidence metric">
                  <div class="metric-header">
                    <span class="metric-name">INTENT_CONFIDENCE</span>
                    <span class="metric-pct">14.1%</span>
                  </div>
                  <div class="metric-bar-track" aria-hidden="true">
                    <div class="metric-bar-fill" style="width:14.1%"></div>
                  </div>
                </div>

                <div class="metric-row" role="group" aria-label="Debate entropy metric">
                  <div class="metric-header">
                    <span class="metric-name">DEBATE_ENTROPY</span>
                    <span class="metric-pct">3.5%</span>
                  </div>
                  <div class="metric-bar-track" aria-hidden="true">
                    <div class="metric-bar-fill" style="width:3.5%"></div>
                  </div>
                </div>
              </div>

              <!-- Neural forecast -->
              <div class="intel-section">
                <span class="intel-label">NEURAL_FORECAST</span>
                <p class="forecast-body">
                  PREDICTION: ARCHITECTURAL CONFLICT IN 'AUTH_MODULE' IS UNRESOLVABLE VIA AUTOMATED INFERENCE.
                  MANUAL REVIEW SUGGESTED AT COMMIT <span class="sha-inline">0xf3a91c2</span>.
                </p>
                <button id="override-btn" type="button" aria-label="Initialize manual override for architectural conflict">
                  INITIALIZE_OVERRIDE
                </button>
              </div>
            </>
          )}

        </aside>

      </div><!-- /content-grid -->
    </div><!-- /main-area -->

    <!-- ── LIVE RECON STREAM (right column) ─────────────── -->
    <section id="stream-panel" aria-labelledby="stream-header-label">
      <div id="stream-header">
        <div class="stream-header-left" id="stream-header-label">
          <span class="stream-live-sq" aria-hidden="true"></span>
          LIVE_RECON_STREAM
          <span style="color:#5e3f3a;">//</span>
          STDOUT
        </div>
        <!-- Was "FILTER: ALL_EVENTS", which implied a filter control that
             does not exist. Name the real source of these lines instead. -->
        <span class="stream-header-right">/status</span>
      </div>
      <div id="stream-body" role="log" aria-label="Live intelligence stream output" aria-live="polite">
        <!-- Seed lines — rendered server-side, JS appends more -->
        <div class="stream-line"><span class="ln">#</span><span class="ev-tr">TRACE: Heartbeat confirmed by <span class="ev-kw">CHARCOAL_CORE</span></span></div>
        <div class="stream-line"><span class="ln">#</span><span class="ev-tr">TRACE: GitHub ingestion synchronized @ <span class="ev-kw">400ms</span></span></div>
        <div class="stream-line"><span class="ln">#</span><span class="ev-tr">TRACE: Parity check starting on <span class="ev-kw">repo_main</span></span></div>
        <div class="stream-line"><span class="ln" style="color:#cc0000;font-weight:700;">1</span><span class="ev-cr">CRITICAL: DEBATE CLUSTER DETECTED IN PR <span class="ev-kw">#442</span></span></div>
        <div class="stream-line"><span class="ln">#</span><span class="ev-tr">TRACE: Analyzing decision chain: <span class="ev-kw">branch_main</span> v <span class="ev-kw">branch_experimental</span></span></div>
        <div class="stream-line"><span class="ln">#</span><span class="ev-tr">TRACE: Extracting contributor reasoning profiles...</span></div>
        <div class="stream-line"><span class="ln">#</span><span class="ev-tr">TRACE: Intent node written — <span class="ev-kw">ARCHITECTURAL_DECISION_007</span></span></div>
        <div class="stream-line"><span class="ln">#</span><span class="ev-tr">TRACE: Rejection record flagged — <span class="ev-kw">ABANDONED_FEATURE_012</span></span></div>
        <div class="stream-line"><span class="ln">#</span><span class="ev-tr">TRACE: Analyzing merge conflict: <span class="ev-kw">branch_main</span> v <span class="ev-kw">branch_dev</span></span></div>
      </div>
    </section>
  </div><!-- /layout -->

  <!-- ════════════════════════════════════════════════════════
       SCRIPTS
  ═════════════════════════════════════════════════════════ -->
  <script>
    // ── Uptime counter ────────────────────────────────────
    (function initUptime() {
      var el = document.getElementById('uptime-val');
      var hb = document.getElementById('heartbeat-val');
      var t0 = Date.now();

      function pad(n, d) { if (d === undefined) d = 2; return String(n).padStart(d, '0'); }

      function tick() {
        var ms  = Date.now() - t0;
        var s   = Math.floor(ms / 1000);
        var m   = Math.floor(s / 60);
        var h   = Math.floor(m / 60);
        var d   = Math.floor(h / 24);
        el.textContent = pad(d) + ':' + pad(h % 24) + ':' + pad(m % 60) + ':' + pad(s % 60);
        requestAnimationFrame(tick);
      }
      tick();

      // Heartbeat pulse: fake toggle ONLY in demo mode (no real job id).
      // Real jobs get their status from /status polling — a fake toggler here
      // would fight the live value and make the heartbeat flicker.
      var currentId = window.location.pathname.split('/').filter(Boolean).pop() || '';
      var isRealJob = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(currentId);
      if (!isRealJob) {
        var hbToggle = false;
        setInterval(function () {
          hbToggle = !hbToggle;
          hb.textContent = hbToggle ? 'HEARTBEAT_STABLE' : 'HEARTBEAT_OK';
        }, 2000);
      } else {
        // The seeded HEARTBEAT_STABLE is demo copy. On a real job it must not
        // stand as an assertion about a backend we have not heard from yet —
        // and it used to survive for ever when /status 404'd or the backend
        // was down. Say we are asking; the poller replaces this with the
        // real status, or with why it could not get one.
        hb.textContent = 'QUERYING';
      }
    })();

    // ── Sidebar nav ───────────────────────────────────────
    (function initSidebarNav() {
      const current = window.location.pathname.replace(/\/+$/, '');
      document.querySelectorAll('.nav-item').forEach(function (a) {
        var href = a.getAttribute('href');
        if (href && (current === href || current.startsWith(href + '/'))) {
          a.classList.add('active');
          a.setAttribute('aria-current', 'page');
        }
      });
    })();

    // ── Execute fetch ─────────────────────────────────────
    (function initExecuteFetch() {
      var btn      = document.getElementById('execute-fetch');
      var API_BASE = (import.meta.env && import.meta.env.PUBLIC_API_BASE_URL) || (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1' ? 'http://localhost:8000' : 'https://glyph-api-qh9i.onrender.com');

      function getKeys() {
        return {
          github: sessionStorage.getItem('glyph_gh_token') || '',
          nim:    sessionStorage.getItem('glyph_nim_key')  || '',
        };
      }

      btn.addEventListener('click', async function () {
        var keys = getKeys();
        if (!keys.github || !keys.nim) {
          btn.textContent = 'KEYS_MISSING';
          setTimeout(function () { btn.textContent = 'EXECUTE_FETCH'; }, 2000);
          return;
        }

        var coordEl  = document.querySelector('#page-header-left .page-context');
        var raw      = (coordEl && coordEl.textContent) || '';
        var slug     = raw.replace('THREAD CONTEXT:', '').replace('_ANALYSIS', '').trim()
                           .replace(/_/g, '/').toLowerCase();

        btn.textContent = 'FETCHING...';
        btn.disabled    = true;

        try {
          var resp = await fetch(API_BASE + '/api/analyze', {
            method:  'POST',
            headers: {
              'Content-Type':   'application/json',
              'X-Github-Token': keys.github,
              'X-Nim-Api-Key':  keys.nim,
            },
            body: JSON.stringify({ repo_url: 'https://github.com/' + slug }),
          });

          var data = await resp.json();
          if (!resp.ok) throw new Error(data.error || 'HTTP ' + resp.status);

          btn.textContent = 'RUNNING...';

          var pollInterval = setInterval(async function () {
            try {
              var sr = await fetch(API_BASE + '/api/repo/' + data.job_id + '/status');
              var sd = await sr.json();
              if (sd.status === 'complete' || sd.status === 'failed') {
                clearInterval(pollInterval);
                btn.disabled    = false;
                btn.textContent = sd.status === 'complete' ? 'COMPLETE \u2713' : 'FAILED \u2717';
                setTimeout(function () { btn.textContent = 'EXECUTE_FETCH'; }, 3000);
              }
            } catch (_) {
              clearInterval(pollInterval);
              btn.disabled    = false;
              btn.textContent = 'EXECUTE_FETCH';
            }
          }, 4000);
        } catch (err) {
          btn.disabled    = false;
          btn.textContent = 'ERROR';
          setTimeout(function () { btn.textContent = 'EXECUTE_FETCH'; }, 2000);
        }
      });
    })();

    // ── SYS_LOG btn ───────────────────────────────────────
    (function initSysLog() {
      var btn = document.getElementById('sys-log-btn');
      var API_BASE = (import.meta.env && import.meta.env.PUBLIC_API_BASE_URL) || (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1' ? 'http://localhost:8000' : 'https://glyph-api-qh9i.onrender.com');
      var pathParts = window.location.pathname.split('/').filter(Boolean);
      var repoId = pathParts[pathParts.length - 1];

      btn.addEventListener('click', async function () {
        btn.textContent = 'FETCHING_LOG...';
        try {
          var resp = await fetch(API_BASE + '/api/repo/' + repoId + '/status');
          if (!resp.ok) throw new Error('HTTP ' + resp.status);
          var data = await resp.json();
          btn.textContent = (data.status || 'OK').toUpperCase();
        } catch (err) {
          btn.textContent = 'LOG_FAIL';
        }
        setTimeout(function () { btn.textContent = 'SYS_LOG'; }, 3000);
      });
    })();

    // ── TERMINATE btn ─────────────────────────────────────
    // POST /api/repo/:id/terminate — flips the backend cancel flag; the job
    // stops at its next checkpoint and records status "terminated".
    (function initTerminate() {
      var btn = document.getElementById('terminate-btn');
      var API_BASE = (import.meta.env && import.meta.env.PUBLIC_API_BASE_URL) || (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1' ? 'http://localhost:8000' : 'https://glyph-api-qh9i.onrender.com');
      var pathParts = window.location.pathname.split('/').filter(Boolean);
      var repoId = pathParts[pathParts.length - 1];

      btn.addEventListener('click', async function () {
        btn.textContent = 'TERMINATING...';
        btn.disabled = true;
        try {
          var resp = await fetch(API_BASE + '/api/repo/' + repoId + '/terminate', {
            method: 'POST',
          });
          if (!resp.ok) throw new Error('HTTP ' + resp.status);
          btn.textContent = 'TERMINATED ✗';

          var hb = document.getElementById('heartbeat-val');
          if (hb) hb.textContent = 'TERMINATED';

          // Surface the event in the recon stream immediately.
          if (window.__glyphAppendStream) {
            window.__glyphAppendStream('critical', 'ANALYSIS TERMINATED BY OPERATOR');
          }
        } catch (err) {
          btn.textContent = 'TERM_FAIL';
        }
        btn.disabled = false;
        setTimeout(function () { btn.textContent = 'TERMINATE'; }, 4000);
      });
    })();

    // ── EXPORT btn ────────────────────────────────────────
    // Bundles every analysis endpoint into a single JSON report + a
    // human-readable Markdown brief, downloaded client-side. No keys leave
    // the browser beyond the normal per-request BYOK headers.
    (function initExport() {
      var btn = document.getElementById('export-btn');
      var API_BASE = (import.meta.env && import.meta.env.PUBLIC_API_BASE_URL) || (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1' ? 'http://localhost:8000' : 'https://glyph-api-qh9i.onrender.com');
      var pathParts = window.location.pathname.split('/').filter(Boolean);
      var repoId = pathParts[pathParts.length - 1];
      var IS_UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

      btn.addEventListener('click', async function () {
        // Demo/slug URLs are not backed by a real analysis — refuse honestly.
        if (!IS_UUID.test(repoId)) {
          btn.textContent = 'NO_DATA';
          setTimeout(function () { btn.textContent = 'EXPORT'; }, 3000);
          return;
        }

        btn.textContent = 'EXPORTING...';
        btn.disabled = true;

        function getJson(path) {
          return fetch(API_BASE + path).then(function (r) {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            return r.json();
          });
        }

        try {
          var [status, decisions, debates, rejections, contributors, graph] = await Promise.all([
            getJson('/api/repo/' + repoId + '/status'),
            getJson('/api/repo/' + repoId + '/decisions'),
            getJson('/api/repo/' + repoId + '/debates'),
            getJson('/api/repo/' + repoId + '/rejections'),
            getJson('/api/repo/' + repoId + '/contributors'),
            getJson('/api/repo/' + repoId + '/graph'),
          ]);

          // Summary is NIM-generated and needs the BYOK key; include it when available.
          var summary = null;
          try {
            var nimKey = sessionStorage.getItem('glyph_nim_key') || '';
            var sResp  = await fetch(API_BASE + '/api/repo/' + repoId + '/summary', {
              headers: nimKey ? { 'X-Nim-Api-Key': nimKey } : {},
            });
            if (sResp.ok) summary = await sResp.json();
          } catch (_) { /* optional — omit from report */ }

          var report = {
            glyph_version: '1.0.0',
            exported_at: new Date().toISOString(),
            repo: { id: repoId },
            status: status,
            summary: summary,
            decisions: decisions.decisions || [],
            debates: debates.debates || [],
            debates_metrics: debates.metrics || null,
            rejections: rejections.rejections || [],
            contributors: contributors.contributors || [],
            graph: graph,
          };

          // ── Download JSON ────────────────────────────────
          var jsonBlob = new Blob([JSON.stringify(report, null, 2)], { type: 'application/json' });
          var a = document.createElement('a');
          a.href = URL.createObjectURL(jsonBlob);
          a.download = 'glyph-report-' + repoId + '.json';
          a.click();
          URL.revokeObjectURL(a.href);

          // ── Build Markdown brief ─────────────────────────
          var md = [];
          md.push('# GLYPH Analysis Report');
          md.push('');
          md.push('- **Repository ID:** `' + repoId + '`');
          md.push('- **Status:** ' + (status.status || 'unknown').toUpperCase());
          if (status.stage) md.push('- **Stage:** ' + status.stage);
          if (status.analyzed_at) md.push('- **Analyzed:** ' + String(status.analyzed_at).replace('T', ' ').replace('Z', ''));
          if (status.error_message) md.push('- **Error:** ' + status.error_message);
          md.push('');
          if (summary && summary.narrative) {
            md.push('## Narrative Summary');
            md.push('');
            md.push(summary.narrative);
            md.push('');
          }
          if ((decisions.decisions || []).length) {
            md.push('## Decisions (' + decisions.decisions.length + ')');
            md.push('');
            decisions.decisions.forEach(function (d) {
              md.push('- **' + (d.title || 'UNTITLED') + '** — ' + (d.summary || '') +
                (d.confidence === null || d.confidence === undefined
                  ? ' (confidence not rated)'
                  : ' (confidence ' + Math.round(d.confidence * 100) + '%)'));
            });
            md.push('');
          }
          if ((debates.debates || []).length) {
            md.push('## Debates (' + debates.debates.length + ')');
            md.push('');
            debates.debates.forEach(function (d) {
              md.push('- **' + (d.title || 'UNTITLED') + '** — ' + (d.summary || '') +
                ' (contributors: ' + (Array.isArray(d.contributors) ? d.contributors.join(', ') : 'n/a') + ')');
            });
            md.push('');
          }
          if ((rejections.rejections || []).length) {
            md.push('## Rejections (' + rejections.rejections.length + ')');
            md.push('');
            rejections.rejections.forEach(function (r) {
              md.push('- **' + (r.title || 'UNTITLED') + '** — ' + (r.reasoning || r.summary || ''));
            });
            md.push('');
          }
          if ((contributors.contributors || []).length) {
            md.push('## Contributors (' + contributors.contributors.length + ')');
            md.push('');
            contributors.contributors.forEach(function (c) {
              md.push('- @' + c.handle + ' — ' + c.decisions + ' decisions, ' + c.debates +
                ' debates, ' + c.rejections + ' rejections' +
                (c.avg_confidence === null || c.avg_confidence === undefined
                  ? ''
                  : ' (avg confidence ' + c.avg_confidence + '%)'));
            });
            md.push('');
          }
          if (graph && graph.meta) {
            md.push('## Graph');
            md.push('');
            md.push('- Nodes: ' + graph.meta.total_nodes + ' · Links: ' + graph.meta.total_links + ' · Density: ' + graph.meta.density_pct + '%');
          }

          var mdBlob = new Blob([md.join('\n')], { type: 'text/markdown' });
          var m = document.createElement('a');
          m.href = URL.createObjectURL(mdBlob);
          m.download = 'glyph-report-' + repoId + '.md';
          m.click();
          URL.revokeObjectURL(m.href);

          btn.textContent = 'EXPORTED ✓';
          if (window.__glyphAppendStream) {
            window.__glyphAppendStream('info', 'Report exported — JSON + Markdown');
          }
        } catch (err) {
          btn.textContent = 'EXPORT_FAIL';
          if (window.__glyphAppendStream) {
            window.__glyphAppendStream('critical', 'REPORT EXPORT FAILED — ' + String(err.message || err));
          }
        }
        btn.disabled = false;
        setTimeout(function () { btn.textContent = 'EXPORT'; }, 5000);
      });
    })();

    // ── Override btn (demo-only; absent on real UUID jobs) ──
    (function initOverride() {
      var btn = document.getElementById('override-btn');
      if (!btn) return;
      btn.addEventListener('click', function () {
        btn.textContent = 'OVERRIDE_QUEUED';
        setTimeout(function () { btn.textContent = 'INITIALIZE_OVERRIDE'; }, 3000);
      });
    })();

    // ── Live recon stream — real status/stage driven ───────
    (function initStream() {
      var body = document.getElementById('stream-body');
      var API_BASE = (import.meta.env && import.meta.env.PUBLIC_API_BASE_URL) || (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1' ? 'http://localhost:8000' : 'https://glyph-api-qh9i.onrender.com');
      var pathParts = window.location.pathname.split('/').filter(Boolean);
      var repoId = pathParts[pathParts.length - 1];
      var uuidRe = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

      // Shared append — also used by the terminate handler.
      function appendLine(level, text) {
        var line = document.createElement('div');
        line.className = 'stream-line';
        if (level === 'critical') {
          line.innerHTML = '<span class="ln" style="color:#cc0000;font-weight:700;">!</span><span class="ev-cr">CRITICAL: ' + text + '</span>';
        } else {
          line.innerHTML = '<span class="ln">#</span><span class="ev-tr">TRACE: ' + text + '</span>';
        }
        body.appendChild(line);
        body.scrollTop = body.scrollHeight;
        while (body.children.length > 60) body.removeChild(body.firstChild);
      }
      window.__glyphAppendStream = appendLine;

      // Demo mode (no UUID in the URL): leave the server-seeded lines as-is.
      if (!uuidRe.test(repoId)) return;

      // Real job: drop the canned seed lines — everything below is genuine.
      body.innerHTML = '';

      var stageLabels = {
        'queued':                    'Job queued — waiting for scheduler',
        'ingesting_commits':         'Ingesting commit graph from GitHub API',
        'ingesting_pull_requests':   'Ingesting pull request history',
        'ingesting_issues':          'Ingesting issue tracker',
        'ingesting_review_threads':  'Pulling PR reviews & comment threads (debate evidence)',
        'extracting_intent':         'Running NIM intent extraction over event timeline',
        'idle':                      'Analysis complete — idle',
      };

      var lastStatus = null;
      var lastStage  = null;
      var lastNodes  = null;

      // Polling has to end. A 404 means this job id does not exist, so no
      // number of retries will help; a network error may clear, but only a
      // bounded number of attempts is worth making. Without these the page
      // hit /status every 3s for the life of the tab — silently, since the
      // old code returned on failure without telling the viewer anything.
      var pollTimer  = null;
      var failures   = 0;
      var MAX_FAILURES = 5;

      function stopPolling() {
        if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
      }

      function setHeartbeat(text) {
        var hb = document.getElementById('heartbeat-val');
        if (hb) hb.textContent = text;
      }

      var TERMINAL = { complete: 1, idle: 1, failed: 1, terminated: 1 };

      async function poll() {
        try {
          var resp = await fetch(API_BASE + '/api/repo/' + repoId + '/status');
          if (resp.status === 404) {
            stopPolling();
            setHeartbeat('NOT_FOUND');
            appendLine('critical', 'Status unavailable — no analysis found for job <span class="ev-kw">' + repoId.slice(0, 8) + '</span>');
            return;
          }
          if (!resp.ok) {
            failures += 1;
            if (failures >= MAX_FAILURES) {
              stopPolling();
              setHeartbeat('UNREACHABLE');
              appendLine('critical', 'Backend returned no usable status ' + MAX_FAILURES + ' times — polling stopped');
            }
            return;
          }
          failures = 0;
          var data = await resp.json();
          var status = data.status || 'unknown';
          var stage  = data.stage  || '';

          // Name the repository. The URL is a bare UUID, so the header and
          // document title render "unknown/unknown" until /status tells us
          // which repository the job actually analysed.
          if (data.owner && data.name) {
            var slug = data.owner + '/' + data.name;
            var seededMeta = document.querySelector('meta[name="glyph-repo-slug"]');
            var seeded = seededMeta && seededMeta.getAttribute('content');
            if (seeded && document.title.indexOf(seeded) !== -1) {
              document.title = document.title.replace(seeded, slug);
            }
            document.querySelectorAll('[data-repo-context]').forEach(function (el) {
              el.textContent =
                ('THREAD CONTEXT: ' + data.owner + '_' + data.name + '_ANALYSIS').toUpperCase();
            });
          }

          var hb = document.getElementById('heartbeat-val');
          if (hb) hb.textContent = status.toUpperCase();

          // Keep the page title honest: the headline state must agree with
          // the status readout next to it.
          var reconState = document.getElementById('recon-state');
          if (reconState) {
            var STATE_WORD = {
              processing:  'ACTIVE',
              queued:      'QUEUED',
              complete:    'COMPLETE',
              idle:        'COMPLETE',
              failed:      'FAILED',
              terminated:  'TERMINATED',
            };
            var word = STATE_WORD[status] || status.toUpperCase();
            reconState.textContent = word;
            reconState.style.color =
              (status === 'failed' || status === 'terminated') ? '#cc0000'
              : (status === 'complete' || status === 'idle')   ? '#22d3ee'
              : '#cc0000';
          }

          if (status !== lastStatus) {
            lastStatus = status;
            if (status === 'complete') {
              appendLine('trace', 'Analysis complete — intent graph <span class="ev-kw">materialized</span>');
            } else if (status === 'failed') {
              appendLine('critical', 'Analysis failed: ' + (data.error_message || 'unknown error'));
            } else if (status === 'terminated') {
              appendLine('critical', 'Analysis terminated — partial data preserved');
            } else if (status === 'processing') {
              appendLine('trace', 'Analysis session started — job <span class="ev-kw">' + repoId.slice(0, 8) + '</span>');
            }
          }

          if (status === 'processing' && stage && stage !== lastStage) {
            lastStage = stage;
            appendLine('trace', (stageLabels[stage] || stage.replace(/_/g, ' ')) + ' …');
          }

          if (status === 'complete') {
            try {
              var g  = await fetch(API_BASE + '/api/repo/' + repoId + '/graph');
              var gd = await g.json();
              var n  = (gd.meta && gd.meta.total_nodes) || (gd.nodes && gd.nodes.length) || 0;
              if (n > 0 && n !== lastNodes) {
                lastNodes = n;
                appendLine('trace', 'Intent graph holds <span class="ev-kw">' + n + ' nodes</span>');
              }
            } catch (_) {}
          }

          // Terminal state: nothing further will change, so stop rather than
          // re-fetch /status (and /graph) every 3s for as long as the tab
          // stays open.
          if (TERMINAL[status]) stopPolling();
        } catch (_) {
          // Backend unreachable. Retry a few times — a cold start or a
          // dropped wifi frame recovers — then say so and stop. Staying
          // quiet here is what made a dead backend look like a slow one.
          failures += 1;
          if (failures >= MAX_FAILURES) {
            stopPolling();
            setHeartbeat('UNREACHABLE');
            appendLine('critical', 'Backend unreachable — status polling stopped after ' + MAX_FAILURES + ' attempts');
          }
        }
      }

      poll();
      pollTimer = setInterval(poll, 3000);
    })();
  </script>

  <!-- ── D3 Decision Graph ──────────────────────────────── -->
  <script>
    // d3 is bundled from node_modules rather than fetched from a CDN so the
    // graph still renders with no network (offline demo / bad venue wifi).
    import * as d3 from 'd3';
    // apiBase() owns the environment fallback. Hardcoding localhost:8000 here
    // made the deployed graph call the visitor's own machine and never render.
    import { apiBase } from '../../scripts/repo-view';

    const API_BASE = apiBase();

    // Extract job_id from the current URL path: /repo/:id
    const pathParts = window.location.pathname.split('/').filter(Boolean);
    const jobId     = pathParts[pathParts.length - 1];
    const uuidRe    = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

    const svg        = d3.select('#graph-svg');
    const contEl     = document.getElementById('graph-container');
    const stateEl    = document.getElementById('graph-state');
    const stateCode  = document.getElementById('graph-state-code');
    const stateMsg   = document.getElementById('graph-state-msg');

    const W = contEl?.offsetWidth  || 600;
    const H = contEl?.offsetHeight || 340;
    svg.attr('viewBox', `0 0 ${W} ${H}`);

    // ── Real state overlay ────────────────────────────────
    // Honest rendering: failed/terminated/empty jobs show a labeled state,
    // never a static demo graph masquerading as analysis output.
    function setGraphState(code, msg, tone) {
      if (!stateEl || !stateCode || !stateMsg) return;
      if (!msg) { stateEl.hidden = true; return; }
      stateEl.hidden = false;
      stateEl.setAttribute('data-tone', tone || 'muted');
      stateCode.textContent = code;
      stateMsg.textContent  = msg;
    }

    // ── Load graph, gated by job status ───────────────────
    async function loadGraph() {
      if (!uuidRe.test(jobId)) {
        return { kind: 'empty', code: 'NO_JOB', msg: 'No analysis session linked to this view.' };
      }

      // Consult status first — never paint fake data over a failure.
      let status = 'processing';
      let errorMsg = null;
      try {
        const s = await fetch(`${API_BASE}/api/repo/${jobId}/status`);
        if (s.status === 404) {
          return { kind: 'empty', code: 'NO_JOB', msg: 'No analysis exists for this job id.' };
        }
        if (s.ok) {
          const sd = await s.json();
          status   = sd.status ?? 'processing';
          errorMsg = sd.error_message ?? null;
        }
      } catch (_) { /* backend unreachable — attempt graph anyway */ }

      if (status === 'failed') {
        return { kind: 'error', code: 'ANALYSIS_FAILED', msg: errorMsg || 'The analysis pipeline reported a failure.' };
      }
      if (status === 'terminated') {
        return { kind: 'error', code: 'TERMINATED', msg: errorMsg || 'Analysis was terminated before extraction completed.' };
      }

      try {
        const resp = await fetch(`${API_BASE}/api/repo/${jobId}/graph`);
        if (!resp.ok) return { kind: 'pending', code: 'LINK_FAIL', msg: 'Graph service did not answer — reload to try again.' };
        const data = await resp.json();

        const nodes = (data.nodes ?? []).map((n) => ({
          id:    n.id,
          label: (n.label ?? 'UNKNOWN').toUpperCase().replace(/\s+/g, '_').slice(0, 22),
          sha:   n.sha ?? 'N/A',
          type:  n.type ?? 'unknown',
        }));
        const links = (data.links ?? []).map((l) => ({
          source: l.source,
          target: l.target,
          type:   l.type === 'rejected' ? 'rejected' : l.type === 'debate' ? 'debate' : 'decision',
        }));

        const nc = document.getElementById('node-count');
        const de = document.getElementById('graph-density');
        if (nc) nc.textContent = String(data.meta?.total_nodes ?? nodes.length);
        if (de) de.textContent = String(data.meta?.density_pct ?? 0);

        // Hydrate the honest intel sidebar from real graph metrics.
        const nn = data.meta?.total_nodes ?? nodes.length;
        const nl = data.meta?.total_links ?? links.length;
        const den = data.meta?.density_pct ?? 0;
        const intelSet = (id: string, fillId: string, val: string, pct: number) => {
          const v = document.getElementById(id);
          if (v) v.textContent = val;
          const f = document.getElementById(fillId);
          if (f) f.style.width = `${Math.max(0, Math.min(100, pct))}%`;
        };
        intelSet('intel-nodes', 'intel-nodes-fill', String(nn), nn ? Math.min(100, Math.round(nn * 6)) : 0);
        intelSet('intel-links', 'intel-links-fill', String(nl), nl ? Math.min(100, Math.round(nl * 4)) : 0);
        intelSet('intel-density', 'intel-density-fill', `${den}%`, den);
        const fb = document.getElementById('forecast-body');
        if (fb) {
          const typeCounts: Record<string, number> = {};
          nodes.forEach((n: any) => { typeCounts[n.type] = (typeCounts[n.type] ?? 0) + 1; });
          const top = Object.entries(typeCounts).sort((a, b) => b[1] - a[1])[0];
          fb.textContent = top
            ? `FORECAST: ${top[1]} ${top[0].toUpperCase()} NODE${top[1] === 1 ? '' : 'S'} (${nn} TOTAL) — GRAPH-DERIVED.`
            : 'FORECAST: NO INTENT NODES EXTRACTED YET.';
        }

        if (!nodes.length) {
          return { kind: 'empty', code: 'NO_INTENT', msg: 'No intent nodes extracted yet — analysis may still be running.' };
        }
        return { kind: 'data', nodes, links };
      } catch {
        return { kind: 'pending', code: 'LINK_FAIL', msg: 'Decision graph could not be loaded — reload to try again.' };
      }
    }

    // The heartbeat readout is owned by the recon stream's poller above,
    // which already writes #heartbeat-val on every tick. A second 5s loop
    // against the same endpoint lived here and wrote the same element — two
    // unbounded polls per open dashboard, for one value.

    // ── Render ────────────────────────────────────────────
    const result = await loadGraph();

    // Drop decorative seed callouts once we know the real state.
    document.querySelectorAll('.conflict-callout').forEach((el) => { el.style.display = 'none'; });

    if (result.kind === 'error') {
      setGraphState(result.code, result.msg, 'error');
    } else if (result.kind === 'pending') {
      setGraphState(result.code, result.msg, 'pending');
    } else if (result.kind === 'empty') {
      setGraphState(result.code, result.msg, 'muted');
    } else {
      setGraphState(null, null);
      renderGraph(result.nodes, result.links);
    }

    function renderGraph(nodes, links) {
      const NODE_W = 108;
      const NODE_H = 32;
      const TYPE_COLOR = {
        decision:      '#22d3ee',
        debate:        '#f59e0b',
        rejection:     '#ef4444',
        architectural: '#a78bfa',
        unknown:       '#64748b',
      };

      const simulation = d3.forceSimulation(nodes)
        .force('link',    d3.forceLink(links).id(d => d.id).distance(120).strength(0.6))
        .force('charge',  d3.forceManyBody().strength(-320))
        .force('center',  d3.forceCenter(W / 2, H / 2))
        .force('x',       d3.forceX(W / 2).strength(0.04))
        .force('y',       d3.forceY(H / 2).strength(0.04))
        .force('collide', d3.forceCollide(70));

      const linkGroup = svg.append('g');
      const linkEl = linkGroup.selectAll('line')
        .data(links).enter().append('line')
        .attr('class', d =>
          d.type === 'decision' ? 'g-link-decision' :
          d.type === 'rejected' ? 'g-link-rejected' : 'g-link-debate');

      const nodeGroup = svg.append('g');
      const nodeEl = nodeGroup.selectAll('g')
        .data(nodes).enter().append('g').attr('class', 'g-node')
        .call(
          d3.drag()
            .on('start', (ev, d) => { if (!ev.active) simulation.alphaTarget(0.3).restart(); d.fx = d.x; d.fy = d.y; })
            .on('drag',  (ev, d) => { d.fx = ev.x; d.fy = ev.y; })
            .on('end',   (ev, d) => { if (!ev.active) simulation.alphaTarget(0); d.fx = null; d.fy = null; })
        );

      nodeEl.append('rect')
        .attr('x', -NODE_W / 2).attr('y', -NODE_H / 2)
        .attr('width', NODE_W).attr('height', NODE_H)
        .attr('stroke', d => TYPE_COLOR[d.type] || TYPE_COLOR.unknown);

      nodeEl.append('text').attr('class', 'node-title')
        .attr('x', -NODE_W / 2 + 6).attr('y', -4)
        .text(d => `DECISION // ${d.label}`);

      nodeEl.append('text').attr('class', 'node-sha')
        .attr('x', -NODE_W / 2 + 6).attr('y', 9)
        .text(d => `COMMIT: ${d.sha}`);

      simulation.on('tick', () => {
        linkEl
          .attr('x1', d => (d.source.x ?? 0))
          .attr('y1', d => (d.source.y ?? 0))
          .attr('x2', d => (d.target.x ?? 0))
          .attr('y2', d => (d.target.y ?? 0));
        nodeEl.attr('transform', d => `translate(${d.x ?? 0},${d.y ?? 0})`);
      });
    }
  </script>

  <!-- ── Scanline overlay (Stitch UI visual polish) ────────── -->
  <div id="scanline-overlay" aria-hidden="true">
    <div id="scanline-bar"></div>
  </div>

</body>
</html>
